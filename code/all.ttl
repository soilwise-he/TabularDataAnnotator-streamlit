qudt:Seidelmann2000  rdf:type  qudt:Citation;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype>;
        rdfs:label           "Seidelmann2000";
        dcterms:description  "\n  <p>“Report of the IAU/IAG Working Group on Cartographic Coordinates and Rotational Elements of the Planets and Satellites: 2000”,\n   P.K. Seidelmann, V. K. Abalakin, M. Bursa, M. E. Davies, C. DeBergh, J. H. Lieske, J. Oberst, J. L. Simon, E. M. Standish, P. Stooke, and P. C. Thomas,\n   Celestial Mechanics and Dynamical Astronomy 82: 83-110, 2002 (http://springerlink.metapress.com,\n   follow the links from “Browse by Online Libraries (subject areas)”, then “Physics and Astronomy”,\n   then “Celestial Mechanics and Dynamical Astronomy”, then “Volume 82 - Number 1/January 2002”,\n   then follow the links to download the paper.\n  </p>"^^rdf:HTML .

qudt:STRING  rdf:type             qudt:StringType;
        rdfs:isDefinedBy          <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype>;
