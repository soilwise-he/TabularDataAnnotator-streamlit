constant:AtomicMassConstant
        rdf:type                   qudt:PhysicalConstant;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/constant>;
        rdfs:label                 "atomic mass constant"@en;
        dcterms:description        "\n  The $\\textit{Atomic Mass Constant}$ is one twelfth of the mass of an unbound atom of carbon-12 at rest\n   and in its ground state.\n  "^^qudt:LatexString;
        qudt:applicableUnit        unit:KiloGM;
        qudt:dbpediaMatch          "http://dbpedia.org/resource/Atomic_mass_constant"^^xsd:anyURI;
        qudt:hasDimensionVector    qkdv:A0E0L0I0M1H0T0D0;
        qudt:hasQuantityKind       quantitykind:Mass;
        qudt:informativeReference  "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI , "http://en.wikipedia.org/wiki/Atomic_mass_constant"^^xsd:anyURI;
        qudt:latexSymbol           "$m_u$"^^qudt:LatexString;
        qudt:normativeReference    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
        qudt:quantityValue         constant:Value_AtomicMassConstant .

