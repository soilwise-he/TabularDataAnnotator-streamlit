unit:RAD-PER-SEC  rdf:type           qudt:DerivedUnit , qudt:Unit;
        rdfs:isDefinedBy             <http://qudt.org/$$QUDT_VERSION$$/vocab/unit>;
        rdfs:label                   "弧度每秒"@zh , "ラジアン毎秒"@ja , "वर्ग मीटर प्रति सैकिण्ड"@hi , "رادیان بر ثانیه"@fa , "راديان في الثانية"@ar , "Радиан на Секунда"@ru , "Радиан на Секунда"@bg , "Ακτίνιο ανά Δευτερόλεπτο"@el , "Radyan per Saniye"@tr , "Radián por Segundo"@es , "Radián na Sekunda"@cs , "Radiante per Secondo"@it , "Radiant pro Sekunde"@de , "Radiano por Segundo"@pt , "Radian per Secundum"@la , "Radian per Second"@en , "Radian per Second" , "Radian per Saat"@ms , "Radian pe Secundă"@ro , "Radian par Seconde"@fr , "Radian na Sekunda"@sl , "Radian na Sekunda"@pl;
