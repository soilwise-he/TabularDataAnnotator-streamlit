        sh:path           qudt:encoding .

qudt:BooleanEncoding  rdf:type  qudt:BooleanEncodingType;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Boolean Encoding";
