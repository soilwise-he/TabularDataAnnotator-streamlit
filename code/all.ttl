        qudt:hasQuantityKind         quantitykind:MolecularMass;
        qudt:informativeReference    "http://en.wikipedia.org/wiki/Atomic_mass_unit"^^xsd:anyURI , "http://en.wikipedia.org/wiki/Dalton?oldid=495038954"^^xsd:anyURI;
        qudt:scalingOf               unit:KiloGM;
        qudt:siExactMatch            si-unit:dalton;
        qudt:symbol                  "Da";
        qudt:ucumCode                "u"^^qudt:UCUMcs;
        qudt:uneceCommonCode         "D43";
        qudt:wikidataMatch           <http://www.wikidata.org/entity/Q483261>;
        skos:altLabel                "atomic-mass-unit" .

