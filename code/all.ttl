        qudt:symbol                  "mi";
        qudt:ucumCode                "[mi_i]"^^qudt:UCUMcs;
        qudt:udunitsCode             "mi";
        qudt:uneceCommonCode         "SMI";
        qudt:wikidataMatch           <http://www.wikidata.org/entity/Q253276> .

