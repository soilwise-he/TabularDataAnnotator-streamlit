        rdfs:label                  "温度"@zh , "温度"@ja , "सेल्सियस तापमान"@hi , "دمای سلسیوس/سانتیگراد"@fa , "درجة الحرارة المئوية أو السيلسيوس"@ar , "צלזיוס"@he , "Температура Цельсия"@ru , "teplota"@cs , "température Celsius"@fr , "temperatură Celsius"@ro , "temperatura"@sl , "temperatura"@pl , "temperatura celsius"@pt , "temperatura Celsius"@it , "Celsius sıcaklık"@tr , "Celsius temperature"@en , "Celsius-Temperatur"@de , "Suhu Celsius"@ms , "temperatura Celsius"@es;
        dcterms:description         "\"Celsius Temperature\", the thermodynamic temperature T_0, is exactly 0.01 kelvin below the thermodynamic temperature of the triple point of water."^^qudt:LatexString;
        qudt:hasDimensionVector     qkdv:A0E0L0I0M0H1T0D0;
        qudt:iec61360Code           "0112/2///62720#UAD023";
