qudt:acronym  rdf:type    owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "acronym";
        rdfs:range        xsd:string .

qudt:abbreviation  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "abbreviation";
        rdfs:range           xsd:string;
        dcterms:description  "An abbreviation for a unit is a short ASCII string that is used in place of the full name for the unit in contexts where non-ASCII characters would be problematic, or where using the abbreviation will enhance readability. When a power of abase unit needs to be expressed, such as squares this can be done using abbreviations rather than symbols. For example, <em>sq ft</em> means <em>square foot</em>, and <em>cu ft</em> means <em>cubic foot</em>."^^rdf:HTML , "\n  <p>An abbreviation for a unit is a short ASCII string that is used in place of the full name for the unit in contexts where non-ASCII characters would be problematic,\n   or where using the abbreviation will enhance readability. \n  When a power of abase unit needs to be expressed, such as squares this can be done using abbreviations rather than symbols. \n  For example, <em>sq ft</em> means <em>square foot</em>, and <em>cu ft</em> means <em>cubic foot</em>.\n  </p>"^^rdf:HTML .

