quantitykind:ChemicalPotential
        rdf:type                    qudt:QuantityKind;
        rdfs:isDefinedBy            <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind>;
        rdfs:label                  "化学势"@zh , "化学ポテンシャル"@ja , "پتانسیل شیمیایی"@fa , "جهد كيميائي"@ar , "Химический потенциал"@ru , "potenziale chimico"@it , "potential chimique"@fr , "potencial químico"@pt , "potencial químico"@es , "kimyasal potansiyel"@tr , "Chemický potenciál"@cs , "Keupayaan kimia"@ms , "Potencjał chemiczny"@pl , "Potențial chimic"@ro , "chemical potential"@en , "chemisches Potential des Stoffs B"@de;
        dcterms:description         "\"Chemical Potential\", also known as partial molar free energy, is a form of potential energy that can be absorbed or released during a chemical reaction."^^qudt:LatexString;
        qudt:hasDimensionVector     qkdv:A-1E0L2I0M1H0T-2D0;
        qudt:informativeReference   "http://en.wikipedia.org/wiki/Chemical_potential"^^xsd:anyURI;
        qudt:isoNormativeReference  "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
        qudt:latexDefinition        "$\\mu_B = (\\frac{\\partial G}{\\partial n_B})_{T,p,n_i}$, where $G$ is Gibbs energy, and $n_B$ is the amount of substance $B$."^^qudt:LatexString;
        qudt:latexSymbol            "$\\mu_B$"^^qudt:LatexString;
        qudt:plainTextDescription   "\"Chemical Potential\", also known as partial molar free energy, is a form of potential energy that can be absorbed or released during a chemical reaction.";
        qudt:wikidataMatch          <http://www.wikidata.org/entity/Q737004>;
        skos:broader                quantitykind:MolarEnergy .

quantitykind:ChemicalConsumptionPerMass
