qudt:DimensionalityShape
        rdf:type          sh:NodeShape;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Dimensions Shape";
        sh:severity       sh:Warning;
        sh:sparql         [ sh:message   "\"{$this}\" has {$actualDimensions} dimensions extent and needs to have {$specifiedDimensions}";
                            sh:prefixes  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatypePrefixes>;
                            sh:select    "\n        SELECT $this $actualDimensions $specifiedDimensions\n        WHERE {\n            $this qudt:dimensionality $dimensionality .\n            $this qudt:dimensions ?dimensions .\n            ?dimensions rdf:rest*/rdf:first $specifiedDimensions .\n            { SELECT $this (COUNT(?listValue )AS $actualDimensions)\n              WHERE {\n              $this qudt:value/rdf:rest*/rdf:first ?listValue .\n              } GROUP BY $this\n            }\n            FILTER ($actualDimensions != $specifiedDimensions)\n          }\n        "
                          ];
        sh:targetClass    qudt:List , qudt:Array .

qudt:DimensionalityPropertyShape
        rdf:type          sh:PropertyShape;
