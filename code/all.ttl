        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "wikidata match" , "Wikidata match";
        rdfs:range           xsd:anyURI;
        dcterms:description  "This property relates a QUDT concept to a Wikidata item. The Wikidata item is identified by the Wikidata URI, which is of the form `https://www.wikidata.org/wiki/Q{number}`."^^rdf:HTML .

qudt:width  rdf:type      owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "width";
        rdfs:range        xsd:string .

qudt:vectorMagnitude  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "vector magnitude";
        rdfs:range        xsd:float .

qudt:valueSN  rdf:type       owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "value scientific";
        dcterms:description  "A property to relate an observable thing with a value of any kind"^^rdf:HTML , "A property to relate an observable thing with a value expressed in scientific notation"^^rdf:HTML .

qudt:valueQuantity  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "value for quantity";
        owl:inverseOf     qudt:quantityValue .

qudt:value  rdf:type         owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "value";
        rdfs:subPropertyOf   rdf:value;
        dcterms:description  "A property to relate an observable thing with a value of any kind"^^rdf:HTML , "This property identifies the value associated with a data structure. The value may be a scalar or a reference to another object. The disjoint sub-properties of this data:value distinguish between scalar values and object references." , "A property to relate an observable thing with a value expressed as a decimal"^^rdf:HTML .

qudt:url  rdf:type        owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "url";
        rdfs:range        xsd:anyURI .

qudt:unitFor  rdf:type    owl:ObjectProperty , rdf:Property;
        rdfs:domain       qudt:Unit;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "unit for";
        owl:inverseOf     qudt:hasUnit .

qudt:uneceCommonCode  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "unece common code";
        rdfs:range           xsd:string;
        dcterms:description  "The UN/CEFACT Recommendation 20 provides three character alphabetic and alphanumeric codes for representing units of measurement for length, area, volume/capacity, mass (weight), time, and other quantities used in international trade. The codes are intended for use in manual and/or automated systems for the exchange of information between participants in international trade."^^rdf:HTML;
        dcterms:source       "https://unece.org/trade/documents/2021/06/uncefact-rec20-0"^^xsd:anyURI , "https://service.unece.org/trade/uncefact/vocabulary/rec20/"^^xsd:anyURI .

qudt:udunitsCode  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "udunits code";
        rdfs:range           xsd:string;
        dcterms:description  "The UDUNITS package supports units of physical quantities. Its C library provides for arithmetic manipulation of units and for conversion of numeric values between compatible units. The package contains an extensive unit database, which is in XML format and user-extendable. The package also contains a command-line utility for investigating units and converting values."^^rdf:HTML;
        dcterms:source       "https://www.unidata.ucar.edu/software/udunits/"^^xsd:anyURI .

qudt:ucumCode  rdf:type      owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "ucum code";
        rdfs:range           [ rdf:type     owl:Class;
                               owl:unionOf  ( qudt:UCUMcs qudt:UCUMcs-term )
                             ];
        rdfs:seeAlso         <https://ucum.org/ucum.html>;
        rdfs:subPropertyOf   skos:notation;
        dcterms:description  "<p><em>ucumCode</em> associates a QUDT unit with its UCUM code (case-sensitive). </p><p>In SHACL the values are derived from specific ucum properties using 'sh:values'.</p>"^^rdf:HTML;
        dcterms:source       "https://ucum.org/ucum.html"^^xsd:anyURI .

qudt:systemDimension  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "system dimension" .

qudt:systemDerivedQuantityKind
        rdf:type            owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label          "system derived quantity kind";
        rdfs:subPropertyOf  qudt:hasQuantityKind .

qudt:systemDefinition
        rdf:type          owl:TransitiveProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "system definition" .

qudt:symbol  rdf:type        owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "symbol";
        rdfs:subPropertyOf   dtype:literal;
        dcterms:description  "\n  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. \n  For example, the symbol for an Ohm is $ohm$. \n  This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.\n  "^^qudt:LatexString , "The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. For example, the symbol for an Ohm is $ohm$. This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm."^^qudt:LatexString .

qudt:standardUncertaintySN
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "standard uncertainty scientific";
        rdfs:range           xsd:double;
        dcterms:description  "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements."^^rdf:HTML , "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements." .

qudt:standardUncertainty
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "standard uncertainty";
        rdfs:range           xsd:decimal;
        dcterms:description  "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements."^^rdf:HTML , "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements." .

qudt:siUnitsExpression
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "si units expression";
        rdfs:range        xsd:string .

qudt:siExactMatch  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "Individual from SI Reference Point" .

qudt:scalingOf  rdf:type     owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "scalingOf";
        dcterms:description  "This property relates a unit to another unit it is scaled from"^^rdf:HTML , "This property relates a unit that is scaled to the base unit that its qudt:conversionMultiplier converts it to"^^rdf:HTML .

qudt:scaleType  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "scale type" .

qudt:ruleType  rdf:type   owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "rule type" .

qudt:relevantUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment         "This property is used for qudt:Discipline instances to identify the Unit instances that are used within a given discipline.";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "Relevant Unit";
        rdfs:range           qudt:Unit;
        dcterms:description  "This property is used for qudt:Discipline instances to identify the Unit instances that are used within a given discipline." .

qudt:relevantQuantityKind
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "relevant quantity kind";
        rdfs:range        qudt:QuantityKind .

qudt:relativeStandardUncertainty
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "relative standard uncertainty";
        rdfs:range           xsd:double;
        dcterms:description  "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value."^^rdf:HTML , "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value." .

qudt:referenceUnit  rdf:type  owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "reference unit" .

qudt:reference  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "reference" .

qudt:rationale  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "rationale";
        rdfs:range        rdf:HTML .

qudt:quantityValue  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "quantity value";
        rdfs:range        qudt:QuantityValue .

qudt:quantity  rdf:type      owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "quantity";
        dcterms:description  "a property to relate an observable thing with a quantity (qud:Quantity)"^^rdf:HTML , "a property to relate an observable thing with a quantity (qud:Quantity)" .

qudt:qkdvNumerator  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "numerator dimension vector";
        rdfs:range        qudt:QuantityKindDimensionVector .

qudt:qkdvDenominator  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "denominator dimension vector";
        rdfs:range        qudt:QuantityKindDimensionVector .

qudt:prefixMultiplierSN
        rdf:type          owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "prefix multiplier scientific";
        rdfs:range        xsd:double .

qudt:prefixMultiplier
        rdf:type          owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "prefix multiplier";
        rdfs:range        xsd:decimal .

qudt:prefix  rdf:type        owl:ObjectProperty , rdf:Property;
        rdfs:comment         "Associates a unit with the appropriate prefix, if any.";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "prefix";
        rdfs:range           qudt:Prefix;
        dcterms:description  "Associates a unit with the appropriate prefix, if any." .

qudt:plainTextDescription
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "description (plain text)";
        rdfs:range           rdfs:Literal;
        dcterms:description  "A plain text description is used to provide a description with only simple ASCII characters for cases where LaTeX , HTML or other markup would not be appropriate."^^rdf:HTML , "A plain text description is used to provide a description with only simple ASCII characters for cases where LaTeX , HTML or other markup would not be appropriate." .

qudt:permissibleTransformation
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "permissible transformation" .

qudt:permissibleMaths
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "permissible maths" .

qudt:outOfScope  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "out of scope";
        rdfs:range        xsd:boolean .

qudt:order  rdf:type      owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "order";
        rdfs:range        xsd:nonNegativeInteger .

qudt:onlineReference  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "online reference";
        rdfs:range        xsd:anyURI .

qudt:omUnit  rdf:type     owl:ObjectProperty , rdf:Property;
        rdfs:domain       qudt:Unit;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "om unit" .

qudt:numericValue  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "numeric value";
        rdfs:range        qudt:NumericUnion .

qudt:numeratorDimensionVector
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "numerator dimension vector";
        rdfs:range        qudt:QuantityKindDimensionVector .

qudt:normativeReference
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "normative reference";
        rdfs:range           xsd:anyURI;
        dcterms:description  "Provides a way to reference information that is an authoritative source providing a standard definition"^^rdf:HTML , "Provides a way to reference information that is an authoritative source providing a standard definition" .

qudt:mathMLdefinition
        rdf:type            owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label          "mathML definition";
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  qudt:mathDefinition .

qudt:mathDefinition  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "math definition";
        rdfs:range        xsd:string .

qudt:latexSymbol  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "latex symbol";
        rdfs:range           qudt:LatexString;
        dcterms:description  "\n  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. \n  For example, the symbol for an Ohm is $ohm$. \n  This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.\n  "^^qudt:LatexString .

qudt:latexDefinition  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "latex definition";
        rdfs:range        qudt:LatexString .

qudt:landscape  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "landscape";
        rdfs:range        xsd:boolean .

qudt:isoNormativeReference
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "normative reference (ISO)";
        rdfs:range           xsd:anyURI;
        rdfs:subPropertyOf   qudt:normativeReference;
        dcterms:description  "Provides a way to reference the ISO unit definition."^^rdf:HTML , "Provides a way to reference the ISO unit definition." .

qudt:isUnitOfSystem  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:domain          qudt:Unit;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "is unit of system";
        rdfs:range           qudt:SystemOfUnits;
        dcterms:description  "This property relates a unit of measure with a system of units that either a) defines the unit or b) allows the unit to be used within the system."^^rdf:HTML , "\n  This property relates a unit of measure with a system of units that either a) defines the unit\n   or b) allows the unit to be used within the system.\n  " .

qudt:isMetricUnit  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "is metric unit";
        rdfs:range        xsd:boolean .

qudt:isDimensionInSystem
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "is dimension in system" .

qudt:isDeltaQuantity  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:comment         "This property is used to identify a Quantity instance that is a measure of a change, or interval, of some property, rather than a measure of its absolute value. This is important for measurements such as temperature differences where the conversion among units would be calculated differently because of offsets.";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "is Delta Quantity";
        rdfs:range           xsd:boolean;
        dcterms:description  "\n  This property is used to identify a Quantity instance that is a measure of a change, or interval, of some property,\n   rather than a measure of its absolute value. \n  This is important for measurements such as temperature differences where the conversion among units would be calculated differently because of offsets.\n  " .

qudt:informativeReference
        rdf:type             owl:AnnotationProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "informative reference";
        rdfs:range           xsd:anyURI;
        dcterms:description  "Provides a way to reference a source that provided useful but non-normative information."^^rdf:HTML , "Provides a way to reference a source that provided useful but non-normative information." .

qudt:imageLocation  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "image location";
        rdfs:range        xsd:anyURI .

qudt:image  rdf:type      owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "image";
        rdfs:range        xsd:anyURI .

qudt:iec61360Code  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "iec-61360 code";
        rdfs:range        xsd:string .

qudt:id  rdf:type            owl:DatatypeProperty , rdf:Property;
        rdfs:domain          qudt:Concept;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "id" , "qudt id";
        rdfs:range           xsd:string;
        dcterms:description  "The \"qudt:id\" is an identifier string that uniquely identifies a QUDT concept.  The identifier is constructed using a prefix. For example, units are coded using the pattern: \"UCCCENNNN\", where \"CCC\" is a numeric code or a category and \"NNNN\" is a digit string for a member element of that category. For scaled units there may be an addition field that has the format \"QNN\" where \"NN\" is a digit string representing an exponent power, and \"Q\" is a qualifier that indicates with the code \"P\" that the power is a positive decimal exponent, or the code \"N\" for a negative decimal exponent, or the code \"B\" for binary positive exponents."^^rdf:HTML , "\n  <p>The \"qudt:id\" is an identifier string that uniquely identifies a QUDT concept. \n  The identifier is constructed using a prefix. \n  For example, units are coded using the pattern: \"UCCCENNNN\", where \"CCC\" is a numeric code or a category\n   and \"NNNN\" is a digit string for a member element of that category. \n  </p>\n  <p>For scaled units there may be an addition field that has the format \"QNN\" where \"NN\" is a digit string representing\n   an exponent power, and \"Q\" is a qualifier that indicates with the code \"P\" that the power is a positive decimal exponent,\n   or the code \"N\" for a negative decimal exponent, or the code \"B\" for binary positive exponents.\n  </p>"^^rdf:HTML .

qudt:height  rdf:type     owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "height";
        rdfs:range        xsd:string .

qudt:hasVocabulary  rdf:type       owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label                 "has vocabulary";
        rdfs:range                 owl:Ontology;
        qudt:plainTextDescription  "Used to relate a class to one or more graphs where vocabularies for the class are defined." .

qudt:hasUnitSystem  rdf:type  owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has unit system" .

qudt:hasUnit  rdf:type       owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "hasUnit" , "has unit";
        rdfs:range           qudt:Unit;
        dcterms:description  "This property relates a factor unit to its unit or a system of units with a unit of measure that is either a) defined by the system, or b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system. Systems of units may distinguish between base and derived units. Base units are the units which measure the base quantities for the corresponding system of quantities. The base units are used to define units for all other quantities as products of powers of the base units. Such units are called derived units for the system."^^rdf:HTML , "This property relates a factor unit its unit"^^rdf:HTML , "\n  <p>This property relates a factor unit to its unit or system of units with a unit of measure that is either:\n  </p>\n  <dl>\n  <dd>a) defined by the system,</dd>\n  <dd>b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system,</dd>\n  <dd>c) a reference to the unit of measure of a quantity (variable or constant) of interest.</dd>\n  </dl>\n  <p>Systems of units may distinguish between base and derived units.\n  Base units are the units which measure the base quantities for the corresponding system of quantities. \n  The base units are used to define units for all other quantities as products of powers of the base units. \n  Such units are called derived units for the system. \n  </p>"^^rdf:HTML .

qudt:hasRule  rdf:type    owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has rule" .

qudt:hasReferenceQuantityKind
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has reference quantity kind" .

qudt:hasReciprocalUnit
        rdf:type                   owl:ObjectProperty , rdf:Property;
        rdfs:domain                qudt:Unit;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label                 "has reciprocal unit";
        rdfs:range                 qudt:Unit;
        dcterms:description        "Used to relate a unit to its reciprocal unit.";
        qudt:plainTextDescription  "Used to relate a unit to its reciprocal unit." .

qudt:hasQuantityKind  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has quantity kind";
        rdfs:range        qudt:QuantityKind .

qudt:hasQuantity  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has quantity";
        rdfs:range        qudt:Quantity .

qudt:hasPrefixUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label          "prefix unit";
        rdfs:subPropertyOf  qudt:hasDefinedUnit .

qudt:hasNumeratorPart
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has quantity kind dimension vector numerator part" , "has numerator part" .

qudt:hasFactorUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "hasFactorUnit";
        dcterms:description  "This property relates a derived unit to one of its constituent factor units"^^rdf:HTML .

qudt:hasDimensionVector
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has dimension vector";
        rdfs:range        qudt:QuantityKindDimensionVector .

qudt:hasDimensionExpression
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension expression" .

qudt:hasDimension  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has dimension" .

qudt:hasDerivedUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "derived unit";
        dcterms:description  "This property relates a system of units to a unit of measure that is defined within the system in terms of the base units for the system. That is, the derived unit is defined as a product of the base units for the system raised to some rational power."^^rdf:HTML , "\n  This property relates a system of units to a unit of measure that is defined within the system in terms\n   of the base units for the system. \n  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.\n  ";
        owl:inverseOf        qudt:derivedUnitOfSystem .

qudt:hasDerivedNonCoherentUnit
        rdf:type            owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label          "has coherent derived unit";
        rdfs:subPropertyOf  qudt:hasDerivedUnit;
        owl:inverseOf       qudt:derivedNonCoherentUnitOfSystem .

qudt:hasDerivedCoherentUnit
        rdf:type            owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label          "derived coherent unit";
        rdfs:subPropertyOf  qudt:hasDerivedUnit , qudt:hasCoherentUnit;
        owl:inverseOf       qudt:derivedCoherentUnitOfSystem .

qudt:hasDenominatorPart
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has quantity kind dimension vector denominator part" .

qudt:hasDefinedUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "defined unit";
        rdfs:range           qudt:Unit;
        rdfs:subPropertyOf   qudt:hasUnit;
        dcterms:description  "This property relates a unit system with a unit of measure that is defined by the system."^^rdf:HTML .

qudt:hasDTICode  rdf:type  rdf:Property;
        rdfs:comment      "ISO 24165 Digital Token Identifier (12-character alphanumeric)."@en;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "has DTI code"@en .

qudt:hasCoherentUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "coherent unit";
        rdfs:subPropertyOf   qudt:hasDefinedUnit;
        dcterms:description  "A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers of the system's base units with the proportionality factor of one."^^rdf:HTML , "\n  A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers\n   of the system's base units with the proportionality factor of one.\n  " .

qudt:hasBaseUnit  rdf:type   owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "base unit";
        rdfs:subPropertyOf   qudt:hasCoherentUnit;
        dcterms:description  "This property relates a system of units to a base unit defined within the system. The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power."^^rdf:HTML , "\n  This property relates a system of units to a base unit defined within the system.\n  The base units of a system are used to define the derived units of the system by expressing\n   the derived units as products of the base units raised to a rational power.\n  ";
        owl:inverseOf        qudt:baseUnitOfSystem .

qudt:hasBaseQuantityKind
        rdf:type            owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label          "has base quantity kind";
        rdfs:subPropertyOf  qudt:hasQuantityKind .

qudt:hasAllowedUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "allowed unit";
        rdfs:range           qudt:Unit;
        rdfs:subPropertyOf   qudt:hasUnit;
        dcterms:description  "This property relates a unit system with a unit of measure that is not defined by or part of the system, but is allowed for use within the system. An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system."^^rdf:HTML , "\n  This property relates a unit system with a unit of measure that is not defined by or part of the system,\n   but is allowed for use within the system.\n   An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system.\n  " .

qudt:guidance  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:domain       qudt:Concept;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "guidance";
        rdfs:range        rdf:HTML .

qudt:figureLabel  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "figure label";
        rdfs:range        xsd:string .

qudt:figureCaption  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "figure caption";
        rdfs:range        xsd:string .

qudt:figure  rdf:type        owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "figure";
        rdfs:range           qudt:Figure;
        dcterms:description  "Provides a link to an image."^^rdf:HTML .

qudt:fieldCode  rdf:type           owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label                 "field code";
        rdfs:range                 xsd:string;
        qudt:plainTextDescription  "A field code is a generic property for representing unique codes that make up other identifiers. For example each QuantityKind class carries a domain code as its field code." , "\n  A field code is a generic property for representing unique codes that make up other identifiers. \n  For example each QuantityKind class caries a domain code as its field code.\n  " .

qudt:factorUnitScalar
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "factorUnitScalar";
        dcterms:description  "For a derived unit that is not exactly the product of its factor units, this property defines the scalar with which that product has to be multiplied with."^^rdf:HTML .

qudt:expression  rdf:type    owl:AnnotationProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "expression";
        dcterms:description  "An 'expression' is a finite combination of symbols that are well-formed according to rules that apply to units of measure, quantity kinds and their dimensions."^^rdf:HTML , "\n  An 'expression' is a finite combination of symbols that are well-formed according to rules that apply to units of measure, quantity kinds and their dimensions.\n  " .

qudt:exponent  rdf:type            owl:ObjectProperty , owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label                 "exponent";
        dcterms:description        "This property relates a factor unit its exponent"^^rdf:HTML;
        qudt:plainTextDescription  "Defines the exponent of a factor unit" .

qudt:example  rdf:type       owl:AnnotationProperty , rdf:Property;
        rdfs:comment         "The 'qudt:example' property is used to annotate an instance of a class with a reference to a concept that is an example. The type of this property is 'rdf:Property'. This allows both scalar and object ranges."^^rdf:HTML;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "example";
        dcterms:description  "\n  The 'qudt:example' property is used to annotate an instance of a class with a reference to a concept that is an example. \n  The type of this property is 'rdf:Property'. \n  This allows both scalar and object ranges.\n  " .

qudt:exactMatch  rdf:type  owl:ObjectProperty , rdf:Property , qudt:SymmetricRelation;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "exact match" .

qudt:exactConstant  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "exact constant";
        rdfs:range        xsd:boolean .

qudt:element  rdf:type       owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "element";
        dcterms:description  "An element of an enumeration"^^rdf:HTML .

qudt:dimensionlessExponent
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimensionless exponent" .

qudt:dimensionVectorForSI
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension vector for SI";
        rdfs:range        qudt:QuantityKindDimensionVector_SI .

qudt:dimensionInverse
        rdf:type          owl:SymmetricProperty , owl:InverseFunctionalProperty , owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension inverse";
        owl:inverseOf     qudt:dimensionInverse .

qudt:dimensionExponentForTime
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent for time" .

qudt:dimensionExponentForThermodynamicTemperature
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent for thermodynamic temperature" .

qudt:dimensionExponentForMass
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent for mass" .

qudt:dimensionExponentForLuminousIntensity
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent for luminous intensity" .

qudt:dimensionExponentForLength
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent for length" .

qudt:dimensionExponentForElectricCurrent
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent for electric current" .

qudt:dimensionExponentForAmountOfSubstance
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent for amount of substance" .

qudt:dimensionExponent
        rdf:type          owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dimension exponent" .

qudt:derivedUnitOfSystem
        rdf:type             owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "is derived unit of system";
        rdfs:subPropertyOf   qudt:isUnitOfSystem;
        dcterms:description  "This property relates a unit of measure to the system of units in which it is defined as a derived unit. That is, the derived unit is defined as a product of the base units for the system raised to some rational power."^^rdf:HTML , "\n  This property relates a unit of measure to the system of units in which it is defined as a derived unit. \n  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.\n  ";
        owl:inverseOf        qudt:hasDerivedUnit .

qudt:derivedNonCoherentUnitOfSystem
        rdf:type             owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "is non-coherent derived unit of system";
        rdfs:range           qudt:SystemOfUnits;
        rdfs:subPropertyOf   qudt:derivedUnitOfSystem;
        dcterms:description  "This property relates a unit of measure to the unit system in which the unit is derived from the system's base units without proportionality constant of one."^^rdf:HTML , "\n  This property relates a unit of measure to the unit system in which the unit is derived from the system's\n   base units without proportionality constant of one.\n  ";
        owl:inverseOf        qudt:hasDerivedNonCoherentUnit .

qudt:derivedCoherentUnitOfSystem
        rdf:type             owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "is coherent derived unit of system";
        rdfs:subPropertyOf   qudt:derivedUnitOfSystem , qudt:definedUnitOfSystem;
        dcterms:description  "This property relates a unit of measure to the unit system in which the unit is derived from the system's base units with a proportionality constant of one."^^rdf:HTML;
        owl:inverseOf        qudt:hasDerivedCoherentUnit .

qudt:deprecated  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "deprecated";
        rdfs:range        xsd:boolean .

qudt:denominatorDimensionVector
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "denominator dimension vector";
        rdfs:range        qudt:QuantityKindDimensionVector .

qudt:definedUnitOfSystem
        rdf:type             owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "defined unit of system";
        rdfs:subPropertyOf   qudt:isUnitOfSystem;
        dcterms:description  "This property relates a unit of measure with the unit system that defines the unit."^^rdf:HTML;
        owl:inverseOf        qudt:hasDefinedUnit .

qudt:default  rdf:type       owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "default";
        dcterms:description  "The default element in an enumeration"^^rdf:HTML .

qudt:dbpediaMatch  rdf:type  owl:AnnotationProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "dbpedia match";
        rdfs:range        xsd:anyURI .

qudt:dataStructure  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "data structure";
        rdfs:range        xsd:string .

qudt:currencyNumber  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "currency number";
        rdfs:range           xsd:string;
        rdfs:seeAlso         "https://en.wikipedia.org/wiki/ISO_4217"^^xsd:anyURI;
        dcterms:description  "Numeric currency Code as defined by ISO 4217. For example, US Dollar has the number 840."^^rdf:HTML , "Three-digit Currency Code as defined by ISO 4217. For example, the currency number for the US dollar is \"840\"."^^rdf:HTML .

qudt:currencyExponent
        rdf:type             owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "currency exponent";
        rdfs:range           xsd:integer;
        dcterms:description  "The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0."^^rdf:HTML , "\n  The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. \n  For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. \n  However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0.\n  " .

qudt:currencyCode  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "currency code";
        rdfs:range           xsd:string;
        rdfs:seeAlso         "https://en.wikipedia.org/wiki/ISO_4217"^^xsd:anyURI;
        dcterms:description  "Alphabetic Currency Code as defined by ISO 4217. For example, US Dollar has the code 'USD'."^^rdf:HTML , "Alphabetic Currency Code as defined by ISO 4217. For example, the currency code for the US dollar is USD."^^rdf:HTML .

qudt:conversionOffsetSN
        rdf:type          owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "conversion offset scientific";
        rdfs:range        xsd:double .

qudt:conversionOffset
        rdf:type          owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "conversion offset";
        rdfs:range        xsd:decimal .

qudt:conversionMultiplierSN
        rdf:type          owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "conversion multiplier scientific";
        rdfs:range        xsd:double .

qudt:conversionMultiplier
        rdf:type          owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "conversion multiplier";
        rdfs:range        xsd:decimal .

qudt:coherentUnitSystem
        rdf:type                   owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label                 "coherent unit system";
        rdfs:subPropertyOf         qudt:hasUnitSystem;
        dcterms:description        "\n  A system of units is coherent with respect to a system of quantities and equations if the system of units is chosen in such a way that the equations between numerical values have exactly the same form (including the numerical factors) as the corresponding equations between the quantities. \n  In such a coherent system, no numerical factor other than the number 1 ever occurs in the expressions for the derived units in terms of the base units. \n  For example, the $newton$ and the $joule$. \n  These two are, respectively, the force that causes one kilogram to be accelerated at 1 metre per (1) second per (1) second, and the work done by 1 newton acting over 1 metre. \n  Being coherent refers to this consistent use of 1. \n  In the old c.g.s. system , with its base units the centimetre and the gram, the corresponding coherent units were the dyne and the erg,\n   respectively the force that causes 1 gram to be accelerated at 1 centimetre per (1) second per (1) second, and the work done by 1 dyne acting over 1 centimetre. \n  So $1\\,newton = 10^5 dyne$, $1 joule = 10^7 erg$, making each of the four compatible in a decimal sense within its respective other system, but not coherent therein.</p>\n  "^^qudt:LatexString , "\n  <p>A system of units is coherent with respect to a system of quantities and equations if the system of units is chosen in such a way that the equations between numerical values have exactly the same form (including the numerical factors) as the corresponding equations between the quantities. \n  In such a coherent system, no numerical factor other than the number 1 ever occurs in the expressions for the derived units in terms of the base units. \n  For example, the $newton$ and the $joule$. \n  These two are, respectively, the force that causes one kilogram to be accelerated at 1 metre per (1) second per (1) second, and the work done by 1 newton acting over 1 metre. \n  Being coherent refers to this consistent use of 1. \n  In the old c.g.s. system , with its base units the centimetre and the gram, the corresponding coherent units were the dyne and the erg,\n   respectively the force that causes 1 gram to be accelerated at 1 centimetre per (1) second per (1) second, and the work done by 1 dyne acting over 1 centimetre. \n  So $1\\,newton = 10^5 dyne$, $1 joule = 10^7 erg$, making each of the four compatible in a decimal sense within its respective other system, but not coherent therein.</p>\n  "^^qudt:LatexString;
        qudt:informativeReference  "https://en.wikipedia.org/wiki/Coherence_(units_of_measurement)"^^xsd:anyURI .

qudt:categorizedAs  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "categorized as" .

qudt:blockchainNetwork
        rdf:type          rdf:Property;
        rdfs:comment      "Primary network name (e.g., 'Bitcoin Mainnet', 'Ethereum Mainnet')."@en;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "blockchain network"@en .

qudt:belongsToSystemOfQuantities
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:domain       qudt:QuantityKind;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label        "belongs to system of quantities";
        rdfs:range        qudt:SystemOfQuantityKinds .

qudt:baseUnitOfSystem
        rdf:type             owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "is base unit of system";
        rdfs:subPropertyOf   qudt:definedUnitOfSystem;
        dcterms:description  "This property relates a unit of measure to the system of units in which it is defined as a base unit for the system. The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power."^^rdf:HTML , "\n  This property relates a unit of measure to the system of units in which it is defined as a base unit for the system. \n  The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power.\n  ";
        owl:inverseOf        qudt:hasBaseUnit .

qudt:baseDimensionEnumeration
        rdf:type             owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "base dimension enumeration";
        rdfs:range           qudt:Enumeration;
        dcterms:description  "This property associates a system of quantities with an enumeration that enumerates the base dimensions of the system in canonical order."^^rdf:HTML .

qudt:applicableUnit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "applicable unit";
        rdfs:range           qudt:Unit;
        dcterms:description  "See https://github.com/qudt/qudt-public-repo/wiki/Advanced-User-Guide#4-computing-applicable-units-for-a-quantitykind on how `qudt:applicableUnit` is computed from `qudt:hasQuantityKind` and then materialized"^^rdf:HTML , "\n  <p>See this page on the QUDT GitHub<a href=\"https://github.com/qudt/qudt-public-repo/wiki/Advanced-User-Guide#4-computing-applicable-units-for-a-quantitykind\">Wiki</a>\n   on how \"qudt:applicableUnit\" is computed from \"qudt:hasQuantityKind\" and then materialized.\n  </p>"^^rdf:HTML .

qudt:applicableUSCustomaryUnit
        rdf:type            owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label          "applicable US Customary unit";
        rdfs:range          qudt:Unit;
        rdfs:subPropertyOf  qudt:applicableUnit .

qudt:applicableSystem
        rdf:type             owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "applicable system";
        dcterms:description  "This property relates a unit of measure with a unit system that may or may not define the unit, but within which the unit is compatible."^^rdf:HTML , "\n  This property relates a unit of measure with a unit system that may or may not define the unit,\n   but within which the unit is compatible.\n  " .

