        rdfs:label           "Reference Frame";
        rdfs:subClassOf      skos:Concept , qudt:Concept;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      vaem:description
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      vaem:comment
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:zCoordinateDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:zAxisDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:yCoordinateDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:yAxisDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:xCoordinateDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:xAxisDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:realization
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:FrameType;
                               owl:onProperty     qudt:frameType
                             ];
        dcterms:description  "A reference frame (or frame of reference) in physics, may refer to a coordinate system or set of axes.\nThe frame serves as the datum to measure the position, orientation, and other properties of objects in it.\nReference frame may refer to an observational reference frame tied to the state of motion of an observer. \nReference frame may also refer to both an observational reference frame and an attached coordinate system as a unit." , "\n  <p> A <em>Reference Frame</em> (or \"frame of reference\") in physics, may refer to a coordinate system or set of axes.\nThe frame serves as the datum to measure the position, orientation, and other properties of objects in it.\nReference frame may refer to an observational reference frame tied to the state of motion of an observer. \nReference frame may also refer to both an observational reference frame and an attached coordinate system as a unit.\n</p>\n"^^rdf:HTML;
        sh:property          qudt:ReferenceFrame-zCoordinateDefinition , qudt:ReferenceFrame-comment , qudt:ReferenceFrame-description , qudt:ReferenceFrame-frameType , qudt:ReferenceFrame-informativeReference , qudt:ReferenceFrame-realization , qudt:ReferenceFrame-xAxisDefinition , qudt:ReferenceFrame-xCoordinateDefinition , qudt:ReferenceFrame-yAxisDefinition , qudt:ReferenceFrame-yCoordinateDefinition , qudt:ReferenceFrame-zAxisDefinition .

qudt:ReferenceDatatype
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Reference Data Type";
        rdfs:subClassOf      qudt:StructuredDatatype;
        dcterms:description  "\n  <p>A reference is an object containing information which refers to data stored elsewhere, as opposed to containing the data itself. \n  A reference data type is a data type that specifies how a reference is represented and stored in memory,\n   as well as the operations that can be performed on reference values. \n  The most common example of a reference data type is a pointer.\n  </p>"^^rdf:HTML .

qudt:PolarCoordinatesType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Polar Coordinate System Type";
        rdfs:subClassOf      qudt:CoordinateSystemType , qudt:CoordinateSystem;
        dcterms:description  "\n  <p>A set of  variables which fix a geometric object. \n  If the coordinates of a point P are determined by the distance from P to the origin and the angle subtended by the radial vector at P and a fixed axis, they are known as polar coordinates. \n  Typically, the angle is measured with respect to the x-axis.\" ;\n  </p>"^^rdf:HTML , "\n  <p>A set of  variables which fix a geometric object. \n  If the coordinates of a point <em>P</em> are determined by the distance from <em>P</em> to the origin and the angle subtended by the radial vector at <em>P</em> and a fixed axis,\n   they are known as polar coordinates. \n  Typically, the angle is measured with respect to the x-axis. ;\n  </p>\n  "^^rdf:HTML .

qudt:PolarCoordinates
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Polar Coordinate System Type" , "Polar Coordinate System";
        rdfs:subClassOf      qudt:Coordinates;
        dcterms:description  "\n  <p>A set of  variables which fix a geometric object. \n  If the coordinates of a point P are determined by the distance from P to the origin and the angle subtended by the radial vector at P and a fixed axis, they are known as polar coordinates. \n  Typically, the angle is measured with respect to the x-axis.\" ;\n  </p>"^^rdf:HTML , "\n  <p>A set of  variables which fix a geometric object. \n  If the coordinates of a point P are determined by the distance from P to the origin and the angle subtended by the radial vector at P and a fixed axis,\n   they are known as polar coordinates. \n  Typically, the angle is measured with respect to the x-axis. ;\n  </p>"^^rdf:HTML .

qudt:NonRotatingInertialFrame
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Non Rotating Coordinate Frame";
        rdfs:seeAlso         qudt:InertialCoordinateFrame;
        rdfs:subClassOf      qudt:InertialReferenceFrame;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt:FT_NON-ROTATING;
                               owl:onProperty  qudt:frameType
                             ];
        dcterms:description  "\n  <p>The non-rotating (or \"inertial\") coordinate frames are defined by taking a \"snapshot\" of the orientation of a particular set of right-handed, orthogonal axes at a specific epoch or time. \n  In other words, the non-rotating coordinate frame, however it is defined, is frozen or fixed at a specific time - for all time. \n  These non-rotating coordinate frames are referred to as \"of Epoch\" coordinate frames.\n  </p>"^^rdf:HTML;
        owl:equivalentClass  qudt:InertialCoordinateFrame;
        sh:property          qudt:NonRotatingInertialFrame-frameType .

qudt:MarsCoordinateSystem
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Mars Coordinate System Type";
        rdfs:subClassOf      qudt:TrajectoryCoordinateSystem;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt.type:CC_MarsCentered;
                               owl:onProperty  qudt:coordinateCenter
                             ];
        dcterms:description  "A \"Trajectory Coordinate System\" with the following instance(s): \"Mars mean equator and IAU-Node of epoch\", \"Mars mean equator and prime meridian body-fixed\"." , "\n  A \"Trajectory Coordinate System\" with the following instance(s): \"Mars mean equator and IAU-Node of epoch\", \"Mars mean equator and prime meridian body-fixed\".\n  ";
        sh:property          qudt:MarsCoordinateSystem-coordinateCenter .

qudt:LunarCoordinateSystem
        rdf:type             rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Lunar Coordinate System";
        rdfs:subClassOf      qudt:TrajectoryCoordinateSystem;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt.type:CC_MoonCentered;
                               owl:onProperty  qudt:coordinateCenter
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:zAxisDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:yAxisDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:xAxisDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:realization
                             ];
        dcterms:description  "\n  Two slightly different coordinate frames are commonly used to define the orientation of the axes of a lunar body-fixed coordinate system:\n   a mean Earth/rotation frame and a principal axis coordinate frame. \n  The mean Earth/rotation frame (sometimes called the \"Mean Earth/polar axis\" frame) is a lunar body-fixed coordinate frame.\n  This has the X-axis aligned with the mean direction from the Moon to the Earth and the Z-axis aligned with the mean axis of rotation of the Moon. \n  The principal axis frame is a lunar body-fixed coordinate frame aligned with the principal axes of the Moon. \n  Due to the fact that the Moon is synchronously rotating but is not exactly symmetric, the principal axes and the mean Earth/rotation axes of the Moon do not coincide.\n  " , "Two slightly different coordinate frames are commonly used to define the orientation of the axes of a lunar body-fixed coordinate system: a mean Earth/rotation frame and a principal axis coordinate frame. The mean Earth/rotation frame (sometimes called the \"Mean Earth/polar axis\" frame) is a lunar body-fixed coordinate frame with the X-axis aligned with the mean direction from the Moon to the Earth and the Z-axis aligned with the mean axis of rotation of the Moon. The principal axis frame is a lunar body-fixed coordinate frame aligned with the principal axes of the Moon. Due to the fact that the Moon is synchronously rotating but is not exactly symmetric, the principal axes and the mean Earth/rotation axes of the Moon do not coincide.";
        sh:property          qudt:LunarCoordinateSystem-coordinateCenter , qudt:LunarCoordinateSystem-realization , qudt:LunarCoordinateSystem-xAxisDefinition , qudt:LunarCoordinateSystem-yAxisDefinition , qudt:LunarCoordinateSystem-zAxisDefinition .

qudt:LocalCoordinateSystem
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Local Coordinate System Type" , "Local Coordinate System";
        rdfs:subClassOf      qudt:TrajectoryCoordinateSystem;
        dcterms:description  "A \"Trajectory Coordinate System\" with the following instance(s): \"Local vertical curvilinear coordinate system\", \"Local vertical local horizontal coordinate system\", \"Vehicle centered local vertical curvilinear coordinate system\"." , "\n  A \"Trajectory Coordinate System\" with the following instance(s):\n   \"Local vertical curvilinear coordinate system\",\n   \"Local vertical local horizontal coordinate system\",\n   \"Vehicle centered local vertical curvilinear coordinate system\".\n  " .

qudt:InertialReferenceFrame
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Inertial reference frame";
        rdfs:subClassOf      qudt:ReferenceFrame;
        dcterms:description  "A sub-type of 'Reference Frame'. Detailed description to be provided in a future version." , "\n  A sub-type of 'Reference Frame'.\n  " .

qudt:InertialCoordinateFrame
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Inertial Coordinate Frame";
        rdfs:seeAlso         qudt:NonRotatingInertialFrame;
        rdfs:subClassOf      qudt:InertialReferenceFrame;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt:FT_NON-ROTATING;
                               owl:onProperty  qudt:frameType
                             ];
        dcterms:description  "A \"Coordinate Frame\".";
        owl:equivalentClass  qudt:NonRotatingInertialFrame;
        sh:property          qudt:InertialCoordinateFrame-frameType .

qudt:GroundCoordinateSystem
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Ground coordinate system";
        rdfs:subClassOf      qudt:AerospaceCoordinateSystem;
        dcterms:description  "A sub-type of 'Aerospace coordinate system'. Detailed description to be provided in a future version." , "A sub-type of 'Aerospace coordinate system'." .

qudt:FrameType  rdf:type     owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Frame Type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "This class contains elements which specify the intertial type of a coordinate frame as either inertial, rotating, or non-rotating." , "\n  <p>A <em>Frame Type</em> specifies the intertial type of a coordinate frame as either inertial, rotating, or non-rotating.\n  </p>\n  "^^rdf:HTML;
        owl:oneOf            ( qudt:FT_ROTATING qudt:FT_NON-ROTATING qudt:FT_INERTIAL );
        sh:in                ( qudt:FT_ROTATING qudt:FT_NON-ROTATING qudt:FT_INERTIAL );
        sh:in                ( qudt:FT_ROTATING qudt:FT_NON-ROTATING qudt:FT_INERTIAL ) .

qudt:EarthCoordinateSystem
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Earth Coordinate System Type";
        rdfs:subClassOf      qudt:TrajectoryCoordinateSystem;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt.type:CC_EarthCentered;
                               owl:onProperty  qudt:coordinateCenter
                             ];
        dcterms:description  "\n  <p>A \"Trajectory Coordinate System\" for all earth-centered coordinates, such as:\n  </p>\n  <ul>\n  <li>Earth mean equator and prime meridian coordinate system\";</li>\n  <li>Earth true equator and prime meridian of epoch coordinate system\";</li> \n  <li>International celestial reference system\";</li>\n  <li>International terrestrial reference system\";</li>\n  <li>Sun centered international celestial reference system\";</li>\n  <li>Vehicle centered international celestial reference system\".</li>\n  </ul>"^^rdf:HTML , "\n  <p>A \"Trajectory Coordinate System\" for all earth-centered coordinates, such as:</p>\n  <ul>\n  <li>Earth mean equator and prime meridian coordinate system;;</li>\n  <li>Earth true equator and prime meridian of epoch coordinate system;</li> \n  <li>International celestial reference system;</li>\n  <li>International terrestrial reference system;</li>\n  <li>Sun centered international celestial reference system;</li>\n  <li>Vehicle centered international celestial reference system.</li>\n  </ul>"^^rdf:HTML , "\n  <p>A \"Trajectory Coordinate System\" for all earth-centered coordinates, such as:\n  </p>\n  <ul>\n  <li>Earth mean equator and prime meridian coordinate system;;</li>\n  <li>Earth true equator and prime meridian of epoch coordinate system;</li> \n  <li>International celestial reference system;</li>\n  <li>International terrestrial reference system;</li>\n  <li>Sun centered international celestial reference system;</li>\n  <li>Vehicle centered international celestial reference system.</li>\n  </ul>"^^rdf:HTML;
        sh:property          qudt:EarthCoordinateSystem-coordinateCenter .

qudt:Coordinates-3D-Type
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "3D Coordinate Type";
        rdfs:subClassOf      qudt:ThreeTuple , qudt:CartesianCoordinatesType;
        dcterms:description  "\n  <p>A 3D coordinate system is a system for assigning a three-tuple of numbers or scalars to each point in an 3-dimensional space. \n  A corresponding 3D Coordinate Type is a data type that defines the data type for each coordinate (tuple member) in a 3D coordinate system.\n  </p>"^^rdf:HTML .

qudt:Coordinates-3D-SinglePrecision
        rdf:type             rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "3D Coordinates (Single Precision)";
        rdfs:subClassOf      qudt:Coordinates-3D;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:float_Z
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:float_Y
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:float_X
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  xsd:float;
                               owl:onProperty     qudt:float_X
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  xsd:float;
                               owl:onProperty     qudt:float_Y
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  xsd:float;
                               owl:onProperty     qudt:float_Z
                             ];
        dcterms:description  "\n  <p>A 3D coordinates in single floating point precision for locating a point in physical space.\n  </p>\n  "^^rdf:HTML , "\n  <p>A 3D coordinates in single floating point precision for locating a point in physical space.\n  </p>"^^rdf:HTML;
        sh:property          qudt:Coordinates-3D-SinglePrecision-float_X , qudt:Coordinates-3D-SinglePrecision-float_Y , qudt:Coordinates-3D-SinglePrecision-float_Z .

qudt:Coordinates-3D-DoublePrecision
        rdf:type             rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "3D Coordinates (Double Precision)";
        rdfs:subClassOf      qudt:Coordinates-3D;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   <http://qudt.org/schema/type#Double_Z>
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   <http://qudt.org/schema/type#Double_Y>
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  xsd:double;
                               owl:onProperty     <http://qudt.org/schema/type#Double_X>
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  xsd:double;
                               owl:onProperty     <http://qudt.org/schema/type#Double_Y>
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  xsd:double;
                               owl:onProperty     <http://qudt.org/schema/type#Double_Z>
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   <http://qudt.org/schema/type#Double_X>
                             ];
        dcterms:description  "\n  <p>A 3D coordinates in double floating point precision for locating a point in physical space.\n  </p>"^^rdf:HTML;
        sh:property          qudt:Coordinates-3D-DoublePrecision-double_X , qudt:Coordinates-3D-DoublePrecision-double_Y , qudt:Coordinates-3D-DoublePrecision-double_Z .

qudt:Coordinates-3D  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "3D Coordinate Type";
        rdfs:subClassOf      qudt:ThreeTuple , qudt:CartesianCoordinates;
        dcterms:description  "\n  <p>A 3D coordinate system is a system for assigning a three-tuple of numbers or scalars to each point in an 3-dimensional space.\n  A corresponding 3D Coordinate Type is a data type that defines the data type for each coordinate (tuple member) in a 3D coordinate system.\n  </p>"^^rdf:HTML .

