        rdfs:isDefinedBy             <http://qudt.org/$$QUDT_VERSION$$/vocab/unit>;
        rdfs:label                   "Abvolt per Centimetre"@en , "Abvolt per Centimetre" , "Abvolt per Centimeter"@en-US;
        dcterms:description          "\n  In the electromagnetic centimeter-gram-second system of units, 'abvolt per centimeter' is the unit of electric field strength.\n  "^^rdf:HTML;
