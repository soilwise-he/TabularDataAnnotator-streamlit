        rdfs:label        "Y-Coordinate definition";
        rdfs:range        xsd:string .

qudt:yAxisDefinition  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Y-Axis definition";
        rdfs:range           xsd:string;
        dcterms:description  "\n  The definition of the Y-Axis could be an intersection, cross-product or other function of a meridian or orbit. \n  It could also mention any aspects of rotation, for example, the rotation equator of the Earth, Sun, Moon or other celestial body. \n  An epoch might also be given." , "\n  The definition of the Y-Axis could be an intersection, cross-product or other function of a meridian or orbit. \n  It could also mention any aspects of rotation, for example, the rotation equator of the Earth, Sun, Moon or other celestial body. \n  An epoch might also be given.\n  " .

