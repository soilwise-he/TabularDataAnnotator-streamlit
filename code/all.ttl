        rdfs:label                  "轉動慣量"@zh , "慣性モーメント"@ja , "जड़त्वाघूर्ण"@hi , "گشتاور لختی"@fa , "عزم القصور الذاتي"@ar , "Момент инерции"@ru , "momento di inerzia"@it , "momento de inércia"@pt , "momento de inercia"@es , "moment of inertia"@en , "moment d'inertie"@fr , "Moment setrvačnosti"@cs , "Moment de inerție"@ro , "Eylemsizlik momenti"@tr , "Massenträgheitsmoment"@de , "Momen inersia"@ms , "Moment bezwładności"@pl;
