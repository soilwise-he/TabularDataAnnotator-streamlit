        rdfs:label        "columns";
        rdfs:range        xsd:integer .

qudt:cardinality  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "cardinality" .

qudt:cName  rdf:type        owl:DatatypeProperty , rdf:Property;
        rdfs:comment        "Datatype name in the C programming language";
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label          "C name" , "C Language name";
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  qudt:id .

qudt:bytes  rdf:type      owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "octets" , "bytes";
        rdfs:range        xsd:integer .

qudt:byteOrder  rdf:type     owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "byte order";
        rdfs:range           qudt:EndianType;
        dcterms:description  "Byte order is an enumeration of two values: 'Big Endian' and 'Little Endian' and is used to denote whether the most signiticant byte is either first or last, respectively." .

qudt:bounded  rdf:type       owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "bounded";
        rdfs:range           xsd:boolean;
        dcterms:description  "A datatype is bounded if its value space has either a finite upper and lower bound. Either bound may be inclusive or exclusive. " .

qudt:bits  rdf:type       owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "bits";
        rdfs:range        xsd:integer .

qudt:bitOrder  rdf:type   owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "bit order";
        rdfs:range        qudt:EndianType .

qudt:basis  rdf:type      owl:ObjectProperty , rdf:Property;
