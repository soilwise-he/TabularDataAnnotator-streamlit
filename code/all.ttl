        qudt:hasFactorUnit           [ qudt:exponent  -2;
                                       qudt:hasUnit   unit:M
                                     ];
        qudt:hasQuantityKind         quantitykind:VaporPressure , quantitykind:ShearModulus , quantitykind:ModulusOfElasticity , quantitykind:Fugacity , quantitykind:ForcePerArea , quantitykind:BulkModulus;
        qudt:hasReciprocalUnit       unit:M2-PER-N;
        qudt:iec61360Code            "0112/2///62720#UAA258";
        qudt:informativeReference    "http://en.wikipedia.org/wiki/Pascal?oldid=492989202"^^xsd:anyURI;
        qudt:omUnit                  <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal>;
        qudt:siExactMatch            si-unit:pascal;
        qudt:siUnitsExpression       "N/m^2";
