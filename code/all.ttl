PREFIX soqk:         <http://qudt.org/vocab/soqk/>
PREFIX sou:          <http://qudt.org/vocab/sou/>
PREFIX sq:           <http://qudt.org/2.1/shacl/infer/applicableUnits>
PREFIX unit:         <http://qudt.org/vocab/unit/>
