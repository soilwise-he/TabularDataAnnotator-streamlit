        rdfs:isDefinedBy             <http://qudt.org/$$QUDT_VERSION$$/vocab/unit>;
        rdfs:label                   "Sidereal Year"@en , "Sidereal Year";
        dcterms:description          "A sidereal year is the time taken for Sun to return to the same position with respect to the stars of the celestial sphere."^^rdf:HTML;
        qudt:applicableSystem        sou:CGS , sou:CGS-EMU , sou:CGS-GAUSS , sou:IMPERIAL , sou:SI , sou:USCS;
