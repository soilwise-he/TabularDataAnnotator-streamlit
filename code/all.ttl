qudt:BitField  rdf:type      owl:DataRange , owl:Class , rdfs:Datatype;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Bit Field";
        rdfs:subClassOf      xsd:string;
        dcterms:description  "\n  <p>A bit field is a common idiom used in computer programming to store a set of Boolean datatype flags compactly, as a series of bits. \n  The bit field is stored in an integral type of known, fixed bit-width. \n  Each Boolean flag is stored in a separate bit. \n  Usually the source code will define a set of constants, each a power of two, that semantically associate each individual bit with its respective Boolean flag. \n  The bitwise operators and, or, and not are used in combination to set, reset and test the flags.\n  </p>"^^rdf:HTML , "\n  <p>A bit field is a common idiom used in computer programming to store a set of Boolean datatype flags compactly, as a series of bits. \n  The bit field is stored in an integral type of known, fixed bit-width. \n  Each Boolean flag is stored in a separate bit. \n  Usually the source code will define a set of constants, each a power of two, that semantically associate each individual bit with its respective Boolean flag. \n  The bitwise operators and, or, and not are used in combination to set, reset and test the flags.\n  </p>\n  "^^rdf:HTML .

qudt:BitAligned  rdf:type    qudt:AlignmentType;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Bit aligned" , "Bit Aligned";
        dcterms:description  "Alignment at a bit level."^^rdf:HTML;
        dtype:literal        "bit" .

qudt:BigEndian  rdf:type     qudt:EndianType;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Big Endian";
        dcterms:description  "A big-endian machine stores the most significant byte first."^^rdf:HTML;
        dtype:code           1;
        dtype:literal        "big" .

