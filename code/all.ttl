        sh:property       qudt:Prefix-altSymbol , qudt:Prefix-latexSymbol , qudt:Prefix-prefixMultiplier , qudt:Prefix-prefixMultiplierSN , qudt:Prefix-siExactMatch , qudt:Prefix-symbol , qudt:Prefix-ucumCode .

qudt:PlaneAngleUnit  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
