xsd:dateTime  rdf:type       rdfs:Datatype;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        dcterms:description  "\n  <p>YYYY-MM-DDThh:mm:ss[.dd] or YYYY-DDDThh:mm:ss[.dd], where 'YYYY' is the year, 'MM' is the two-digit month, 'DD' is the two-digit day, 'DDD' is the three digit day of year, 'T' is constant, 'hh:mm:ss[.dd]' is the UTC time in hours, minutes, seconds, and optional fractional seconds. \n  As many 'd' characters to the right of the period as required may be used to obtain the required precision. \n  All fields require leading zeros.\n  </p>"^^rdf:HTML .

xsd:date  rdf:type  rdfs:Datatype .

xsd:byte  rdf:type  rdfs:Datatype .

xsd:boolean  rdf:type  rdfs:Datatype .

xsd:base64Binary  rdf:type  rdfs:Datatype .

xsd:anyURI  rdf:type  rdfs:Datatype .

xsd:QName  rdf:type  rdfs:Datatype .

xsd:NOTATION  rdf:type  rdfs:Datatype .

qudt:positive  rdf:type   qudt:Polarity;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "positive";
        dtype:code        "2";
        dtype:literal     "positive" .

qudt:negative  rdf:type   qudt:Polarity;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
