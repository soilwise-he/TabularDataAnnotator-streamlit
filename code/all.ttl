        qudt:informativeReference  "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI , "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-51"^^xsd:anyURI , "http://en.wikipedia.org/wiki/Admittance"^^xsd:anyURI;
        qudt:latexDefinition       "$Y = \\frac{1}{Z}$, where $Z$ is impedance."^^qudt:LatexString;
        qudt:latexSymbol           "$Y$"^^qudt:LatexString;
        qudt:wikidataMatch         <http://www.wikidata.org/entity/Q214518> .

