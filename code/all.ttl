        rdfs:isDefinedBy             <http://qudt.org/$$QUDT_VERSION$$/vocab/unit>;
        rdfs:label                   "Bar Litre per Second"@en , "Bar Litre per Second" , "Bar Liter per Second"@en-US;
        dcterms:description          "\n  The unit $\\textit{Bar Litre Per Second}$ is the product of the unit $bar$ and\n   the unit $litre$ divided by the SI base unit for second.\n  "^^qudt:LatexString;
        qudt:applicableSystem        sou:CGS;
