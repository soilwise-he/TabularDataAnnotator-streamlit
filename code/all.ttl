dt:UCUMcs  rdf:type          rdfs:Datatype;
        rdfs:comment         "Lexical pattern for the case-sensitive version of UCUM code"@en;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt>;
        rdfs:label           "case-sensitive UCUM code"@en;
        rdfs:seeAlso         <https://ucum.org/ucum.html>;
        dcterms:source       <https://ucum.org/ucum.html>;
        owl:equivalentClass  [ rdf:type              rdfs:Datatype;
                               owl:onDatatype        xsd:string;
                               owl:withRestrictions  ( [ xsd:pattern  "[\\x21-\\x7e]+" ]
                                                     )
                             ] .

dt:SDNcode  rdf:type         rdfs:Datatype;
        rdfs:comment         "Lexical pattern for the case-sensitive version of UCUM code"@en;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt>;
        rdfs:label           "case-sensitive UCUM code"@en;
        rdfs:seeAlso         <https://ucum.org/ucum.html>;
        dcterms:source       <https://ucum.org/ucum.html>;
        owl:equivalentClass  [ rdf:type              rdfs:Datatype;
                               owl:onDatatype        xsd:string;
                               owl:withRestrictions  ( [ xsd:pattern  "SDN:P06::[0-9A-Z]{4}" ]
                                                     )
                             ] .

