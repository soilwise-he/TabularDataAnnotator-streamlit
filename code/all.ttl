        rdfs:label        "lower bound" .

qudt:length  rdf:type        owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "length";
        rdfs:range           xsd:integer;
        dcterms:description  "The length of a structure, for example the size of a vector" .

