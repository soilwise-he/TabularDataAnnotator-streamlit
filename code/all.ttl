        qudt:latexSymbol            "$\\rho_R$"^^qudt:LatexString;
        qudt:plainTextDescription   "\"Residual Resistivity\" for metals, is the resistivity extrapolated to zero thermodynamic temperature.";
        qudt:wikidataMatch          <http://www.wikidata.org/entity/Q25098876> .

quantitykind:Repetency
        rdf:type                   qudt:QuantityKind;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind>;
        rdfs:label                 "repetency"@en-US , "repetency";
