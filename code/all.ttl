PREFIX voag:         <http://voag.linkedmodel.org/schema/voag#>
PREFIX xsd:          <http://www.w3.org/2001/XMLSchema#>

qfn:DerivableDimensionVectorMissingRule
        rdf:type        sh:NodeShape;
        sh:severity     sh:Violation;
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "{$this}: dimension vector is missing and no way to derive it (no qudt:scalingOf, no qudt:hasFactorUnit present)";
                          sh:prefixes  qfn:;
                          sh:select    "\n    SELECT $this\n    WHERE {\n        {\n            $this a qudt:Unit .\n            FILTER NOT EXISTS {\n                $this qudt:hasDimensionVector ?actualDimVec\n            }\n            FILTER NOT EXISTS {\n                {\n                    $this qudt:hasFactorUnit ?fu\n                } union {\n                    $this qudt:scalingOf ?base\n                }\n            }\n        }\n    }\n\n    "
                        ];
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "{$this}: dimension vector is missing but can be derived to be {?calculatedDimVec}";
                          sh:prefixes  qfn:;
                          sh:select    "\n\n    {{QUERY_WITHOUT_PREFIXES}}\n\n    "
                        ];
        sh:targetClass  qudt:Unit .

qfn:DerivableDimensionVectorMissing
        rdf:type     owl:Ontology;
        owl:imports  qfn: .

qfn:inferDerivableDimensionvectorRule
        rdf:type        sh:NodeShape;
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          sh:construct  "\n        CONSTRUCT {\n            $this qudt:hasDimensionVector ?calculatedDimVec .\n        }\n        WHERE\n        {\n            {{QUERY_WITHOUT_PREFIXES}}\n        }\n\n\n        ";
                          sh:prefixes   qfn:
                        ];
        sh:targetClass  qudt:Unit .

qfn:inferDerivableDimensionvector
        rdf:type     owl:Ontology;
        owl:imports  qfn: .

qfn:symbolRule  rdf:type  sh:NodeShape;
        sh:severity     sh:Violation;
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "\n    Unit {$this} has symbol '{?actualSymbol}', but '{?calculatedSymbol}' is inferred via {?sourceRelation}.\n    If the current symbol is correct, add the unit to `src/build/sparql2shacl/symbol/units-overriding-inferred-symbols.ttl`\n    ";
                          sh:prefixes  qfn:;
                          sh:select    "\n    SELECT * WHERE\n    {\n        {\n\n\n{{QUERY_WITHOUT_PREFIXES}}\n\n\n        }\n\n        FILTER NOT EXISTS {\n            qudt:UnitsOverridingInferredSymbol qudt:includes ?this .\n        }\n    }\n\n    "
                        ];
        sh:targetClass  qudt:Unit .

qudt:UnitsOverridingInferredSymbol
        qudt:includes  unit:PERCENT-PER-TEN-THOUSAND , unit:PERCENT-PER-HUNDRED-THOUSAND , unit:MilliIN , unit:MilliARCSEC .

qfn:inferSymbolsRule  rdf:type  sh:NodeShape;
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          sh:construct  "\n        CONSTRUCT {\n                 $this qudt:symbol ?calculatedSymbol ;\n                }\n        WHERE\n        {\n            {\n\n\n{{QUERY_WITHOUT_PREFIXES}}\n\n\n            }\n\n            FILTER NOT EXISTS {\n                qudt:UnitsOverridingInferredSymbol qudt:includes ?this .\n            }\n        }\n\n        ";
                          sh:prefixes   qfn:
                        ];
        sh:targetClass  qudt:Unit .

qfn:inferSymbols  rdf:type  owl:Ontology;
        owl:imports  qfn: .

qfn:ValidateConversionMultiplier
        rdf:type     owl:Ontology;
        owl:imports  qfn: .

qfn:conversionMultiplierPrecisionRule
        rdf:type        sh:NodeShape;
        sh:severity     sh:Violation;
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "\n        {$this}\n        Multiplier's precision is off.\n        actual multiplier : {?actualMultiplier}\n        calculated        : {?calculatedMultiplier}\n        ";
                          sh:prefixes  qfn:;
                          sh:select    "\n\n    {{QUERY_WITHOUT_PREFIXES}}\n\n    "
                        ];
        sh:targetClass  qudt:Unit .

qfn:ValidateConversionMultiplierPrecision
        rdf:type     owl:Ontology;
        owl:imports  qfn: .

qfn:conversionMultiplierRule
        rdf:type        sh:NodeShape;
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          sh:construct  "\n        CONSTRUCT {\n            $this\n                qudt:conversionMultiplier ?calculatedMultiplier ;\n                qudt:conversionMultiplierSN ?calculatedMultiplierSN .\n\n        }\n        WHERE\n        {\n            {\n                {{QUERY_WITHOUT_PREFIXES}}\n            }\n            BIND(qfn:decimalToDouble(?calculatedMultiplier) AS ?calculatedMultiplierSN)\n        }\n\n\n        ";
                          sh:prefixes   qfn:
                        ];
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          sh:construct  "\n        CONSTRUCT {\n            $this\n                qudt:conversionMultiplier ?calculatedMultiplier ;\n                qudt:conversionMultiplierSN ?calculatedMultiplierSN .\n\n        }\n        WHERE\n        {\n            {\n                {{QUERY_WITHOUT_PREFIXES}}\n            }\n            BIND(qfn:decimalToDouble(?calculatedMultiplier) AS ?calculatedMultiplierSN)\n        }\n\n\n        ";
                          sh:prefixes   qfn:
                        ];
        sh:severity     sh:Violation;
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "\n        {$this}\n        Multiplier differs from the multiplier calculated from its factor units.\n        actual multiplier : {?actualMultiplier}\n        calculated        : {?calculatedMultiplier}\n        badness           : {?relDiff}\n        The badness is the relative difference of the difference and the actual or calculated multiplier, whichever is bigger. A badness >> 0 is a real issue to look at. A badness ~ 0 is usually due to a difference in precision and should be resolved by using the calculated value.\n        ";
                          sh:prefixes  qfn:;
                          sh:select    "\n\n    {{QUERY_WITHOUT_PREFIXES}}\n\n    "
                        ];
        sh:targetClass  qudt:Unit .

qfn:inferConversionMultiplier
        rdf:type     owl:Ontology;
        owl:imports  qfn: .

qfn:ValidateFactorUnits
        rdf:type     owl:Ontology;
        owl:imports  qfn: .

qfn:ucumCodeRule  rdf:type  sh:NodeShape;
        sh:severity     sh:Violation;
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "\n    Unit {$this} has ucumCode '{?actualUcumCode}', but '{?calculatedUcumCode}' is inferred via {?sourceRelation}.\n    If the current ucumCode is correct, add the unit to `src/build/sparql2shacl/ucumCode/units-overriding-inferred-ucum-code.ttl`\n    ";
                          sh:prefixes  qfn:;
                          sh:select    "\n    SELECT * WHERE\n    {\n        {\n\n\n{{QUERY_WITHOUT_PREFIXES}}\n\n\n        }\n\n        FILTER NOT EXISTS {\n            qudt:UnitsOverridingInferredUcumCode qudt:includes ?this .\n        }\n    }\n\n    "
                        ];
        sh:targetClass  qudt:Unit .

qfn:validateSymbols  rdf:type  owl:Ontology;
        owl:imports  qfn: .

qudt:UnitsOverridingInferreducumCode
        qudt:includes  unit:DontFindThis .

qfn:inferUcumCodesRule
        rdf:type        sh:NodeShape;
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          sh:construct  "\n        CONSTRUCT {\n                 $this qudt:ucumCode ?calculatedUcumCode ;\n                }\n        WHERE\n        {\n            {\n\n\n{{QUERY_WITHOUT_PREFIXES}}\n\n\n            }\n\n            FILTER NOT EXISTS {\n                qudt:UnitsOverridingInferredUcumCode qudt:includes ?this .\n            }\n        }\n\n        ";
                          sh:prefixes   qfn:
                        ];
        sh:targetClass  qudt:Unit .

qfn:inferUcumCodes  rdf:type  owl:Ontology;
        owl:imports  qfn: .

qfn:qkRule  rdf:type    sh:NodeShape;
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          sh:construct  "\n        CONSTRUCT {\n            $this qudt:hasFactorUnit [\n                qudt:hasUnit ?baseUnit ;\n                qudt:exponent ?exponent\n            ] .\n        }\n        WHERE\n        {\n\n            {{QUERY_WITHOUT_PREFIXES}}\n        }\n\n        ";
                          sh:prefixes   qfn:
                        ];
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          sh:construct  "\n        CONSTRUCT {\n                 $this\n                    qudt:scalingOf ?baseUnit ;\n                    qudt:prefix ?prefix .\n                }\n        WHERE\n        {\n\n            {{QUERY_WITHOUT_PREFIXES}}\n        }\n\n        ";
                          sh:prefixes   qfn:
                        ];
        sh:severity     sh:Violation;
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "Unit {$this} does not have required qudt:hasFactorUnit reference to {?baseUnit}.";
                          sh:prefixes  qfn:;
                          sh:select    "\n\n    {{QUERY_WITHOUT_PREFIXES}}\n\n    "
                        ];
        sh:sparql       [ rdf:type     sh:SPARQLConstraint;
                          sh:message   "Unit {$this} does not have required qudt:scalingOf reference to {?baseUnit}";
                          sh:prefixes  qfn:;
                          sh:select    "\n\n    {{QUERY_WITHOUT_PREFIXES}}\n\n    "
                        ];
        sh:targetClass  qudt:Unit .

qfn:inferFactorUnits  rdf:type  owl:Ontology;
        owl:imports  qfn: .

qudt:SymmetricRelationShape
        rdf:type        sh:NodeShape;
        sh:rule         [ rdf:type      sh:SPARQLRule;
                          rdfs:comment  "Declare the inverse triples for symmetric relations";
                          sh:construct  "\n    CONSTRUCT {\n    ?o ?p $this .\n    }\n    WHERE {\n        ?p a qudt:SymmetricRelation .\n  $this ?p ?o .\n    FILTER NOT EXISTS {\n        $this qudt:deprecated true\n    }\n    FILTER NOT EXISTS {\n        ?o ?p $this\n    }\n}\n";
                          sh:prefixes   qudt:
                        ];
        sh:targetClass  qudt:Unit .

