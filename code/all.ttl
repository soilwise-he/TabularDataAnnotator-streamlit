        qudt:qkdvNumerator         qkdv:A0E0L1I0M0H0T0D0;
        qudt:siExactMatch          si-quantity:VELA;
        qudt:wikidataMatch         <http://www.wikidata.org/entity/Q161635>;
        skos:altLabel              "kelajuan bersudut"@ms , "angular speed"@en .

