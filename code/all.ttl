quantitykind:AngularWavenumber
        rdf:type                    qudt:QuantityKind;
        rdfs:isDefinedBy            <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind>;
        rdfs:label                  "角波数"@zh , "角波数"@ja , "عدد موجى زاوى"@ar , "número de onda angular"@pt , "Kreisrepetenz"@de , "angular wavenumber"@en , "liczba falowa kątowa"@pl , "nombre d'onde angulaire"@fr , "numero d'onda angolare"@it , "número de onda angular"@es;
        dcterms:description         "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector."^^qudt:LatexString;
        qudt:hasDimensionVector     qkdv:A0E0L-1I0M0H0T0D0;
        qudt:informativeReference   "http://en.wikipedia.org/wiki/Wavenumber"^^xsd:anyURI;
        qudt:isoNormativeReference  "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
        qudt:latexDefinition        "$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave.\n\nAlternatively:\n\n$k = \\frac{p}{\\hbar}$, where $p$ is the linear momentum of quasi free electrons in an electron gas and $\\hbar$ is the reduced Planck constant ($h$ divided by $2\\pi$); for phonons, its magnitude is $k = \\frac{2\\pi}{\\lambda}$, where $\\lambda$ is the wavelength of the lattice vibrations."^^qudt:LatexString;
        qudt:plainTextDescription   "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.";
        qudt:symbol                 "k";
        qudt:wikidataMatch          <http://www.wikidata.org/entity/Q30338487>;
        vaem:todo                   "belongs to SOQ-ISO";
        skos:altLabel               "تكرار زاوى"@ar , "répétence angulaire"@fr , "repetência angular"@pt , "repetencja kątowa"@pl , "angular repetency"@en , "Kreiswellenzahl"@de;
        skos:broader                quantitykind:InverseLength .

quantitykind:AngularVelocity
        rdf:type                   qudt:QuantityKind;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind>;
        rdfs:label                 "角速度"@zh , "角速度"@ja , "कोणीय वेग"@hi , "سرعت زاویه‌ای"@fa , "سرعة زاوية"@ar , "Угловая скорость"@ru , "Úhlová rychlost"@cs , "vitesse angulaire"@fr , "velocità angolare"@it , "velocidade angular"@pt , "velocidad angular"@es , "kotna hitrost"@sl , "angular velocity"@en , "Winkelgeschwindigkeit"@de , "Viteză unghiulară"@ro , "Açısal hız"@tr , "Halaju bersudut"@ms , "Prędkość kątowa"@pl;
        rdfs:seeAlso               quantitykind:RotationalVelocity , quantitykind:RotationalFrequency;
        dcterms:description        "Angular Velocity refers to how fast an object rotates or revolves relative to another point."^^qudt:LatexString;
        qudt:dbpediaMatch          "http://dbpedia.org/resource/Angular_velocity"^^xsd:anyURI;
