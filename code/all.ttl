qudt:minValue  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "minimum value" .

qudt:minMantissa  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "min mantissa";
        rdfs:range           xsd:integer;
        dcterms:description  "\n  <p>The minimium mantissa is the negative integer with the greatest magnitude that may appear as a coefficient in a finite precision representation of a real number.  \n  For a given numeric data type, the value of <em>minMantissa</em> (<em>M</em>) and the values of <em>base</em> (<em>b</em>) and <em>precision</em> (<em>p</em>) are related by the formula:\n  </p>\n  <p><em>M = -(b<sup>p</sup> - 1)</em>.\n  </p>"^^rdf:HTML .

qudt:minLength  rdf:type    owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label          "min length";
        rdfs:range          xsd:integer;
        rdfs:subPropertyOf  qudt:Length .

qudt:minInclusive  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "min inclusive";
        rdfs:subPropertyOf   qudt:lowerBound;
        dcterms:description  "minInclusive is the inclusive lower bound of the value space for a datatype with the ordered property. The value of minInclusive must be in the value space of the base type." .

qudt:minExclusive  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "min exclusive";
        rdfs:subPropertyOf   qudt:lowerBound;
        dcterms:description  "minExclusive is the exclusive lower bound of the value space for a datatype with the ordered property. The value of minExclusive must be in the value space of the base type or be equal to {value} in {base type definition}." .

qudt:minBits  rdf:type    owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "minimum bits";
        rdfs:range        xsd:integer .

qudt:microsoftSQLServerName
        rdf:type            owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label          "Microsoft SQL Server name";
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  qudt:id .

qudt:memberDatatype  rdf:type  rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "member datatype";
        dcterms:description  "\n  This property is used to define the data type of a collection's elements. \n  It is used for collections with elements that are all of the same type.\n  " .

qudt:member  rdf:type        rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "member";
        dcterms:description  "\n  This property is used to define a collection's elements. \n  " .

qudt:maxMantissa  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "max mantissa";
        rdfs:range           xsd:integer;
        dcterms:description  "\n  <p>The maximium mantissa is the largest integer that may appear as a coefficient in a finite precision representation of a real number. \n  For a given numeric data type, the value of <em>maxMantissa}</em> (<em>M</em>) and the values of <em>base</em> (<em>b</em>) and  <em>precision</em> (<em>p</em>) are related by the formula:\n   <em>M = b<sup></sup> - 1</em>.\n  </p>"^^rdf:HTML , "\n  <p>The maximium mantissa is the largest integer that may appear as a coefficient in a finite precision representation of a real number.\n  For a given numeric data type, the value of <em>maxMantissa}</em> (<em>M</em>) and the values of <em>base</em> (<em>b</em>) and  <em>precision</em> (<em>p</em>) are related by the formula:\n  </p>\n  <p><em>M = b<sup></sup> - 1</em> .</p>\n  "^^rdf:HTML .

qudt:maxLength  rdf:type    owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label          "max length";
        rdfs:range          xsd:integer;
        rdfs:subPropertyOf  qudt:Length .

qudt:maxInclusive  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "max inclusive";
        rdfs:subPropertyOf   qudt:upperBound;
        dcterms:description  "maxInclusive is the inclusive upper bound of the value space for a datatype with the ordered property. The value of maxInclusive must be in the value space of the base type." .

qudt:maxExponent  rdf:type  owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "max exponent";
        rdfs:range        xsd:integer .

qudt:maxExclusive  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "max exclusive";
        rdfs:range           xsd:string;
        rdfs:subPropertyOf   qudt:upperBound;
        dcterms:description  "maxExclusive is the exclusive upper bound of the value space for a datatype with the ordered property. The value of maxExclusive must be in the value space of the base type or be equal to {value} in {base type definition}." .

qudt:maxDepth  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "max depth";
        rdfs:range        xsd:integer .

qudt:maxBits  rdf:type    owl:DatatypeProperty , rdf:Property;
