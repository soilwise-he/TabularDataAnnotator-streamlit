        vaem:previousPublishedVersion  "https://qudt.org/doc/$$QUDT_PREV_RELEASE_YEAR$$/$$QUDT_PREV_RELEASE_MONTH$$/DOC_VOCAB-QUANTITY-KINDS-ALL.html"^^xsd:anyURI;
        vaem:specificity               1;
