        qudt:ucumCode                "Hz"^^qudt:UCUMcs;
        qudt:udunitsCode             "Hz";
        qudt:uneceCommonCode         "HTZ";
        qudt:wikidataMatch           <http://www.wikidata.org/entity/Q39369> .

