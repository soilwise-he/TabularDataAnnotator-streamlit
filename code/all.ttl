        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "2D Array Value List";
        rdfs:subClassOf      rdf:List;
        dcterms:description  "\n  An rdf:List for a 2D array.\n  For example \"[[1,2], [3,4], [5,6]]\"\n  " .

qudt:Array-value  rdf:type  sh:PropertyShape;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        sh:node           qudt:NumericListShape;
        sh:path           qudt:value .

qudt:Array-isHeterogeneous
        rdf:type          sh:PropertyShape;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        sh:datatype       xsd:boolean;
        sh:maxCount       1;
        sh:path           qudt:isHeterogeneous .

qudt:AllValuesMustHaveSameDataTypeShape
        rdf:type          sh:NodeShape;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "All Values must have same DataType Shape";
        sh:severity       sh:Violation;
        sh:sparql         [ sh:message   "Data Item {$this} has type {?valueType}.";
                            sh:prefixes  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatypePrefixes>;
                            sh:select    "\n        SELECT $this ?valueType\n        WHERE {\n              $this qudt:datatype/qudt:rdfsDatatype ?datatype .\n              $this qudt:value ?valueList.\n              ?valueList rdf:rest*/rdf:first ?value .\n              BIND(datatype(?value) as ?valueType) .\n              FILTER(?valueType != ?datatype)\n        }\n        "
                          ];
        sh:targetClass    qudt:HomogeneousArray .

<http://qudt.org/schema/shacl/datatype/GMD_datatype>
        rdf:type                       vaem:GraphMetaData;
        rdfs:isDefinedBy               <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label                     "QUDT SHACL Schema for Datatypes - Version $$QUDT_VERSION$$";
        dcterms:description            "\n  <p>The QUDT 'Datatype' ontology is a specification of scalar and structured data types. \n  Scalar data types are defined for all the commonly encountered forms of numbers, characters and booleans, with their representations in a number of vendor and industry specific technologies. \n  Structured data types cover arrays, lists, trees and many other forms of composite data elements. \n  Specification of coordinate systems is also covered.\n  </p>\n  "^^rdf:HTML;
        dcterms:modified               "2025-04-02T10:54:24-05:00"^^xsd:dateTime;
        dcterms:rights                 "\n  <p>The QUDT Ontologies are issued under a Creative Commons Attribution 4.0 International License (CC BY 4.0), available  <a href=\"https://creativecommons.org/licenses/by/4.0/\">here</a>. \n  Attribution should be made to <a href=\"https://www.qudt.org\">QUDT.org</a>.\n  </p>"^^rdf:HTML;
        dcterms:subject                "Datatypes";
        vaem:graphTitle                "QUDT SHACL Schema for Datatypes - Version $$QUDT_VERSION$$";
        vaem:hasGraphRole              vaem:SchemaGraph;
        vaem:isMetadataFor             <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        vaem:latestPublishedVersion    "https://qudt.org/doc/$$CURRENT_YEAR$$/$$CURRENT_MONTH$$/DOC_SCHEMA-SHACL-DATATYPES.html"^^xsd:anyURI;
        vaem:logo                      "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI;
        vaem:name                      "QUDT";
        vaem:namespace                 "http://qudt.org/schema/qudt/"^^xsd:anyURI;
        vaem:namespacePrefix           "qudt";
        vaem:owner                     "QUDT.ORG";
        vaem:previousPublishedVersion  "https://qudt.org/doc/$$QUDT_PREV_RELEASE_YEAR$$/$$QUDT_PREV_RELEASE_MONTH$$/DOC_SCHEMA-SHACL-DATATYPES.html"^^xsd:anyURI;
        vaem:publishedDate             "2017-05-10"^^xsd:date;
        vaem:releaseDate               "2016-05-09"^^xsd:date;
        vaem:title                     "QUDT SHACL Schema for Datatypes - Version $$QUDT_VERSION$$";
        vaem:turtleFileURL             "http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype.ttl"^^xsd:anyURI;
        vaem:usesNonImportedResource   <http://voag.linkedmodel.org/voag#QUDT-Attribution> , dcterms:title , dcterms:rights , dcterms:modified , dcterms:creator , dcterms:created , dcterms:abstract;
        vaem:withAttributionTo         <http://voag.linkedmodel.org/voag#QUDT-Attribution> .

<http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatypePrefixes>
