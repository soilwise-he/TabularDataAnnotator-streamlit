        qudt:hasFactorUnit           [ qudt:exponent  -1;
                                       qudt:hasUnit   unit:SEC
                                     ];
        qudt:hasQuantityKind         quantitykind:KinematicViscosity;
        qudt:iec61360Code            "0112/2///62720#UAA281";
        qudt:informativeReference    "http://en.wikipedia.org/wiki/Stokes?oldid=426159512"^^xsd:anyURI , "http://www.efunda.com/glossary/units/units--kinematic_viscosity--stokes.cfm"^^xsd:anyURI;
        qudt:latexDefinition         "$(cm^2/s$)"^^qudt:LatexString;
        qudt:omUnit                  <http://www.ontology-of-units-of-measure.org/resource/om-2/stokes>;
