        qudt:bits          64;
        qudt:bytes         8;
        qudt:maxInclusive  "2^{64}-1";
        qudt:minInclusive  "1";
        qudt:mySQLName     "BIGINT";
        qudt:rdfsDatatype  xsd:unsignedLong;
        qudt:signedness    qudt:Unsigned;
        dtype:literal      "PI64" .

qudt:ONstate  rdf:type    qudt:OnOffState;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype>;
        rdfs:label        "On";
        dtype:code        "0";
        dtype:literal     "on" .

qudt:ON  rdf:type         qudt:OnOffStateType;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype>;
        rdfs:label        "On";
        dtype:code        "1";
        dtype:literal     "on" .

qudt:OFFstate  rdf:type   qudt:OnOffState;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype>;
        rdfs:label        "Off";
        dtype:code        "0";
        dtype:literal     "off" .

qudt:OFF  rdf:type        qudt:OnOffStateType;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype>;
        rdfs:label        "Off";
