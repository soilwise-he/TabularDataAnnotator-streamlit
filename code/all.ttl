unit:V-PER-M2  rdf:type              qudt:Unit;
        rdfs:isDefinedBy             <http://qudt.org/$$QUDT_VERSION$$/vocab/unit>;
        rdfs:label                   "Вольт на Квадратный Метр"@ru , "Волт на Квадратен Метър"@bg , "Βολτ ανά Τετραγωνικό Μέτρο"@el , "Wolt na Metr Kwadratowy"@pl , "Voltium per Metrum Quadratum"@la , "Voltio por Metro Cuadrado"@es , "Volt pro Quadratmeter"@de , "Volt por Metro Quadrado"@pt , "Volt per Square Metre"@en , "Volt per Square Metre" , "Volt per Square Meter"@en-US , "Volt per Metro Quadrato"@it , "Volt per Metrekare"@tr , "Volt per Meter Persegi"@ms , "Volt pe Metru Pătrat"@ro , "Volt par Mètre Carré"@fr , "Volt na Kvadratni Meter"@sl , "Volt na Čtvereční Metr"@cs;
        dcterms:description          "\n  $\\textit{Volt per Square Metre}$ is the divergence at a particular point in a vector field is (roughly) how much the vector field 'spreads out' from that point. \n  Operationally, we take the partial derivative of each of the field with respect to each of its space variables and add all the derivatives together to get the divergence. \n  $\\textit{Electric field}$ ($V/m$) differentiated with respect to distance ($m$) yields $V/(m^2)$.\n  "^^qudt:LatexString;
        qudt:applicableSystem        sou:CGS-EMU , sou:CGS-GAUSS , sou:SI;
        qudt:conversionMultiplier    1.0;
        qudt:conversionMultiplierSN  1.0E0;
        qudt:derivedCoherentUnitOfSystem
                sou:SI;
        qudt:expression              "$V m^{-2}$"^^qudt:LatexString;
        qudt:hasDimensionVector      qkdv:A0E-1L0I0M1H0T-3D0;
        qudt:hasQuantityKind         quantitykind:EnergyPerAreaElectricCharge;
        qudt:symbol                  "V/m²";
        qudt:ucumCode                "V.m-2"^^qudt:UCUMcs .

unit:V-PER-M  rdf:type               qudt:DerivedUnit , qudt:Unit;
        rdfs:isDefinedBy             <http://qudt.org/$$QUDT_VERSION$$/vocab/unit>;
        rdfs:label                   "伏特每米"@zh , "ボルト毎メートル"@ja , "प्रति मीटर वोल्ट"@hi , "ولت بر متر"@fa , "مقياس التبادل، الأس السالب للمتر"@ar , "Вольт на Метр"@ru , "Волт на Метър"@bg , "Βολτ ανά Μέτρο"@el , "Wolt na Metr"@pl , "Voltium per Metrum"@la , "Voltio por Metro"@es , "Volt pro Meter"@de , "Volt por Metro"@pt , "Volt per Metro"@it , "Volt per Metre"@tr , "Volt per Metre"@en , "Volt per Metre" , "Volt per Meter"@ms , "Volt per Meter"@en-US , "Volt pe Metru"@ro , "Volt par Mètre"@fr , "Volt na Metr"@cs , "Volt na Meter"@sl;
        dcterms:description          "\n  The unit $\\{Volt Per Meter (V/m)}$ is a unit in the category of Electric field strength. \n  It is also known as volts per meter, volt/meter, volt/metre, volt per metre, volts per metre. \n  This unit is commonly used in the SI unit system. \n  $\\{Volt Per Meter}$ has a dimension of $MLT^{-3}I^{-1}$ where $M$ is mass, $L$ is length, $T$ is time, and $I$ is electric current. \n  This unit is the standard SI unit in this category.\n  "^^qudt:LatexString;
        qudt:applicableSystem        sou:CGS-EMU , sou:CGS-GAUSS , sou:SI;
        qudt:conversionMultiplier    1.0;
        qudt:conversionMultiplierSN  1.0E0;
        qudt:definedUnitOfSystem     sou:SI;
        qudt:derivedCoherentUnitOfSystem
                sou:SI;
        qudt:expression              "$V/m$"^^qudt:LatexString;
        qudt:hasDimensionVector      qkdv:A0E-1L1I0M1H0T-3D0;
        qudt:hasQuantityKind         quantitykind:ElectricField , quantitykind:ElectricFieldStrength;
        qudt:iec61360Code            "0112/2///62720#UAA301";
        qudt:informativeReference    "http://www.efunda.com/glossary/units/units--electric_field_strength--volt_per_meter.cfm"^^xsd:anyURI;
        qudt:symbol                  "V/m";
        qudt:ucumCode                "V.m-1"^^qudt:UCUMcs;
        qudt:uneceCommonCode         "D50";
        qudt:wikidataMatch           <http://www.wikidata.org/entity/Q3562962> .

