        rdfs:label                  "difuzijski koeficient"@sl , "Diffusionskoeffizient"@de , "coefficient de diffusion"@fr , "coefficiente di diffusione"@it , "coeficiente de difusión"@es , "coeficiente de difusão"@pt , "diffusion coefficient"@en;
        dcterms:description         "The \"Diffusion Coefficient\" is "^^qudt:LatexString;
