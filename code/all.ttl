        rdfs:label                   "Квадратный Метр на Моль"@ru , "Квадратен Метър на Мол"@bg , "Τετραγωνικό Μέτρο ανά Μολ"@el , "Čtvereční Metr na Mol"@cs , "Square Metre per Mole"@en , "Square Metre per Mole" , "Square Meter per Mole"@en-US , "Quadratmeter pro Mol"@de , "Mètre Carré par Mole"@fr , "Metrum Quadratum per Moles"@la , "Metru Pătrat pe Mol"@ro , "Metro Quadrato per Mole"@it , "Metro Quadrado por Mol"@pt , "Metro Cuadrado por Mol"@es , "Metrekare per Mol"@tr , "Metr Kwadratowy na Mol"@pl , "Meter Persegi per Mole"@ms , "Kvadratni Meter na Mol"@sl;
        dcterms:description          "Square Meter Per Mole (m2/mol) is a unit in the category of Specific Area. It is also known as square meters per mole, square metre per per, square metres per per, square meter/per, square metre/per. This unit is commonly used in the SI unit system. Square Meter Per Mole (m2/mol) has a dimension of M-1L2 where $M$ is mass, and $L$ is length. This unit is the standard SI unit in this category."^^rdf:HTML;
        qudt:applicableSystem        sou:SI;
        qudt:conversionMultiplier    1.0;
        qudt:conversionMultiplierSN  1.0E0;
        qudt:expression              "$m^2/mol$"^^qudt:LatexString , "$m^{2}/mol$"^^qudt:LatexString;
        qudt:hasDimensionVector      qkdv:A-1E0L2I0M0H0T0D0;
        qudt:hasQuantityKind         quantitykind:MolarAbsorptionCoefficient , quantitykind:MolarAttenuationCoefficient;
        qudt:hasReciprocalUnit       unit:MOL-PER-M2;
        qudt:iec61360Code            "0112/2///62720#UAA751";
        qudt:isoNormativeReference   "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
        qudt:symbol                  "m²/mol";
        qudt:ucumCode                "m2.mol-1"^^qudt:UCUMcs;
        qudt:uneceCommonCode         "D22";
        qudt:wikidataMatch           <http://www.wikidata.org/entity/Q86203731> .

