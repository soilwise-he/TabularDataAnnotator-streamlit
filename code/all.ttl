        qudt:informativeReference    "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-1284"^^xsd:anyURI , "http://en.wikipedia.org/wiki/Sievert?oldid=495474333"^^xsd:anyURI;
