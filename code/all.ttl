constant:SpeedOfLight_Vacuum
        rdf:type                   qudt:PhysicalConstant;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/constant>;
        rdfs:label                 "Speed of Light (vacuum)"@en;
        rdfs:seeAlso               constant:PermittivityOfVacuum , constant:MagneticConstant;
        dcterms:description        "\n  The $\\textit{Speed of Light in Vacuum}$, is a universal physical constant important in many areas of physics. \n  Its value is 299,792,458 metres per second, a figure that is exact because the length of the metre is\n   defined from this constant and the international standard for time.\n  "^^qudt:LatexString;
        qudt:hasQuantityKind       quantitykind:Speed;
        qudt:informativeReference  "http://dbpedia.org/resource/Speed_of_light"^^xsd:anyURI , "http://en.wikipedia.org/wiki/Speed_of_light"^^xsd:anyURI , "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI , "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=113-01-34"^^xsd:anyURI , "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
        qudt:latexDefinition       "$c_0 = 1 / \\sqrt{\\epsilon_0 \\mu_0}$, where {\\epsilon_0} is the permittivity of vacuum, and $\\mu_0$ is the magnetic constant."^^qudt:LatexString;
        qudt:latexSymbol           "$C_0$"^^qudt:LatexString;
        qudt:quantityValue         constant:Value_SpeedOfLight_Vacuum , constant:Value_SpeedOfLight_Vacuum_Imperial;
        qudt:siExactMatch          si-constant:SpeedOfLight;
        qudt:ucumCode              "[c]"^^qudt:UCUMcs .

