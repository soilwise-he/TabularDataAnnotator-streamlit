constant:UniversalGasConstant
        rdf:type                   qudt:PhysicalConstant;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/constant>;
        rdfs:label                 "Universal Gas Constant"@en;
        qudt:exactMatch            constant:MolarGasConstant;
        qudt:hasDimensionVector    qkdv:A-1E0L2I0M1H-1T-2D0;
        qudt:latexSymbol           "$R$"^^qudt:LatexString;
        qudt:plainTextDescription  "\n  The gas constant (also known as the molar, universal, or ideal gas constant) is a physical constant which is featured in many fundamental equations in the physical sciences, such as the ideal gas law and the Nernst equation.\n  Physically, the gas constant is the constant of proportionality that happens to relate the energy scale in physics to the temperature scale, when a mole of particles at the stated temperature is being considered.\n  "^^qudt:LatexString;
        qudt:quantityValue         constant:Value_MolarGasConstant .

