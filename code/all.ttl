        rdfs:label               "Ambient Pressure"@en;
        dcterms:description      "The ambient pressure on an object is the pressure of the surrounding medium, such as a gas or liquid, which comes into contact with the object.\nThe SI unit of pressure is the pascal (Pa), which is a very small unit relative to atmospheric pressure on Earth, so kilopascals ($kPa$) are more commonly used in this context. "^^qudt:LatexString;
        qudt:hasDimensionVector  qkdv:A0E0L-1I0M1H0T-2D0;
        qudt:symbol              "p_a";
        qudt:wikidataMatch       <http://www.wikidata.org/entity/Q789775>;
        skos:broader             quantitykind:Pressure .

quantitykind:Altitude
        rdf:type                   qudt:QuantityKind;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind>;
        rdfs:label                 "Altitude"@en;
        dcterms:description        "Altitude or height is defined based on the context in which it is used (aviation, geometry, geographical survey, sport, and more). As a general definition, altitude is a distance measurement, usually in the vertical or \"up\" direction, between a reference datum and a point or object. The reference datum also often varies according to the context. [Wikipedia]"^^qudt:LatexString;
        qudt:dbpediaMatch          "http://dbpedia.org/resource/Altitude"^^xsd:anyURI;
        qudt:hasDimensionVector    qkdv:A0E0L1I0M0H0T0D0;
        qudt:plainTextDescription  "Altitude or height is defined based on the context in which it is used (aviation, geometry, geographical survey, sport, and more). As a general definition, altitude is a distance measurement, usually in the vertical or \"up\" direction, between a reference datum and a point or object. The reference datum also often varies according to the context. [Wikipedia]";
        qudt:wikidataMatch         <http://www.wikidata.org/entity/Q190200>;
        skos:broader               quantitykind:Length .

