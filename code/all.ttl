        rdfs:label           "element label";
        dcterms:description  "This property is used to label the field of a composite data structure." .

qudt:elementKind  rdf:type   owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "element kind";
        rdfs:subPropertyOf   qudt:elementKind;
        dcterms:description  "This property is used to describe the quantity kind for a dimensional data type." .

qudt:elementDatatype  rdf:type  rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "element datatype";
        dcterms:description  "\n  This property is used to relate a structured data type with the data type the structured type's elements. \n  It is used for structured data types with elements that are all of the same type.\n  " .

qudt:dimensions  rdf:type    owl:DatatypeProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "dimensions";
        dcterms:description  "The number of elements for each dimension of an array, vector, or matrix." , "\n  The extent of each dimension making up an array or matrix.\n  Dimensions are expressed as an integer list.\n  For example a 4 by 4 array has dimensions (4 4), whereas a vector or a string has dimensions (1).\n  " , "\n  The extent of each dimension making up a matrix or an array. \n  For example a 4 by 4 array has dimensions (4 4),\n  whereas a vector or a string has dimensions (1).\n  " .

qudt:dimensionality  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "dimensionality";
        rdfs:range           xsd:integer;
        dcterms:description  "\n  The number of dimensions making up a matrix or an array. \n  For example a 4 by 4 array has a dimensionality of 2. \n  Whereas a vector or a string has a dimensionality of 1.\n  " .

qudt:defaultValue  rdf:type  owl:AnnotationProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Default Value" .

qudt:datatype  rdf:type      owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "element type" , "datatype";
        dcterms:description  "This property is used to relate a structured data type with the data type the structured type's elements. It is used for structured data types with elements that are all of the same type." , "This property is used to relate a structured data type with the data type of the structured type's elements. It is used for homogeneous structured data types, that is, those whose elements that are all of the same type.";
        vaem:todo            "Change name to type:elementDataType" .

qudt:dataOrder  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "data order" .

qudt:dataEncoding  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "data encoding";
        rdfs:range        qudt:DataEncoding .

qudt:columns  rdf:type    owl:DatatypeProperty , rdf:Property;
