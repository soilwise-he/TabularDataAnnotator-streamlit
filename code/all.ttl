        qudt:informativeReference    "http://en.wikipedia.org/wiki/Henry?oldid=491435978"^^xsd:anyURI;
        qudt:symbol                  "H/m";
        qudt:ucumCode                "H.m-1"^^qudt:UCUMcs;
        qudt:uneceCommonCode         "A98";
        qudt:wikidataMatch           <http://www.wikidata.org/entity/Q55663153> .

