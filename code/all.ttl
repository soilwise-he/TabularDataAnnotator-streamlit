dReceptorThreshold , quantitykind:Coercivity , quantitykind:CoefficientOfHeatTransfer , quantitykind:CelsiusTemperature , quantitykind:CartesianVolume , quantitykind:CartesianCoordinates , quantitykind:Capacitance , quantitykind:BulkModulus , quantitykind:Breadth , quantitykind:BendingMomentOfForce , quantitykind:AuditoryThresholds , quantitykind:ApparentPower , quantitykind:AngularWavenumber , quantitykind:AngularImpulse , quantitykind:AngularFrequency , quantitykind:Absorptance , quantitykind:AcousticImpedance , quantitykind:Action , quantitykind:ActivePower , quantitykind:ActivityThresholds , quantitykind:Adaptation , quantitykind:Admittance;
