nousFluxPerArea , quantitykind:LuminousFlux , quantitykind:LuminousEnergy , quantitykind:LuminousEfficacy , quantitykind:Luminance , quantitykind:LinearVelocity , quantitykind:LinearThermalExpansion , quantitykind:LinearMomentum , quantitykind:LinearElectricCurrent , quantitykind:LinearAcceleration , quantitykind:LengthTemperature , quantitykind:LengthPerElectricCurrent , quantitykind:LengthMolarEnergy , quantitykind:LengthMass , quantitykind:LengthEnergy , quantitykind:KinematicViscosity , quantitykind:InverseVolume , quantitykind:InverseTimeTemperature , quantitykind:InverseSquareEnergy , quantitykind:InversePermittivity , quantitykind:InverseMagneticFlux , quantitykind:InverseLengthTemperature , quantitykind:InverseLength , quantitykind:InverseEnergy , quantitykind:InverseAmountOfSubstance , quantitykind:Inductance , quantitykind:Illuminance , quantitykind:HeatFlowRatePerArea , quantitykind:HeatFlowRate , quantitykind:HeatCapacity , quantitykind:GravitationalAttraction , quantitykind:Frequency , quantitykind:ForcePerLength , quantitykind:ForcePerElectricCharge , quantitykind:ForcePerAreaTime , quantitykind:ForcePerArea , quantitykind:Force , quantitykind:Exposure , quantitykind:EnergyPerSquareMagneticFluxDensity , quantitykind:EnergyPerElectricCharge , quantitykind:EnergyPerAreaElectricCharge , quantitykind:EnergyPerArea , quantitykind:EnergyDensity , quantitykind:Energy , quantitykind:ElectromotiveForce , quantitykind:ElectricQuadrupoleMoment , quantitykind:ElectricPotential , quantitykind:ElectricFlux , quantitykind:ElectricFieldStrength , quantitykind:ElectricDisplacement , quantitykind:ElectricDipoleMoment , quantitykind:ElectricCurrentPerEnergy , quantitykind:ElectricCurrentPerAngle , quantitykind:ElectricCurrentDensity , quantitykind:ElectricConductivity , quantitykind:ElectricChargeVolumeDensity , quantitykind:ElectricChargePerMass , quantitykind:ElectricChargePerArea , quantitykind:ElectricChargePerAmountOfSubstance , quantitykind:ElectricChargeLineDensit