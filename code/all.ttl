        dcterms:description  "This property relates a funciton data type with the type of its arg1." .

qudt:YesNoType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Yes no type";
