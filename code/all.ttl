qudt:Verifiable  rdf:type    qudt:AspectClass , sh:NodeShape;
        rdfs:comment         "An aspect class that holds properties that provide external knowledge and specifications of a given resource.";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/qudt>;
        rdfs:label           "Verifiable";
        rdfs:subClassOf      qudt:Aspect;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      qudt:normativeReference
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      qudt:isoNormativeReference
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      qudt:isoNormativeReference
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      qudt:normativeReference
                             ];
        dcterms:description  "\n  An aspect class that holds properties that provide external knowledge and specifications of a given resource.\n  ";
        sh:property          qudt:InformativeReferencePropertyShape , qudt:Verifiable-dbpediaMatch , qudt:Verifiable-isoNormativeReference , qudt:Verifiable-normativeReference , qudt:Verifiable-wikidataMatch .

