        qudt:plainTextDescription   "The \"Magnetic Quantum Number\" describes the specific orbital (or \"cloud\") within that subshell, and yields the projection of the orbital angular momentum along a specified axis.";
        qudt:symbol                 "m";
        qudt:wikidataMatch          <http://www.wikidata.org/entity/Q2009727>;
        skos:broader                quantitykind:QuantumNumber;
        skos:closeMatch             quantitykind:SpinQuantumNumber , quantitykind:PrincipalQuantumNumber , quantitykind:OrbitalAngularMomentumQuantumNumber .

quantitykind:MagneticPolarization
        rdf:type                   qudt:QuantityKind;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind>;
        rdfs:label                 "Magnetic Polarization"@en;
        rdfs:seeAlso               quantitykind:Magnetization , quantitykind:MagneticFieldStrength , constant:MagneticConstant;
        dcterms:description        "\n$\\text{Magnetic Polarization}$ is a vector quantity equal to the product of the magnetization $M$ and the magnetic constant $\\mu_0$.\n  "^^qudt:LatexString;
        qudt:hasDimensionVector    qkdv:A0E1L-1I0M0H0T0D0;
        qudt:iec61360Code          "0112/2///62720#UAD102";
        qudt:informativeReference  "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI , "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-54"^^xsd:anyURI;
        qudt:latexDefinition       "$J_m = \\mu_0 M$,  where $\\mu_0$ is the magentic constant and $M$ is magnetization."^^qudt:LatexString;
        qudt:latexSymbol           "$J_m$"^^qudt:LatexString;
        qudt:wikidataMatch         <http://www.wikidata.org/entity/Q1884336> .

quantitykind:MagneticMoment
        rdf:type                   qudt:QuantityKind;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind>;
        rdfs:label                 "磁気双極子"@ja , "磁偶极"@zh , "चुम्बकीय द्विध्रुव"@hi , "عزم مغناطيسي"@ar , "دوقطبی مغناطیسی"@fa , "Магнитный момент"@ru , "momento di dipolo magnetico"@it , "momento de dipolo magnético"@pt , "momento de dipolo magnético"@es , "moment magnétique"@fr , "magnetisches Dipolmoment"@de , "magnetic moment"@en , "dipol magnetyczny"@pl , "Momen magnetik"@ms , "Magnetický dipól"@cs , "Manyetik moment"@tr;
        dcterms:description        "\"Magnetic Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Moment\" is also referred to as \"Magnetic Area Moment\", and is not to be confused with Magnetic Dipole Moment."^^qudt:LatexString;
        qudt:exactMatch            quantitykind:MagneticAreaMoment;
        qudt:hasDimensionVector    qkdv:A0E1L2I0M0H0T0D0;
        qudt:iec61360Code          "0112/2///62720#UAD097" , "0112/2///62720#UAD101";
        qudt:informativeReference  "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-49"^^xsd:anyURI , "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI , "https://www.simetric.co.uk/siderived.htm"^^xsd:anyURI;
        qudt:latexDefinition       "$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain."^^qudt:LatexString;
        qudt:plainTextDescription  "\"Magnetic Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Moment\" is also referred to as \"Magnetic Area Moment\", and is not to be confused with Magnetic Dipole Moment.";
        qudt:symbol                "m";
        qudt:wikidataMatch         <http://www.wikidata.org/entity/Q242657>;
        skos:altLabel              "moment giromagnétique"@fr , "momen giromagnetik"@ms , "giromagnetic moment"@en .

