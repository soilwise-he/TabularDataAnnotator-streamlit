        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        sh:maxCount       1;
        sh:node           ( [ sh:or   qudt:NumericTypeUnion ]
                            [ sh:property  [ sh:class  qudt:DataItem;
                                             sh:path   qudt:value
                                           ]
                            ]
                            [ sh:property  [ sh:class  qudt:EnumeratedValue;
                                             sh:path   qudt:value
                                           ]
                            ]
                          );
        sh:path           qudt:value .

