        sh:datatype       xsd:integer;
        sh:maxCount       1;
        sh:path           qudt:dimensionality .

qudt:DateTypeUnion  rdf:type  rdf:List;
        rdf:first            [ sh:datatype  xsd:date ];
        rdf:rest             ( [ sh:datatype  xsd:dateTime ]
                               [ sh:datatype  xsd:gYear ]
                               [ sh:datatype  xsd:gMonth ]
                             );
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Date Type Union";
        dcterms:description  "\n  An rdf:List that can be used in property constraints as the type in an sh:or to indicate\n   that all values of a property must be an xsd date type.\n  " .

