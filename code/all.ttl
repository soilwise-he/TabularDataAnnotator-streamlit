unit:OHM  rdf:type                   qudt:DerivedUnit , qudt:Unit;
        rdfs:isDefinedBy             <http://qudt.org/$$QUDT_VERSION$$/vocab/unit>;
        rdfs:label                   "欧姆"@zh , "オーム"@ja , "ओह्म"@hi , "اهم"@fa , "أوم"@ar , "אוהם"@he , "Ом"@ru , "Ом"@bg , "Ωμ"@el , "Om"@pl , "Ohmium"@la , "Ohmio"@es , "Ohm"@tr , "Ohm"@sl , "Ohm"@ro , "Ohm"@pt , "Ohm"@ms , "Ohm"@it , "Ohm"@hu , "Ohm"@fr , "Ohm"@en , "Ohm"@de , "Ohm"@cs , "Ohm";
        dcterms:description          "\n  The $\\textit{ohm}$ is the SI derived unit of electrical resistance, named after German physicist Georg Simon Ohm. \n  \n  It is defined as:\n  \n  $$\\Omega \\equiv\\ \\frac{\\text{V}}{\\text{A}}\\ \\equiv\\ \\frac{\\text{volt}}{\\text{amp}}\\ \\equiv\\ \\frac{\\text{W}}{\\text {A}^{2}}\\ \\equiv\\ \\frac{\\text{watt}}{\\text{amp}^{2}}\\ \\equiv\\ \\frac{\\text{H}}{\\text {s}}\\ \\equiv\\ \\frac{\\text{henry}}{\\text{second}}$$\n  \n  "^^qudt:LatexString;
        qudt:applicableSystem        sou:CGS-EMU , sou:CGS-GAUSS , sou:PLANCK , sou:SI;
        qudt:conversionMultiplier    1.0;
        qudt:conversionMultiplierSN  1.0E0;
        qudt:dbpediaMatch            "http://dbpedia.org/resource/Ohm"^^xsd:anyURI;
        qudt:hasDimensionVector      qkdv:A0E-2L2I0M1H0T-3D0;
        qudt:hasFactorUnit           [ qudt:exponent  -1;
                                       qudt:hasUnit   unit:A
                                     ];
        qudt:hasFactorUnit           [ qudt:exponent  1;
                                       qudt:hasUnit   unit:V
                                     ];
        qudt:hasQuantityKind         quantitykind:Resistance , quantitykind:Impedance , quantitykind:ModulusOfImpedance , quantitykind:Reactance;
        qudt:hasReciprocalUnit       unit:S;
        qudt:iec61360Code            "0112/2///62720#UAA017";
        qudt:informativeReference    "http://en.wikipedia.org/wiki/Ohm?oldid=494685555"^^xsd:anyURI;
        qudt:omUnit                  <http://www.ontology-of-units-of-measure.org/resource/om-2/ohm>;
        qudt:siExactMatch            si-unit:ohm;
        qudt:siUnitsExpression       "V/A";
        qudt:symbol                  "Ω";
        qudt:ucumCode                "Ohm"^^qudt:UCUMcs;
        qudt:udunitsCode             "Ω";
        qudt:uneceCommonCode         "OHM";
        qudt:wikidataMatch           <http://www.wikidata.org/entity/Q47083> .

