qudt:protocolBuffersName
        rdf:type            owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label          "protocol buffers name";
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  qudt:id .

qudt:precision  rdf:type     owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "precision";
        rdfs:range           xsd:integer;
        dcterms:description  "\n  Precision is the number of digits used to perform a given computation.\n  The concepts of accuracy and precision are both closely related and often confused. \n  While the accuracy of a number x is given by the number of significant decimal (or other) digits to the right of the decimal point in x,\n   the precision of x is the total number of significant decimal (or other) digits.\n  For a given numeric data type, the value of type:precision (?p) is related to the values of type:maxMantissa (?M) and type:base (?b) by the formula \n  \n   ?p := log(?b, ?M) \n   \n  where log(a,y) = x iff y=a^x.\n  " , "\n  <p>Precision is the number of digits used to perform a given computation. \n  The concepts of accuracy and precision are both closely related and often confused. \n  While the accuracy of a number x is given by the number of significant decimal (or other) digits to the right of the decimal point in x,\n   the precision of x is the total number of significant decimal (or other) digits.\n  </p>\n  <p>For a given numeric data type, the value of type:precision (?p) is related to the values of type:maxMantissa (?M) and type:base (?b) by the formula:\n  </p>\n  <p>?p := log(?b, ?M)\n  </p>\n  <p>where log(a,y) = x iff y=a^x.\n  </p>\n  "^^rdf:HTML .

qudt:positiveDeltaLimit
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Positive delta limit";
        rdfs:range           xsd:string;
        dcterms:description  "A positive change limit between consecutive sample values for a parameter. The Positive Delta may be the encoded value or engineering units value depending on whether or not a Calibrator is defined."^^rdf:HTML .

qudt:pattern  rdf:type       owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "pattern";
        rdfs:range           xsd:string;
        dcterms:description  "A pattern is a constraint on the value space of a datatype which is achieved by constraining the lexical space to literals which match a specific pattern. The value of pattern must be a regular expression." .

qudt:padding  rdf:type    owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "padding" .

qudt:originDefinition
