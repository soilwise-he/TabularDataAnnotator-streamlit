qudt:ValidateQuantityHasUnitShape
        rdf:type             sh:NodeShape;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt>;
        rdfs:label           "Validate Quantity has Unit Shape";
        dcterms:description  "\n  <p>Specifies and checks an optional property for a quantified value.\n  </p>"^^rdf:HTML;
        sh:property          qudt:MaybeUnitPropertyShape , qudt:MaybeQuantityPropertyShape;
        sh:severity          sh:Warning;
        sh:sparql            [ sh:message   "Quantity \"{$this}\" must have a unit.";
                               sh:prefixes  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatypePrefixes>;
                               sh:select    "\n        SELECT $this\n        WHERE {\n             $this qudt:quantity ?quantity .\n             FILTER NOT EXISTS {?quantity qudt:hasUnit ?unit} \n             }\n        "
                             ];
        sh:targetClass       qudt:Vector , qudt:Quantity , qudt:List , qudt:Array .

