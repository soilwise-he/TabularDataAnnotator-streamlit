qudt:Coordinates-2D  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "2D Coordinate Type";
        rdfs:subClassOf      qudt:TwoTuple , qudt:CartesianCoordinates;
        dcterms:description  "\n  <p>A 2D coordinate system is a system for assigning a two-tuple of numbers or scalars to each point in an 2-dimensional space. \n  A corresponding 2D Coordinate Type is a data type that defines the data type for each coordinate (tuple member) in a 2D coordinate system.\n  </p>"^^rdf:HTML .

qudt:Coordinates  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Coordinate System Type" , "Coordinates";
        rdfs:subClassOf      qudt:Tuple;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:CoordinateMember;
                               owl:onProperty     qudt:datatype
                             ];
        dcterms:description  "\n  <p>A coordinate system is a mathematical structure for assigning a unique n-tuple of numbers or scalars to each point in an n-dimensional space. \n  A Coordinate System Type is a data type that defines the properties of data structures that represent coordinate systems.\n  </p>\n  <p>The primary attributes of any coordinate system are the coordinate frame or orientation of the axes of the coordinate system and the coordinate center or origin of the coordinate system.\n  The coordinate center is the easier of the two attributes to define and in trajectory-related coordinate systems is often taken to be the center of mass of natural solar system bodies such as the Earth, the Moon, or Mars.\n  Precise definition of the coordinate frame, however, usually takes much more effort. \n  As a result, the primary purpose is to provide a detailed description of a number of different coordinate frames commonly used in mission analysis.\n  </p>"^^rdf:HTML;
        sh:property          qudt:Coordinates-elementType .

qudt:CoordinateSystem
        rdf:type             owl:Class , rdfs:Class , sh:NodeShape;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Coordinate system";
        rdfs:seeAlso         <http://en.wikipedia.org/wiki/Astronomical_coordinate_systems> , <http://en.wikipedia.org/wiki/Coordinate_system> , <http://mathworld.wolfram.com/CoordinateSystem.html> , <http://mathworld.wolfram.com/Coordinates.html>;
        rdfs:subClassOf      qudt:Concept , skos:Concept;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      vaem:acronym
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:referenceFrame
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:originDefinition
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:coordinateCenter
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:abbreviation
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  xsd:string;
                               owl:onProperty     qudt:originDefinition
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:ReferenceFrame;
                               owl:onProperty     qudt:referenceFrame
                             ];
        dcterms:description  "\n  <p>\n  In geometry, a coordinate system is a system which uses one or more numbers, or coordinates,\n   to uniquely determine the position of a point or other geometric element on a manifold such as Euclidean space. \n  The order of the coordinates is significant.\n  They are sometimes identified by their position in an ordered tuple and sometimes by a letter, as in 'the x-coordinate'. \n  </p>\n  <p>In elementary mathematics the coordinates are taken to be real numbers, but may be complex numbers or elements of a more abstract system such as a commutative ring. \n  The use of a coordinate system allows problems in geometry to be translated into problems about numbers and vice versa; this is the basis of analytic geometry. \n  </p>\n  <p>In astronomy, a celestial coordinate system is a system for specifying positions of celestial objects: satellites, planets, stars, galaxies, and so on. \n  Coordinate systems can specify a position in 3-dimensional space, or merely the direction of the object on the celestial sphere, if its distance is not known or not important.\n  </p>\n  <p>The coordinate systems are implemented in either spherical coordinates or rectangular coordinates. \n  Spherical coordinates, projected on the celestial sphere, are analogous to the geographic coordinate system used on the surface of the Earth.\n  These differ in their choice of fundamental plane, which divides the celestial sphere into two equal hemispheres along a great circle.\n  </p>\n  <p>Rectangular coordinates, in appropriate units, are simply the cartesian equivalent of the spherical coordinates, with the same fundamental (x,y) plane and primary (x-axis) direction. \n  Each coordinate system is named for its choice of fundamental plane.\n  </p>"^^rdf:HTML , "\n  <p>A <em>Coordinate System</em> is a mathematical structure for assigning a unique n-tuple of numbers or scalars to each point in an n-dimensional space. \n  A Coordinate System Type is a data type that defines the properties of data structures that represent coordinate systems.\n  </p>\n  <p>In geometry, a coordinate system is a system which uses one or more numbers, or coordinates,\n   to uniquely determine the position of a point or other geometric element on a manifold such as Euclidean space. \n  The order of the coordinates is significant.\n  They are sometimes identified by their position in an ordered tuple and sometimes by a letter, as in 'the x-coordinate'. \n  </p>\n  <p>In elementary mathematics the coordinates are taken to be real numbers, but may be complex numbers or elements of a more abstract system such as a commutative ring. \n  The use of a coordinate system allows problems in geometry to be translated into problems about numbers and vice versa; this is the basis of analytic geometry. \n  </p>\n  <p>In astronomy, a celestial coordinate system is a system for specifying positions of celestial objects: satellites, planets, stars, galaxies, and so on. \n  Coordinate systems can specify a position in 3-dimensional space, or merely the direction of the object on the celestial sphere, if its distance is not known or not important.\n  </p>\n  <p>The coordinate systems are implemented in either spherical coordinates or rectangular coordinates. \n  Spherical coordinates, projected on the celestial sphere, are analogous to the geographic coordinate system used on the surface of the Earth.\n  These differ in their choice of fundamental plane, which divides the celestial sphere into two equal hemispheres along a great circle.\n  </p>\n  <p>Rectangular coordinates, in appropriate units, are simply the cartesian equivalent of the spherical coordinates, with the same fundamental (x,y) plane and primary (x-axis) direction. \n  Each coordinate system is named for its choice of fundamental plane.\n  </p>"^^rdf:HTML;
        qudt:dbpediaMatch    <http://dbpedia.org/resource/Coordinate_system>;
        sh:property          qudt:CoordinateSystem-referenceFrame , qudt:CoordinateSystem-abbreviation , qudt:CoordinateSystem-acronym , qudt:CoordinateSystem-coordinateCenter , qudt:CoordinateSystem-originDefinition .

qudt:CoordinateMember
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Coordinate Member";
        rdfs:subClassOf      qudt:TupleMember;
        dcterms:description  "\n  <p>A Coordinate Member Type is a data type that defines the properties of a coordinate in a coordinate system.\n  </p>"^^rdf:HTML , "\n  <p>A <em>Coordinate Member</em> is a data type that defines the properties of a coordinate in a coordinate system.\n  </p>"^^rdf:HTML .

qudt:CoordinateCenterKind
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Coordinate Center Kind";
        rdfs:subClassOf      qudt:NominalScale , qudt:EnumeratedValue;
        dcterms:description  "\n  <p>An enumeration of coordinate centers for coordinate systems, such as:\n   \"Earth centered\", \"Mars centered\", \"Moon centered\", \"Sun centered\",  and \"Vehicle centered\".\n  </p>"^^rdf:HTML;
        owl:oneOf            ( qudt.type:CC_MarsCentered qudt.type:CC_EarthCentered qudt.type:CC_MoonCentered qudt.type:CC_VehicleCentered qudt.type:CC_SunCentered );
        skos:prefLabel       "Coordinate center";
        sh:in                ( qudt:CCT_MarsCentered qudt:CCT_EarthCentered qudt:CCT_MoonCentered qudt:CCT_VehicleCentered qudt:CCT_SunCentered );
        sh:in                ( qudt:CCT_MarsCentered qudt:CCT_EarthCentered qudt:CCT_MoonCentered qudt:CCT_VehicleCentered qudt:CCT_SunCentered ) .

qudt:CartesianCoordinates
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Cartesian Coordinate Type";
        rdfs:subClassOf      qudt:Coordinates;
        dcterms:description  "\n  A set of  variables which fix a geometric object.\n  If the coordinates are distances measured along perpendicular axes, they are known as Cartesian coordinates.\n  " .

qudt:AxialOrientationType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Axial Orientation Type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "The axial orientation of a coordinate system frame axis.";
        owl:oneOf            ( qudt:PositiveZ qudt:PositiveY qudt:NegativeY qudt:NegativeZ qudt:PositiveX qudt:NegativeX );
        sh:in                ( qudt:PositiveZ qudt:PositiveY qudt:NegativeY qudt:NegativeZ qudt:PositiveX qudt:NegativeX );
        sh:in                ( qudt:PositiveZ qudt:PositiveY qudt:NegativeY qudt:NegativeZ qudt:PositiveX qudt:NegativeX ) .

qudt:AerospaceCoordinateSystem
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/coordinatesystems>;
        rdfs:label           "Aerospace coordinate system" , "Aerospace Coordinate system";
        rdfs:subClassOf      qudt:CoordinateSystem;
        dcterms:description  "A sub-type of 'Coordinate system'. Detailed description to be provided in a future version." , "A sub-type of 'Coordinate system'." .

