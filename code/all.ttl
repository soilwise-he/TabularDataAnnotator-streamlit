qudt:Konopliv2001  rdf:type  qudt:Citation;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype>;
        rdfs:label           "Konopliv2001";
        dcterms:description  "\n  <p>\"Recent Gravity Models as a Result of the Lunar Prospector Mission\", A. S. Konopliv, S. W. Asmar, E. Carranza, W. L. Sjogren,\n   and D. N. Yuan, Academic Press, Icarus 150, 1-18 (2001).\n  </p>"^^rdf:HTML .

