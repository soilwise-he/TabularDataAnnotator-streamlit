qudt:WetDryStateType  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Wet dry state type";
        rdfs:subClassOf   qudt:EnumeratedValue , qudt:DiscreteState .

qudt:VisualCue  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Visual Cue";
        rdfs:subClassOf   qudt:ModalCue .

qudt:Vector  rdf:type        rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Vector" , "Vector Type";
        rdfs:subClassOf      qudt:Array , qudt:CompositeDatatype;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:referenceFrame
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:dimensionality
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:ReferenceFrame;
                               owl:onProperty     qudt:referenceFrame
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:dimensions
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    1;
                               owl:onProperty  qudt:dimensionality
                             ];
        dcterms:description  "\n  <p>A <em>Vector</em> is an array data type that can have a dimensionality of one, or more elements.\n  Vectors can represent physical quantities, such as velocity, force, displacement;\n  mathematical objects such as points or directions in space;\n  and abstract representations for things such as colors, features, or embeddings in computational contexts.\n  </p>\n  <p>As a one-dimensional mathematical object it can represent a quantity with both magnitude and direction in space.\n  One-dimensional vectors can be thought of as a special case of a 1D array.\n  For example a 3D vector can be expressed as a list of coordinates: [x,y,z].\n  </p>\n  <p>\n  A vector in n-dimensional space can represent a point, a direction, or a linear combination of basis vectors.\n  </p>\n  <p>\n  Vectors can represent quantifiable values.\n  For example a car moving at 60 m/hr to the north, assuming north is along the y-axis, can be represented in 2D as:\n  </p>\n  <dl>\n  <dd>[0, 60]</dd>\n  </dl>\n  <p>\n  In machine learning a <em>Feature Vector</em> can be expressed for a dataset entry as:\n  <p>\n  <dl>\n  <dd>[5.1, 3.5, 1.4, 0.2]</dd>\n  </dl>\n  <p>\n  In AI for text processing a <em>Word Embedding Vector</em> is expressed as a N-dimensional space, where N can be a large number.\n  </p>\n  "^^rdf:HTML , "A Vector Type is a data type that specifies the properties of data structures that hold vectors.";
        sh:property          qudt:MaybeQuantityPropertyShape , qudt:QuantityKindsPropertyShape .

qudt:VariableLengthIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Variable Length Integer Type";
        rdfs:subClassOf      qudt:IntegerDatatype;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    64;
                               owl:onProperty  qudt:maxBits
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    1;
                               owl:onProperty  qudt:minBits
                             ];
        dcterms:description  "A Variable Length Integer data type defines a data structure for representing integers that uses a variable number of bits depending on the magnitude of the integer. Typically, variable length integer data types are between one and 64 bits in length." , "\n  A \"Variable Length Integer\" data type defines a data structure for representing integers that uses a variable number of bits depending on the magnitude of the integer. \n  Typically, variable length integer data types are between one and 64 bits in length.\n  ";
        sh:property          qudt:VariableLengthIntegerType-minBits , qudt:VariableLengthIntegerType-maxBits .

qudt:VariableIntervalTimeSeriesArrayType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "A Variable Interval Time Series Array Type is a data type that specifies the properties of arrays that hold time series data that has been sampled over non-uniformly spaced time intervals. A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals. For variable interval time series, the successive time intervals may follow a repeating pattern, or may be completely random.";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Variable Interval Time Series Array Type";
        rdfs:subClassOf      qudt:TimeSeriesArrayType;
        dcterms:description  "A Variable Interval Time Series Array Type is a data type that specifies the properties of arrays that hold time series data that has been sampled over non-uniformly spaced time intervals. A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals. For variable interval time series, the successive time intervals may follow a repeating pattern, or may be completely random." .

qudt:VariableIntervalTimeSeriesArray
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Variable Interval Time Series Array Type";
        rdfs:subClassOf      qudt:TimeSeriesArray;
        dcterms:description  "A Variable Interval Time Series Array Type is a data type that specifies the properties of arrays that hold time series data that has been sampled over non-uniformly spaced time intervals. A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals. For variable interval time series, the successive time intervals may follow a repeating pattern, or may be completely random." .

qudt:UnsignedVariableLengthIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Unsigned Variable Length Integer Type";
        rdfs:subClassOf      qudt:VariableLengthIntegerType , qudt:UnsignedIntegerType;
        dcterms:description  "An Unsigned Variable Length Integer data type defines a data structure for representing unsigned integers that uses a variable number of bits depending on the magnitude of the integer. Typically, variable length integer data types are between one and 64 bits in length." , "\n  An \"Unsigned Variable Length Integer\" data type defines a data structure for representing unsigned integers that uses a variable number of bits depending on the magnitude of the integer. \n  Typically, variable length integer data types are between one and 64 bits in length.\n  " .

qudt:UnsignedType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Unsigned Type";
        rdfs:subClassOf      qudt:NumericType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt:Unsigned;
                               owl:onProperty  qudt:signedness
                             ];
        dcterms:description  "An unsigned data type is a numeric type that does not distinguish between positive and negative values.";
        owl:disjointWith     qudt:SignedType;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:NumericType
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    qudt:Unsigned;
                                                       owl:onProperty  qudt:signedness
                                                     ]
                                                   )
                             ];
        sh:disjoint          qudt:SignedType;
        sh:property          qudt:UnsignedType-signedness .

qudt:UnsignedShortIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Unsigned Short Integer Type";
        rdfs:subClassOf      qudt:UnsignedIntegerType , qudt:ShortIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "UI16";
                               owl:onProperty  dtype:literal
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "2^{16}-1";
                               owl:onProperty  qudt:maxInclusive
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "0";
                               owl:onProperty  qudt:minInclusive
                             ];
        dcterms:description  "An Unsigned Short Integer is an unsigned integer that can be represented in four octets (32 bits) of machine memory.";
        sh:property          qudt:UnsignedShortIntegerType-minInclusive , qudt:UnsignedShortIntegerType-maxInclusive , qudt:UnsignedShortIntegerType-abbreviation .

qudt:UnsignedMediumIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Integer Type" , "Unsigned Medium Integer Type";
        rdfs:subClassOf      qudt:UnsignedIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    3;
                               owl:onProperty  qudt:bytes
                             ];
        dcterms:description  "An \"Unsigned Medium Integers\" is an integer of 24 bits that only takes on both positive values." , "\n  An \"Unsigned Medium Integer\" is an integer of 24 bits that only takes on both positive values.\n  ";
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:IntegerDatatype qudt:SignedType )
                             ] .

qudt:UnsignedLongIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Unsigned Long Integer Type";
        rdfs:subClassOf      qudt:UnsignedIntegerType , qudt:LongIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "UI32";
                               owl:onProperty  dtype:literal
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "2^{32}-1";
                               owl:onProperty  qudt:maxInclusive
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "0";
                               owl:onProperty  qudt:minInclusive
                             ];
        dcterms:description  "An Unsigned Long Integer is an unsigned integer that can be represented in four octets (32 bits) of machine memory.";
        sh:property          qudt:UnsignedLongIntegerType-minInclusive , qudt:UnsignedLongIntegerType-maxInclusive , qudt:UnsignedLongIntegerType-literal .

qudt:UnsignedIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Unsigned Integer Type";
        rdfs:subClassOf      qudt:UnsignedType , qudt:IntegerDatatype;
        dcterms:description  "Unsgned Integers are integers that are either strictly non-negative or non-positive.";
        owl:disjointWith     qudt:SignedIntegerType;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:IntegerDatatype qudt:UnsignedType )
                             ];
        sh:disjoint          qudt:SignedIntegerType .

qudt:UnsignedBigIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Unsigned Big Integer Type";
        rdfs:subClassOf      qudt:UnsignedIntegerType , qudt:BigIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "UI64";
                               owl:onProperty  dtype:literal
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "2^{64}-1";
                               owl:onProperty  qudt:maxInclusive
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "0";
                               owl:onProperty  qudt:minInclusive
                             ];
        dcterms:description  "An Unsgned Big Integer is an unsigned integer that can be represented in eight octets (64 bits) of machine memory.";
        sh:property          qudt:UnsignedBigIntegerType-minInclusive , qudt:UnsignedBigIntegerType-maxInclusive , qudt:UnsignedBigIntegerType-abbreviation .

qudt:TypeVector  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Type vector";
        rdfs:subClassOf      qudt:Vector;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:DataType;
                               owl:onProperty     qudt:datatype
                             ];
        dcterms:description  "\n  <p>A <em>Type Vector</em> is a vector whose elements are data types. \n  They are used to specify the type of each component of a vector or class of vectors. \n  </p>"^^rdf:HTML;
        sh:property          qudt:TypeVector-datatype .

qudt:TypeMatrix  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "\n  Members of this class are matrix data structures that describe the datatypes of a class of matrices. \n  That is, the members of this class are matrices with cells that contain datatypes (c.f. type:Datatype) and are used to describe the datatype structure of other matrices.\n  ";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Type matrix";
        rdfs:subClassOf      qudt:MatrixType , qudt:Matrix;
        dcterms:description  "Members of this class are matrix data structures that describe the datatypes of a class of matrices. That is, the members of this class are matrices with cells that contain datatypes (c.f. type:Datatype) and are used to describe the datatype structure of other matrices." .

qudt:TypeList  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Type list";
        rdfs:subClassOf      qudt:Datatype;
        dcterms:description  "\n  A sub-type of 'QUDT Datatype'. Detailed description to be provided in a future version.\n  " , "A sub-type of 'QUDT Datatype'." .

qudt:TwoTupleType  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Two-Tuple Type";
        rdfs:subClassOf      qudt:N-TupleType;
        dcterms:description  "A 2-tuple is called a pair. For example, a complex number can be represented as a 2-tuple, and 2D coordinates are sometimes represented as 2-tuples.";
        sh:property          qudt:Two-Tuple-elementTypeCount , qudt:Two-Tuple-elementType .

qudt:TwoTuple  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Two-Tuple Type" , "Two-Tuple";
        rdfs:subClassOf      qudt:N-Tuple;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    2;
                               owl:onProperty  qudt:elementTypeCount
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  2;
                               owl:onProperty   qudt:datatype
                             ];
        dcterms:description  "\n  A 2-tuple is called a pair. \n  For example, a complex number can be represented as a 2-tuple.\n  2D coordinates are sometimes represented as 2-tuples.\n  ";
        sh:property          qudt:TwoTuple-elementTypeCount , qudt:TwoTuple-elementType .

qudt:TupleType  rdf:type     sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Tuple Type";
        rdfs:subClassOf      qudt:CompositeDatatype;
        dcterms:description  "\n  <p><em>Tuple</em> originated as an abstraction of the sequence: single, double, triple, quadruple, quintuple, n-tuple.  \n  In mathematics, a tuple is a finite sequence (also known as an <em>Ordered List</em> of objects, each of a specified type. \n  The <em>n</em> can be any non-negative integer.\n  </p>\n  "^^rdf:HTML;
        sh:property          qudt:Tuple-length , qudt:Tuple-elementTypeCount , qudt:Tuple-elementType .

qudt:TupleMember  rdf:type   sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Tuple Member Type";
        rdfs:subClassOf      qudt:CompositeDatatype;
        dcterms:description  "\n  <p><em>Tuple Member</em> defines the properties of a member of a tuple. \n  It is used to provide fine grained type specification to the elements of tuples.\n  </p>\n  "^^rdf:HTML;
        sh:property          qudt:TupleMember-orderInStructure , qudt:TupleMember-elementType .

qudt:Tuple  rdf:type         owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Tuple Type" , "Tuple";
        rdfs:subClassOf      qudt:CompositeDatatype;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:length
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:elementTypeCount
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:TupleMember;
                               owl:onProperty     qudt:datatype
                             ];
        dcterms:description  "<p>The term <em>Tuple</em> originated as an abstraction of the sequence: single, double, triple, quadruple, quintuple, n-tuple.  In mathematics, a tuple is a finite sequence (also known as an <em>Ordered List</em> of objects, each of a specified type. The <em>n</em> can be any non-negative integer.</p>"^^rdf:HTML , "\n  <p>The term <em>Tuple</em> originated as an abstraction of the sequence: single, double, triple, quadruple, quintuple, n-tuple. \n  In mathematics, a tuple is a finite sequence (also known as an <em>Ordered List</em> of objects, each of a specified type. \n  The <em>n</em> can be any non-negative integer.\n  </p>"^^rdf:HTML;
        sh:property          qudt:Tuple-length , qudt:Tuple-elementTypeCount , qudt:Tuple-elementType .

qudt:Triplet  rdf:type       owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Triplet";
        rdfs:seeAlso         qudt:ThreeTuple;
        rdfs:subClassOf      qudt:ThreeTuple;
        dcterms:description  "A \"Tuple\".";
        owl:equivalentClass  qudt:ThreeTuple .

qudt:Tree  rdf:type           owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy      <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label            "Tree Type";
        rdfs:subClassOf       qudt:Graph;
        dcterms:description   "A \"Tree\" is a data type that defines the properties of data structures that represent trees. A tree is a graph data structure accessed beginning at the root node. Each node is either a leaf or an internal node. An internal node has one or more child nodes and is called the parent of its child nodes. Leaf nodes have no chidren. Nodes that share the same parent are siblings. In graph theoretic terminology, a tree is a connected, undirected, acyclic graph." , "\n  A \"Tree\" is a data type that defines the properties of data structures that represent trees. \n  Each node is either a leaf or an internal node. \n  An internal node has one or more child nodes and is called the parent of its child nodes. \n  Leaf nodes have no chidren. Nodes that share the same parent are siblings. \n  In graph theoretic terminology, a tree is a connected, undirected, acyclic graph.\n  ";
        prov:wasInfluencedBy  <http://en.wikipedia.org/wiki/Tree_(data_structure)> .

qudt:TimeStringType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Time Type";
        rdfs:subClassOf      qudt:TextStringType , qudt:DateTimeStringType;
        dcterms:description  "Time takes a number of forms, depending on the units used (e.g., year, day, minute, millisecond, or combinations thereof) and the origin (i.e., time zero) to which the time value is related." .

qudt:TimeSeriesArrayType
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Time Series Array Type";
        rdfs:subClassOf      qudt:ArrayType;
        dcterms:description  "\n  <p>A <em>Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data. \n  A time series is a sequence of data points, measured at successive time intervals. \n  The time intervals may be uniformly or non-uniformly spaced.\n  </p>\n  "^^rdf:HTML .

qudt:TimeSeriesArray  rdf:type  rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:comment         "\n  A Time Series Array is a data type that specifies the properties of arrays that hold time series data. \n  A time series is a sequence of data points, measured at successive time intervals. \n  The time intervals may be uniformly or non-uniformly spaced.\n  ";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Time Series Array" , "Time Series Array Type";
        rdfs:subClassOf      qudt:Array;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:vector
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:StateSpaceVector;
                               owl:onProperty     qudt:vector
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:TimeStringType;
                               owl:onProperty     <http://qudt.org/schema/type#incrementDatatype>
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:dimensions
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   <http://qudt.org/schema/type#incrementDatatype>
                             ];
        dcterms:description  "A Time Series Array Type is a data type that specifies the properties of arrays that hold time series data. A time series is a sequence of data points, measured at successive time intervals. The time intervals may be uniformly or non-uniformly spaced.";
        sh:property          qudt:TimeSeriesArray-incrementDatatype , qudt:TimeSeriesArray-vector .

qudt:TimeInterval  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "A relative interval that is an increment in time. \n  For example, this is used in time series arrays to express the time point of a vector of values.\n  ";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Time interval";
        rdfs:subClassOf      qudt:Parameter , qudt:Concept;
        dcterms:description  "A relative interval that is an increment in time. For example, this is used in time series arrays to express the time point of a vector of values.";
        sh:property          qudt:TimeInterval-type .

qudt:TimeDataType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Time data type";
        rdfs:subClassOf      qudt:ScalarDatatype , qudt:Enumeration;
        dcterms:description  "A sub-type of 'QUDT Enumeration'. Detailed description to be provided in a future version." , "A sub-type of 'QUDT Enumeration'.";
        dtype:value          qudt:TIME .

qudt:Time  rdf:type          owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "The class of data values that denote a point in time. Time values may be encoded in a 12-hour clock or a 24-hour clock, such as 1:35 AM, or 13:35.";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Time";
        rdfs:subClassOf      qudt:Scalar , qudt:ScalarDatatype;
        dcterms:description  "The class of data values that denote a point in time. Time values may be encoded in a 12-hour clock or a 24-hour clock, such as 1:35 AM, or 13:35.";
        sh:property          qudt:Time-type .

qudt:ThreeTuple  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Three-Tuple Type" , "Three-Tuple";
        rdfs:subClassOf      qudt:N-TupleType , qudt:N-Tuple;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    3;
                               owl:onProperty  qudt:elementTypeCount
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  3;
                               owl:onProperty   qudt:datatype
                             ];
        dcterms:description  "A three-tuple is a tuple with exactly three members. A Three-Tuple Type is a data type that defines the type properties of a class of three-tuples and their members." , "\n  A three-tuple is a tuple with exactly three members. \n  A Three-Tuple Type is a data type that defines the type properties of a class of three-tuples and their members.\n  ";
        sh:property          qudt:ThreeTuple-elementTypeCount , qudt:ThreeTuple-elementType .

qudt:TextStringType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Text String Type";
        rdfs:subClassOf      qudt:StringType;
        dcterms:description  "A text string. Encodings can be specified as subclass or in connection to character arrays in Structured Datatypes." , "\n  A <em>Text String Type</em> has encodings that are specified in subclasses or in connection to character arrays in <em>Structured Datatypes</em>.\n  " .

qudt:TaggedEnumeration
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Tagged Enumeration";
        rdfs:subClassOf      qudt:Enumeration;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   dtype:code
                             ];
        dcterms:description  "An enumeration where each literal  has a tag that is a non-negative integer. These enumerations are likely to have their literals encoded - hence the need for the tag.";
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:Enumeration
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  1;
                                                       owl:onProperty   dtype:code
                                                     ]
                                                   )
                             ];
        sh:property          qudt:TaggedEnumeration-code .

qudt:Table  rdf:type         rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Table Type";
        rdfs:subClassOf      qudt:StructuredDatatype , qudt:Array;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:byRow
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    2;
                               owl:onProperty  qudt:dimensionality
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:rows
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:columns
                             ];
        dcterms:description  "\n  A Table Type is a data type that specifies the properties of table data structures. \n  A table is both a mode of visual communication and a means of arranging data. \n  The precise conventions and terminology for describing tables varies depending on the context. \n  Moreover, tables differ significantly in variety, structure, flexibility, notation, representation and use.\n  " , "A Table Type is a data type that specifies the properties of table data structures. A table is both a mode of visual communication and a means of arranging data. The use of tables is pervasive throughout NASA The precise conventions and terminology for describing tables varies depending on the context. Moreover, tables differ significantly in variety, structure, flexibility, notation, representation and use.";
        sh:property          qudt:DimensionsPropertyShape , qudt:Table-byRow , qudt:Table-columns , qudt:Table-dimensionality , qudt:Table-rows .

qudt:StructuredDatatype
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Structured Data Type";
        rdfs:subClassOf      qudt:Datatype;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:datatype
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Datatype;
                               owl:onProperty     qudt:datatype
                             ];
        dcterms:description  "\n  <p>A <em>Structured Datatype</em>, in contrast to a scalar data type, is used to characterize classes of complex data structures.\n  Examples are collections, linked and indexed lists, trees, ordered trees, and multi-dimensional file formats.\n  </p>"^^rdf:HTML;
        sh:property          qudt:StructuredDatatype-elementType .

qudt:StringUTF8  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "String UTF8 Type";
        rdfs:subClassOf      qudt:TextStringType , qudt:StringType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt:UTF8-CHAR;
                               owl:onProperty  qudt:datatype
                             ];
        dcterms:description  "String UTF-8 Type is a string data type that specifies the properties of string data structures which encode strings using the UTF-8 encoding. UTF-8 includes ASCII, otherwise referred to as IA-5 (International Alphabet 5, as standardized by International Organization for Standardization [ISO]) as the first 128 values. The Internet Engineering Task Force (IETF) requires all Internet protocols to identify the encoding used for character data with UTF-8 as at least one supported encoding. The Internet Mail Consortium (IMC) recommends that all e-mail programs must be able to display and create mail using UTF-8." , "\n  String UTF-8 Type is a string data type that specifies the properties of string data structures which encode strings using the UTF-8 encoding. \n  UTF-8 includes ASCII, otherwise referred to as IA-5 (International Alphabet 5, as standardized by International Organization for Standardization [ISO]) as the first 128 values. \n  The Internet Engineering Task Force (IETF) requires all Internet protocols to identify the encoding used for character data with UTF-8 as at least one supported encoding. \n  The Internet Mail Consortium (IMC) recommends that all e-mail programs must be able to display and create mail using UTF-8.\n  ";
        vaem:isElaboratedIn  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        sh:property          qudt:StringUTF8-memberDatatype .

qudt:StringUTF16  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "String UTF16 Type" , "String UTF16";
        rdfs:subClassOf      qudt:TextStringType , qudt:StringType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt:UTF16-CHAR;
                               owl:onProperty  qudt:datatype
                             ];
        dcterms:description  "String UTF-16 Type is a string data type that specifies the properties of string data structures which encode strings using the UTF-16 encoding. UTF-16 is the native internal representation of text in the Microsoft Windows NT/Windows 2000/Windows XP/Windows CE, Qualcomm BREW, and Symbian operating systems; the Java and .NET byte code environments; Mac OS X's Cocoa and Core Foundation frameworks; and the Qt cross-platform graphical widget toolkit." , "\n  <p><em>String UTF-16</em> is a string data type that specifies the properties of string data structures which encode strings using the UTF-16 encoding. \n  UTF-16 is the native internal representation of text in many software systems, for example:\n  </p>\n  <ol>\n  <li>Microsoft Windows NT/Windows 2000/Windows XP/Windows CE;</li>\n  <li>Qualcomm BREW, and Symbian operating systems;</li>\n  <li>the Java and .NET byte code environments;</li>\n  <li>Mac OS X's Cocoa and Core Foundation frameworks;</li>\n  <li>Qt cross-platform graphical widget toolkit.</li>\n  </ol>\n  "^^rdf:HTML;
        sh:property          qudt:StringUTF16-memberDatatype .

qudt:StringType  rdf:type    rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "String Type";
        rdfs:subClassOf      qudt:ScalarDatatype , qudt:Array;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                               owl:onProperty      qudt:isByteString
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:maxLength
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    1;
                               owl:onProperty  qudt:dimensionality
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  0;
                               owl:onProperty   qudt:typeMatrix
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:CharacterType;
                               owl:onProperty     qudt:datatype
                             ];
        dcterms:description  "\n  <p>A <em>String Type</em> is a data type that specifies the properties of a list structure that holds characters.\n  </p>\n  "^^rdf:HTML , "A String Type is a data type that specifies the properties of data structures that hold strings. ";
        sh:property          qudt:StringType-dimensionality , qudt:StringType-isByteString , qudt:StringType-maxLength , qudt:StringType-memberDatatype , qudt:StringType-typeMatrix .

qudt:StringEncodingType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "String Encoding Type";
        rdfs:subClassOf      qudt:Encoding;
        dcterms:description  "\n  An \"Encoding\" with the following instance(s): \"qudt:UTF8-StringEncoding\", qudt:UTF16-StringEncoding\".\n  " , "\n  An \"Encoding\" with the following instance(s): \"qudt:UTF8-StringEncoding\", \"qudt:UTF16-StringEncoding\".\n  " , "\n  <p><em>String Encoding Type</em> is an \"Encoding\" with the following instance(s):\n   \"UTF-16 String\", \"UTF-8 Encoding\".\n   </p>\n  "^^rdf:HTML .

qudt:StateSpaceMatrix
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "State Space Matrix Type";
        rdfs:subClassOf      qudt:Matrix;
        dcterms:description  "In control engineering, a state space representation is a mathematical model of a physical system as a set of input, output and state variables related by first-order differential equations. To abstract from the number of inputs, outputs and states, the variables are expressed as vectors and the differential and algebraic equations are written in matrix form (the last one can be done when the dynamical system is linear and time invariant). " , "\n  <p>In control engineering, a state space representation is a mathematical model of a physical system\n   as a set of input, output and state variables related by first-order differential equations. \n  To abstract from the number of inputs, outputs and states, the variables are expressed as vectors.\n  The differential and algebraic equations are written in matrix form (the last one can be done when the dynamical system is linear and time invariant).\n  </p>"^^rdf:HTML .

qudt:SplinePoint  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Spline point";
        rdfs:subClassOf      qudt:Tuple;
        dcterms:description  "A sub-type of 'Tuple Type'. Detailed description to be provided in a future version." , "A sub-type of 'Tuple Type'." .

qudt:SplineCalibrator
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Spline calibrator";
        rdfs:subClassOf      qudt:Map;
        dcterms:description  "A sub-type of 'Map Type'. Detailed description to be provided in a future version." , "A sub-type of 'Map Type'." .

qudt:SinglePrecisionType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Single Precision Type";
        rdfs:subClassOf      qudt:NumericType;
        dcterms:description  "A single precision data type specifies how a numeric value, such as an integer or real number, is stored in memory that occupies one word in computer memory, where the byte length of a word depends on machine address size of the computer processor. For example, on 32-bit machine architectures, a word is four bytes, and so a single precision data value on a 32-bit machine architecture occupies four bytes of memory." , "\n  A single precision data type specifies how a numeric value, such as an integer or real number,\n   is stored in memory that occupies one word in computer memory,\n   where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes.\n  A single precision data value on a 32-bit machine architecture occupies four bytes of memory.\n  " .

qudt:SignednessType  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Signedness type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "Specifics whether a value should be signed or unsigned.";
        sh:property          [ rdf:type          sh:PropertyShape;
                               rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                               sh:in             ( qudt:Signed qudt:Unsigned );
                               sh:path           [ sh:inversePath  rdf:type ]
                             ] .

qudt:SignedVariableLengthIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Variable Length Integer Type";
        rdfs:subClassOf      qudt:VariableLengthIntegerType , qudt:SignedIntegerType;
        dcterms:description  "A Signed Variable Length Integer data type defines a data structure for representing signed integers that uses a variable number of bits depending on the magnitude of the integer. Typically, variable length integer data types are between one and 64 bits in length." .

qudt:SignedType  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Type";
        rdfs:subClassOf      qudt:NumericType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    qudt:Signed;
                               owl:onProperty  qudt:signedness
                             ];
        dcterms:description  "A signed type is a numeric type that distinguishes between positive and negative numbers using an encoding scheme, such as sign and magnitude, one's compliment, and two's compliment to represent negative numbers.";
        owl:disjointWith     qudt:UnsignedType;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:NumericType
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    qudt:Signed;
                                                       owl:onProperty  qudt:signedness
                                                     ]
                                                   )
                             ];
        sh:disjoint          qudt:UnsignedType;
        sh:property          qudt:SignedType-signedness .

qudt:SignedShortIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Short Integer Type";
        rdfs:subClassOf      qudt:SignedIntegerType , qudt:ShortIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "SI16";
                               owl:onProperty  dtype:literal
                             ];
        dcterms:description  "A Signed Short Integer is a signed integer that can be represented in four octets (32 bits) of machine memory.";
        sh:property          qudt:SignedShortIntegerType-abbreviation .

qudt:SignedMediumIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Integer Type";
        rdfs:subClassOf      qudt:SignedIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    3;
                               owl:onProperty  qudt:bytes
                             ];
        dcterms:description  "A \"Signed Medium Integers\" is an integer of 24 bits that can take on both positive and negative values." , "\n  A \"Signed Medium Integers\" is an integer of 24 bits that can take on both positive and negative values.\n  ";
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:IntegerDatatype qudt:SignedType
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    3;
                                                       owl:onProperty  qudt:bytes
                                                     ]
                                                   )
                             ] .

qudt:SignedLongIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Long Integer Type";
        rdfs:subClassOf      qudt:SignedIntegerType , qudt:LongIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "UI32";
                               owl:onProperty  dtype:literal
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "2^{31}-1";
                               owl:onProperty  qudt:maxInclusive
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "-2^{31}";
                               owl:onProperty  qudt:minInclusive
                             ];
        dcterms:description  "A Signed Long Integer is a signed integer that can be represented in four octets (32 bits) of machine memory.";
        sh:property          qudt:SignedLongIntegerType-minInclusive , qudt:SignedLongIntegerType-maxInclusive , qudt:SignedLongIntegerType-abbreviation .

qudt:SignedIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Integer Type";
        rdfs:subClassOf      qudt:SignedType , qudt:IntegerDatatype;
        dcterms:description  "Signed Integers are integers can take on both positive and negative values.";
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:IntegerDatatype qudt:SignedType )
                             ] .

qudt:SignedBigIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Signed Big Integer Type";
        rdfs:subClassOf      qudt:SignedIntegerType , qudt:BigIntegerType;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "SI64";
                               owl:onProperty  dtype:literal
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "2^{63}-1";
                               owl:onProperty  qudt:maxInclusive
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    "-2^{63}";
                               owl:onProperty  qudt:minInclusive
                             ];
        dcterms:description  "A Signed Big Integer is a signed integer that can be represented in eight octets (64 bits) of machine memory.";
        sh:property          qudt:SignedBigIntegerType-minInclusive , qudt:SignedBigIntegerType-maxInclusive , qudt:SignedBigIntegerType-literal .

qudt:ShortIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Short Integer Type";
        rdfs:subClassOf      qudt:IntegerDatatype;
        dcterms:description  "A Short Integer is an integer that can be represented in two octets (16 bits) of machine memory. Short integers may be signed or unsigned." , "\n  A Short Integer is an integer that can be represented in two octets (16 bits) of machine memory. \n  Short integers may be signed or unsigned.\n  " .

qudt:Set  rdf:type           owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Set Type";
        rdfs:subClassOf      qudt:Collection;
        dcterms:description  "A Set Type is an abstract data type that defines the properties of sets. A set is a collection (container) of certain values, without any particular order, and no repeated values. It corresponds with a finite set in mathematics." , "\n  <p>A <em>Set</em> is an abstract data type that defines the properties of sets. \n  A set is a collection (container) of certain values, without any particular order, and no repeated values. \n  It corresponds with a finite set in mathematics.\n  </p>\n  "^^rdf:HTML .

qudt:Sequence  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Sequence";
        rdfs:subClassOf      qudt:Collection;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Sequence;
                               owl:onProperty     rdf:rest
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Datatype;
                               owl:onProperty     rdf:first
                             ];
        dcterms:description  "A \"Structured Datatype\"." , "\n  <p>A <em>Sequence</em> is an enumerated collection of objects in which repetitions are allowed. \n  Like a set, it contains members (also called elements, or terms). \n  The number of elements (possibly infinite) is called the length of the sequence.\n  </p>\n  <p>Unlike a set, order matters, and exactly the same elements can appear multiple times at different positions in the sequence. \n  Formally, a sequence can be defined as a function whose domain is either the set of the natural numbers (for infinite sequences) or the set of the first n natural numbers (for a sequence of finite length n). \n  </p>\n  <p>The position of an element in a sequence is its rank or index; it is the integer from which the element is the image. \n  It depends on the context or of a specific convention, if the first element has index 0 or 1. [Wikipedia]\n  </p>\n  "^^rdf:HTML .

qudt:ScalarListShape  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:subClassOf   rdf:List;
        sh:property       [ sh:or    ( [ sh:node  ()
                                       ]
                                       [ sh:node  qudt:ScalarListShape ]
                                     );
                            sh:path  rdf:rest
                          ];
        sh:property       [ sh:or    qudt:NumericTypeUnion;
                            sh:path  rdf:first
                          ] .

qudt:Record  rdf:type        owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Record Type";
        rdfs:subClassOf      qudt:CompositeDatatype;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  <http://qudt.org/schema/type#FieldTypeList>;
                               owl:onProperty     qudt:elementTypeList
                             ];
        dcterms:description  "A Record Type is a type whose values are records, i.e. aggregates of several items of possibly different types. The aggregated items are called fields or members and are usually identified or indexed by field labels." , "\n  A Record Type is a type whose values are records, i.e. aggregates of several items of possibly different types. \n  The aggregated items are called fields or members and are usually identified or indexed by field labels.\n  " .

qudt:RealSinglePrecisionType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Real Single Precision Type";
        rdfs:subClassOf      qudt:SinglePrecisionType , qudt:RealDatatype;
        dcterms:description  "\n  <p>A real single precision data type specifies how a real number, or an approximation of a real number is stored in memory that occupies one word in computer memory, where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes. \n  An example of a real single precisoin data type specification is the IEEE 754 standard for encoding binary or decimal floating point numbers in 4 bytes for storage on 32-bit machine architectures.\n  </p>"^^rdf:HTML , "\n  <p>A real single precision data type specifies how a real number,\n   or an approximation of a real number is stored in memory that occupies one word in computer memory, \n   where the byte length of a word depends on machine address size of the computer processor.\n  </p>\n  <p> \n  For example, on 32-bit machine architectures, a word is four bytes. \n  An example of a real single precision data type specification is the IEEE 754 standard for encoding binary\n   or decimal floating point numbers in 4 bytes for storage on 32-bit machine architectures.\n  </p>\n  "^^rdf:HTML;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:RealDatatype qudt:SinglePrecisionType )
                             ] .

qudt:RealNumberType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "\n  <p>A <em>Real Number Type</em> is the class of data values that approximate real numbers in finite precision. \n  Often, such values are expressed in \"mantissa, base, exponent\" form. \n  Any rational number can be expressed in the form m*b^<sup>e</sup>, where m (the mantissa), b (the base), and e (the exponent) are integers. \n  Typically, b is chosen to be either 2 or 10, and then the values of m and e are determined given the choice of base.\n  </p>\n  "^^rdf:HTML;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Real number type";
        rdfs:subClassOf      qudt:RealDatatype;
        dcterms:description  "\n  <p>\"Real Number Type\" is the class of data values that approximate real numbers in finite precision. \n  Often, such values are expressed in \"mantissa, base, exponent\" form. \n  Any rational number can be expressed in the form m*b^<sup>e</sup>, where m (the mantissa), b (the base), and e (the exponent) are integers. \n  Typically, b is chosen to be either 2 or 10, and then the values of m and e are determined given the choice of base.\n  </p>"^^rdf:HTML .

qudt:RealDoublePrecisionType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Real Double Precision Type";
        rdfs:subClassOf      qudt:RealDatatype , qudt:DoublePrecisionType;
        dcterms:description  "\n  <p>A real double precision data type specifies how a real number, or an approximation of a real number is stored in memory that occupies two words in computer memory, where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes.\n  An example of a real double precision data type specification is the IEEE 754 standard for encoding binary or decimal floating point numbers in 8 bytes for storage on 32-bit machine architectures.\n  </p>"^^rdf:HTML , "\n  <p>A real double precision data type specifies how a real number, or an approximation of a real number is stored in memory.\n  Typically this occupies two words in computer memory, where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes.\n  An example of a real double precision data type specification is the IEEE 754 standard for encoding binary or decimal floating point numbers in 8 bytes for storage on 32-bit machine architectures.\n  </p>"^^rdf:HTML;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:RealDatatype qudt:DoublePrecisionType )
                             ] .

qudt:RealDatatype  rdf:type  rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Real Datatype";
        rdfs:subClassOf      qudt:NumericType;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:precision
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:base
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:maxExponent
                             ];
        dcterms:description  "\n  <p>A real number is represented as a factor, called the mantissa, multiplied by a power (the exponent) of a base. \n  Different bases yield different approximations to real numbers, and conversion between them is limited in accuracy.\n  Four floating-point types are defined in 'IEEE-754 Standard for Binary Floating-Point'. \n  These types are 'single', 'extended single', 'double', and 'extended double'.\n  </p>\n  "^^rdf:HTML , "\n  <p>A real number is represented as a factor, called the mantissa, multiplied by a power (the exponent) of a base. \n  Different bases yield different approximations to real numbers, and conversion between them is limited in accuracy.\n  Four floating-point types are defined in 'IEEE-754 Standard for Binary Floating-Point'. \n  These types are 'single', 'extended single', 'double', and 'extended double'.\n  </p>"^^rdf:HTML;
        sh:property          qudt:RealDatatype-base , qudt:RealDatatype-maxExponent , qudt:RealDatatype-maxMantissa , qudt:RealDatatype-minMantissa , qudt:RealDatatype-precision .

qudt:RawValueTupleMemberType
        rdf:type          sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Raw value tuple member type";
        rdfs:subClassOf   qudt:TupleMember;
        sh:property       qudt:RawValueTupleMember-elementType .

qudt:RawValueTupleMember
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Raw value tuple member";
        rdfs:subClassOf      qudt:TupleMember;
        dcterms:description  "A sub-type of 'Tuple Member Type'.";
        sh:property          qudt:RawValueTupleMember-elementType .

qudt:QuantityValueType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Quantity value type";
        rdfs:subClassOf      qudt:DimensionalDatatype;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Unit;
                               owl:onProperty     qudt:elementUnit
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:QuantityType;
                               owl:onProperty     qudt:basis
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:NumericType;
                               owl:onProperty     qudt:datatype
                             ];
        dcterms:description  "A sub-type of 'Dimensional Data Type'. Detailed description to be provided in a future version." , "A sub-type of 'Dimensional Data Type'.";
        sh:property          qudt:QuantityValueType-elementUnit , qudt:QuantityValueType-elementType , qudt:QuantityValueType-basis .

qudt:QuantityKindList
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Quantity kind List";
        rdfs:subClassOf      rdf:List;
        dcterms:description  "\n  <p>A <em>Quantity Kind List</em> is a list of qudt:QuantityKind. \n  They are used, for instance, to specify the quantity kind in a Mass Properties Array. \n  </p>\n  "^^rdf:HTML;
        sh:property          [ sh:or    ( [ sh:node  ()
                                          ]
                                          [ sh:node  qudt:QuantityKindList ]
                                        );
                               sh:path  rdf:rest
                             ];
        sh:property          [ sh:class  qudt:QuantityKind;
                               sh:path   rdf:first
                             ] .

qudt:PositiveIntegerType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Positive Integer Type";
        rdfs:subClassOf      qudt:UnsignedType , qudt:IntegerDatatype;
        dcterms:description  "Positive Integers are integers that are either non-zero and non-negative.";
        owl:disjointWith     qudt:SignedIntegerType;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( qudt:IntegerDatatype qudt:UnsignedType )
                             ];
        sh:disjoint          qudt:SignedIntegerType .

qudt:PositiveBigIntegerType
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Positive Big Integer Type";
        rdfs:subClassOf      qudt:UnsignedType , qudt:IntegerDatatype;
        dcterms:description  "Positive Integers are integers that are either non-zero and non-negative.";
        sh:disjoint          qudt:SignedIntegerType .

qudt:Polarity  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Polarity";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "A \"Tagged Enumeration\" with the following instance(s): \"negative\", \"positive\"." , "\n  A \"Tagged Enumeration\" with the following instance(s): \"negative\", \"positive\".\n  " .

qudt:PhysicalAddress  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Physical Address Type";
        rdfs:subClassOf      qudt:CompositeDatatype;
        dcterms:description  "A physical address is a pointer to a memory location." .

qudt:PartialArray  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Partial Array";
        rdfs:subClassOf      qudt:Array;
        dcterms:description  "\n  A partial array is an Array with two attributes that define the starting and ending indices of the elements that are provided.\n  "^^rdf:HTML .

qudt:ParameterModifiabilityType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "An enumeration of literals that signify whether a parameter is modifiable and if so, by whom.";
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Parameter modifiability type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "An enumeration of literals that signify whether a parameter is modifiable and if so, by whom." .

qudt:PaddingType  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Padding type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "\n  <p>This describes how unused bits of a field are filled. \n  Unused bits could be set to one or zero. \n  A third option is \"don't care\".\n  </p>"^^rdf:HTML;
        owl:oneOf            ( qudt:PadWithOnes qudt:PadWithZeros qudt:PadWithAny );
        sh:in                ( qudt:PadWithOnes qudt:PadWithZeros qudt:PadWithAny ) .

qudt:OrdinalType  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Ordinal Data Type";
        rdfs:subClassOf      qudt:ScalarDatatype;
        dcterms:description  "\n  <p>An ordinal data type is a data type that specifies the properties of values that can easily be put in a one to one correspondence with a subset of the natural numbers. \n  Examples include boolean, character, and integer data types.\n   </p>"^^rdf:HTML , "\n  <p>An ordinal data type is a data type that specifies the properties of values that can easily be put in a one to one correspondence with a subset of the natural numbers. \n  Examples include boolean, character, and integer data types.\n  </p>"^^rdf:HTML .

qudt:OrderedType  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Ordered type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  "1"^^xsd:int;
                               owl:onProperty      dtype:literal
                             ];
        dcterms:description  "Describes how a data or information structure is ordered.";
        owl:oneOf            ( qudt:Unordered qudt:PartiallyOrdered qudt:TotallyOrdered );
        sh:property          qudt:OrderedType-literal;
        sh:property          [ rdf:type          sh:PropertyShape;
                               rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                               sh:in             ( qudt:Unordered qudt:PartiallyOrdered qudt:TotallyOrdered );
                               sh:path           [ sh:inversePath  rdf:type ]
                             ] .

qudt:OrderedTree  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Ordered Tree Type";
        rdfs:subClassOf      qudt:Tree , qudt:OrderedCollection;
        dcterms:description  "\n  <p>An \"Ordered Tree Type\" is a data type that defines the properties of data structures that represent ordered trees. \n  An ordered tree is a tree where the children of every node are ordered, that is, there is a first child, second child, third child, etc. \n  Typically a type specification for an ordered tree will include the comparison operator (such as <b>lt</b> or <b>gt</b>) that is used to order the nodes.\n  </p>"^^rdf:HTML .

qudt:OrderedCollection
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Ordered Collection Type" , "Ordered Collection Kind";
        rdfs:subClassOf      qudt:Collection;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  dtype:ComparisonOperator;
                               owl:onProperty     qudt:orderingRelation
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:OrderedCollection;
                               owl:onProperty     rdf:rest
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Datatype;
                               owl:onProperty     rdf:first
                             ];
        dcterms:description  "\n  <p>An <em>Ordered Collection Type</em> is an abstract data type that defines the properties of collection data structures whose members can be linearly ordered. \n  An ordered collection is a collection together with an ordering relation (such as greater than) that linearly orders the collection elements.\n  </p>"^^rdf:HTML , "\n  <p>An <em>Ordered Collection Kind</em> is an abstract data type that defines the properties of collection data structures whose members can be linearly ordered. \n  An ordered collection is a collection together with an ordering relation (such as greater than) that linearly orders the collection elements.\n  </p>"^^rdf:HTML;
        sh:property          qudt:OrderedCollection-orderingRelation .

qudt:OnOffStateTypeEnumeration
        rdf:type          sh:NodeShape , rdfs:Class;
        rdfs:comment      "\n  A discrete state enumeration whose values are 'off' and 'on'. \n  The 'on' value is encoded as a zero (0) and the 'off' value as a one (1).\n  ";
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:subClassOf   qudt:Enumeration;
        qudt:inverted     true .

qudt:OnOffStateType  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "On off state type";
        rdfs:subClassOf   qudt:DiscreteState .

qudt:OffOnStateTypeEnumeration
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:subClassOf      qudt:Enumeration;
        dcterms:description  "\n  A discrete state enumeration whose values are 'off' and 'on'. \n  The 'off' value is encoded as a zero (0) and the 'on' value as a one (1).\n  " .

qudt:OctetType  rdf:type     owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Octet Type";
        rdfs:subClassOf      qudt:UnsignedIntegerType;
        dcterms:description  "An 8 bit unsigned integer" .

qudt:NumericType  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Numeric Type";
        rdfs:subClassOf      qudt:ScalarDatatype;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:signedness
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:accuracy
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:SignednessType;
                               owl:onProperty     qudt:signedness
                             ];
        dcterms:description  "Numeric data types are data types whose values denote quantities as defined by a mathematical number system.";
        sh:property          qudt:NumericType-signedness , qudt:NumericType-accuracy .

qudt:N-TupleType  rdf:type   sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "N-Tuple Type";
        rdfs:subClassOf      qudt:Tuple;
        dcterms:description  "\n  A tuple containing n objects is known as an \"n-tuple\". \n  For example the 4-tuple (or \"quadruple\"), with components of respective types PERSON, DAY, MONTH and YEAR.\n  This could be used to record that a certain person was born on a certain day of a certain month of a certain year.\n  ";
        sh:property          qudt:N-Tuple-elementType .

qudt:N-Tuple  rdf:type       owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "N-Tuple Type";
        rdfs:subClassOf      qudt:Tuple;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  1;
                               owl:onProperty      qudt:datatype
                             ];
        dcterms:description  "\n  A tuple containing n objects is known as an \"n-tuple\". \n  For example the 4-tuple (or \"quadruple\"), with components of respective types: PERSON, DAY, MONTH and YEAR,\n   could be used to record that a certain person was born on a certain day of a certain month of a certain year.\n  " , "\n  A tuple containing n objects is known as an \"n-tuple\". \n  For example the 4-tuple (or \"quadruple\"), with components of respective types PERSON, DAY, MONTH and YEAR.\n  This could be used to record that a certain person was born on a certain day of a certain month of a certain year.\n  ";
        sh:property          qudt:N-Tuple-elementType .

qudt:MultiSet  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Bag";
        rdfs:subClassOf      qudt:Collection;
        dcterms:description  "A bag is a set in which elements may be repeated." .

qudt:MultiModalType  rdf:type  rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Multi Modal Type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:onProperty      qudt:modalCue;
                               owl:someValuesFrom  <http://qudt.org/schema/ModalCue>
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:visualCue
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:kinestheticCue
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:iconicCue
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  <http://qudt.org/schema/ModalCue>;
                               owl:onProperty     qudt:modalCue
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:auralCue
                             ];
        dcterms:description  "A sub-type of 'Enumerated Value'." , "A sub-type of 'Enumerated Value'. Detailed description to be provided in a future version.";
        sh:property          qudt:MultiModalType-auralCue , qudt:MultiModalType-iconicCue , qudt:MultiModalType-kinestheticCue , qudt:MultiModalType-modalCue , qudt:MultiModalType-visualCue .

qudt:MultiModalEnumeration
        rdf:type             rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Multi modal enumeration";
        rdfs:subClassOf      qudt:Enumeration;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:visualCueEnumeration
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:kinestheticCueEnumeration
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:iconicCueEnumeration
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:ModalEnumeration;
                               owl:onProperty     qudt:modalCueEnumeration
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:auralCueEnumeration
                             ];
        dcterms:description  "A sub-type of 'QUDT Enumeration'." , "A sub-type of 'QUDT Enumeration'. Detailed description to be provided in a future version.";
        sh:property          qudt:MultiModalEnumeration-auralCueEnumeration , qudt:MultiModalEnumeration-iconicCueEnumeration , qudt:MultiModalEnumeration-kinestheticCueEnumeration , qudt:MultiModalEnumeration-modalCueEnumeration , qudt:MultiModalEnumeration-visualCueEnumeration .

qudt:MultiDimensionalDataFormat
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Multi dimensional data format";
        rdfs:subClassOf      qudt:CompositeDatatype;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   <http://qudt.org/schema/type#descriptor>
                             ];
        dcterms:description  "Data formats for storing and manipulating scalar and multidimensional data in a platform and discipline independent manner, for example HDF, CDF and netCDF." , "\n  Data formats for storing and manipulating scalar and multidimensional data in a platform and discipline independent manner,\n   for example HDF, CDF and netCDF.\n  ";
        sh:property          qudt:MultiDimensionalDataFormat-descriptor .

qudt:MultiDimensionalArray
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Multi Dimensional Array Type" , "Multi-Dimensional Array Type";
        rdfs:subClassOf      qudt:Array;
        dcterms:description  "\n  Ordinary or one-dimensional arrays are indexed by a single integer. \n  For a multi-dimensional array, the index into the array uses an ordered list of integers, such as in a[3,1,5]. \n  The length of the list of integers used to index into the multi-dimensional array is always the same and is referred to as the array's dimensionality. \n  The bounds on each of these are called the array's dimensions.\n  " , "\n  <p>A <em>Multi-Dimensional Array</em> is an extension of a standard one-dimensional array,\n   where elements are organized in a grid-like structure across two or more dimensions. \n  It is a collection of elements arranged in a tabular or multi-dimensional structure for representing complex datasets,\n   such as matrices, tensors, or higher-dimensional data.\n  </p>\n  <p>The elements of a multi-dimensional array are N-tuples, where 'N' corresponds to the dimensionality of the array.\n  Each element is specified using the property 'qudt:element'.\n  </p>\n  <p>Ordinary or one-dimensional arrays are indexed by a single integer. \n  For a multi-dimensional array, the index into the array uses an ordered list of integers, such as in 'a[3,1,5]'. \n  The length of the list of integers used to index into the multi-dimensional array is always the same.\n  This is referred to as the array's dimensionality. \n  The bounds on each of these are called the array's dimensions.\n  </p>\n  "^^rdf:HTML .

qudt:ModalEnumeration
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Modal Enumeration";
        rdfs:subClassOf      qudt:Enumeration;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  <http://qudt.org/schema/ModalCue>;
                               owl:onProperty     qudt:defaultValue
                             ];
        dcterms:description  "A sub-type of 'QUDT Enumeration'. Detailed description to be provided in a future version." , "A sub-type of 'QUDT Enumeration'.";
        sh:property          qudt:ModalEnumeration-defaultValue .

qudt:ModalCue  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Modal Cue";
        rdfs:subClassOf   qudt:EnumeratedValue;
        sh:property       qudt:ModalCue-duration .

qudt:MemoryOrderType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Memory order type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "A sub-type of 'Enumerated Value'. Detailed description to be provided in a future version." , "A sub-type of 'Enumerated Value'.";
        owl:oneOf            ( qudt:HighToLow qudt:LowToHigh ) .

qudt:Matrix  rdf:type        owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Matrix Type" , "Matrix";
        rdfs:subClassOf      qudt:MultiDimensionalArray , qudt:Array;
        dcterms:description  "A Matrix Type is a data type that specifies the properties of data structures that hold matricies." , "\n  <p>A <em>Matrix</em> is a data type that specifies the properties of an N-dimensional data structure.\n  </p>\n  "^^rdf:HTML .

qudt:MathsFunctionType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Maths Function Type";
        rdfs:subClassOf      qudt:Concept;
        dcterms:description  "A sub-type of 'QUDT Concept'. Detailed description to be provided in a future version." , "A sub-type of 'QUDT Concept'." .

qudt:Map  rdf:type           owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Map Type";
        rdfs:seeAlso         qudt:AssociativeArray;
        rdfs:subClassOf      qudt:Collection;
        dcterms:description  "A Map Type is an abstract data type that defines the properties of map data structures. A Map (or Associative Array) is an abstract data structure composed of a collection of keys and a collection of values, where each key is associated with one value. The operation of finding the value associated with a key is called a lookup or indexing, and this is the most important operation supported by an associative array. The relationship between a key and its value is sometimes called a mapping or binding.";
        owl:equivalentClass  qudt:AssociativeArray .

qudt:MajorMinorType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Major minor type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "A sub-type of 'Enumerated Value'. Detailed description to be provided in a future version." , "A sub-type of 'Enumerated Value'.";
        owl:oneOf            ( qudt:Minor qudt:Major );
        sh:in                ( qudt:Minor qudt:Major ) .

qudt:LongIntegerType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Long Integer Type";
        rdfs:subClassOf      qudt:IntegerDatatype;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    4;
                               owl:onProperty  qudt:bytes
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    32;
                               owl:onProperty  qudt:bits
                             ];
        dcterms:description  "A Long Integer is an integer that can be represented in four octets (32 bits) of machine memory. Long integers may be signed or unsigned." , "\n  A \"Long Integer\" is an integer that can be represented in four octets (32 bits) of machine memory. \n  Long integers may be signed or unsigned.\n  " .

qudt:List  rdf:type          owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "List";
        rdfs:subClassOf      qudt:Collection , qudt:DataItem;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:List;
                               owl:onProperty     rdf:rest
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Datatype;
                               owl:onProperty     rdf:first
                             ];
        dcterms:description  "A sub-type of 'Collection Type'. Detailed description to be provided in a future version." , "A sub-type of 'AbstractDataItem'.";
        sh:property          qudt:MaybeUnitPropertyShape , qudt:MaybeQuantityPropertyShape , qudt:DatatypePropertyShape .

qudt:LimitType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Limit type";
        rdfs:subClassOf   qudt:EnumeratedValue .

qudt:LargeObjectType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Large object";
        rdfs:subClassOf      qudt:CompositeDatatype;
        dcterms:description  "A 'LargeObject' datatype is used to store blocks of unstructured data (such as text, graphic images, video clips, and sound waveforms). They often are used to allow efficient, random, piece-wise access to the data." .

qudt:LargeObject  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Large object";
        rdfs:subClassOf      qudt:CompositeDatatype;
        dcterms:description  "A 'LargeObject' datatype is used to store blocks of unstructured data (such as text, graphic images, video clips, and sound waveforms). They often are used to allow efficient, random, piece-wise access to the data." , "\n  A 'LargeObject' datatype is used to store blocks of unstructured data (such as text, graphic images, video clips, and sound waveforms). \n  They often are used to allow efficient, random, piece-wise access to the data.\n  " .

qudt:KinestheticCue  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Kinesthetic Cue";
        rdfs:subClassOf   qudt:ModalCue;
        sh:property       qudt:KinestheticCue-code .

qudt:InterpolatedTable
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Interpolated Table Type";
        rdfs:subClassOf      qudt:TableType , qudt:Table;
        dcterms:description  "A sub-type of 'Table Type'. Detailed description to be provided in a future version." , "A sub-type of 'Table Type'." .

qudt:IntegerListShape
        rdf:type          sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:subClassOf   rdf:List;
        sh:property       [ sh:or    ( [ sh:node  ()
                                       ]
                                       [ sh:node  qudt:IntegerListShape ]
                                     );
                            sh:path  rdf:rest
                          ];
        sh:property       [ sh:datatype  xsd:integer;
                            sh:path      rdf:first
                          ] .

qudt:IntegerEncodingType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Integer Encoding";
        rdfs:subClassOf      qudt:Encoding;
        dcterms:description  "The encoding scheme for integer types";
        owl:oneOf            ( qudt:LongUnsignedIntegerEncoding qudt:ShortUnsignedIntegerEncoding qudt:ShortUnsignedIntegerEncoding qudt:SignedIntegerEncoding qudt:UnsignedIntegerEncoding );
        sh:property          [ rdf:type          sh:PropertyShape;
                               rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                               sh:in             ( qudt:LongUnsignedIntegerEncoding qudt:ShortUnsignedIntegerEncoding qudt:ShortUnsignedIntegerEncoding qudt:SignedIntegerEncoding qudt:UnsignedIntegerEncoding );
                               sh:path           [ sh:inversePath  rdf:type ]
                             ] .

qudt:IntegerDatatype  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Integer Datatype";
        rdfs:subClassOf      qudt:OrdinalType , qudt:NumericType;
        dcterms:description  "An Integer Type is a data type that specifies how integer numbers are represented and stored in machine memory." .

qudt:IconicCue  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Iconic enumeration literal";
        rdfs:subClassOf   qudt:ModalCue;
        owl:disjointWith  qudt:VisualCue , qudt:KinestheticCue , qudt:AuralCue;
        sh:disjoint       qudt:VisualCue , qudt:KinestheticCue , qudt:AuralCue;
        sh:property       qudt:IconicCue-image .

qudt:HomogeneousArray
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Homogeneous Array";
        rdfs:subClassOf      qudt:Array;
        dcterms:description  "\n  <p>An <em>Array></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. \n  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.\n  </p>\n  <p>The key considerations for an Array are:\n  </p>\n  <ol>\n  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>\n  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>\n  <li>Homogeneous Elements: all elements in an array must be of the same datatype;</li>\n  <li>Contiguous Memory Allocation: The elements are stored in consecutive memory locations, which allows efficient access using the index.</li>\n  </ol>\n  <p>An Array is represented as ordered entries of values arranged according to its dimensionality.\n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>The property 'qudt:datatype' refers to the datatype of the elements.  \n  </p>\n  <p>An array can be multi-dimensional.\n  Multiple indices are used but they are treated as extensions of the same structure.\n  For Example: for a 2D array arr[2][3], indices refer to the row and column positions.\n  A 2D array is still represented as a list, where each member of the list is a list.\n  </p>\n  <p>Higher dimensional arrays can be represented as nested lists.\n  For each dimension a new nested list is defined.\n  </p>"^^rdf:HTML .

qudt:HexBinaryType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Hexidecimal Binary Type";
        rdfs:subClassOf      qudt:TextStringType;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:pattern
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:minLength
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:maxLength
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:length
                             ];
        dcterms:description  "A string composed of hex characters.";
        sh:property          qudt:HexBinaryType-pattern , qudt:HexBinaryType-minLength , qudt:HexBinaryType-maxLength , qudt:HexBinaryType-length .

qudt:HeterogenousArray
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Heterogenous Array";
        rdfs:subClassOf      qudt:Array;
        dcterms:description  "\n  <p>An <em>Array></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. \n  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.\n  </p>\n  <p>The key considerations for an Array are:\n  </p>\n  <ol>\n  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>\n  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>\n  <li>Heterogenous Elements: all elements in the array may be of different data types;</li>\n  <li>Contiguous Memory Allocation: \n    the elements are stored in consecutive memory locations, which allows efficient access using the index.</li>\n  </ol>\n  <p>An Array is represented as ordered entries of values arranged according to its dimensionality.\n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>The property 'qudt:datatype' refers to a list if the datatypes of the elements.  \n  </p>\n  <p>An heterogenous array can be multi-dimensional.\n  Multiple indices are used but they are treated as extensions of the same structure.\n  For example: for a 2D array arr[2][3], indices refer to the row and column positions.\n  A 2D array is still represented as a list, where each member of the list is a list.\n  </p>\n  <p>Higher dimensional arrays can be represented as nested lists.\n  For each dimension a new nested list is defined.\n  </p>"^^rdf:HTML;
        sh:property          qudt:HeterogenousArray-datatype .

qudt:Heap  rdf:type           owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy      <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label            "Heap";
        rdfs:subClassOf       qudt:OrderedTree;
        dcterms:description   "\n  <p>A heap is a specialized tree-based data structure that satisfies the condition: if B is a child node of A, then $key(A) \\ge key(B)$. \n  This implies that an element with the greatest key is always in the root node, and so such a heap is sometimes called a max heap. \n  Alternatively, if the comparison is reversed, the smallest element is always in the root node, which results in a min heap. \n  The function or method that implements the key() operator is specified by the heap type.\n  </p>"^^rdf:HTML;
        prov:wasInfluencedBy  <http://en.wikipedia.org/wiki/Heap_(data_structure)> .

qudt:Graph  rdf:type         sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Graph Type";
        rdfs:subClassOf      qudt:DataItem;
        dcterms:description  "\n  <p>A <em>Graph</em> is an instance of a kind of abstract data type, that consists of a set of nodes (also called vertices) and a set of edges that establish relationships (connections) between the nodes. \n  A Graph Type is a data type that defines the properties of data structures that represent graphs and their members (nodes and edges).\n  </p>"^^rdf:HTML .

qudt:FunctionDatatype
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Function Data Type";
        rdfs:subClassOf      qudt:StructuredDatatype;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:returnType
                             ];
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:functionArity
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Datatype;
                               owl:onProperty     qudt:returnType
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Datatype;
                               owl:onProperty     qudt:argType
                             ];
        dcterms:description  "\n  <p>A function data type defines the input and output data type for a function or method. \n  The data type includes at least the function name and the number of its parameters. \n  In some programming languages, it may also specify the function's return type or the types of its arguments.\n  </p>"^^rdf:HTML;
        sh:property          qudt:FunctionDatatype-returnType , qudt:FunctionDatatype-functionArity , qudt:FunctionDatatype-argType .

qudt:Function  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Function";
        rdfs:subClassOf   qudt:Concept .

qudt:FloatingPointEncodingType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Floating Point Encoding";
        rdfs:subClassOf      qudt:Encoding;
        dcterms:description  "A \"Encoding\" with the following instance(s): \"Double Precision Encoding\", \"Single Precision Real Encoding\"." , "\n  A \"Encoding\" with the following instance(s): \"Double Precision Encoding\", \"Single Precision Real Encoding\".\n  " , "\n  <p>A type for specifying an \"Encoding\" with the following instance(s): \n  \"Double Precision Encoding\", and \"Single Precision Real Encoding\".\n  </p>"^^rdf:HTML .

qudt:FixedIntervalTimeSeriesArrayType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Fixed Interval Time Series Array Type";
        rdfs:subClassOf      qudt:TimeSeriesArrayType;
        dcterms:description  "\n  A <em>Fixed Interval Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data.\n  For example, data that has been sampled over uniformly spaced time intervals. \n  A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals.\n  </p>"^^rdf:HTML , "<p>A <em>Fixed Interval Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data.\n For example, data that has been sampled over uniformly spaced time intervals. \n A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals.\n </p>"^^rdf:HTML .

qudt:FixedIntervalTimeSeriesArray
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Fixed Interval Time Series Array Type";
        rdfs:subClassOf      qudt:TimeSeriesArray;
        dcterms:description  "\n  <p>A <em>Fixed Interval Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data.\n  For example, data that has been sampled over uniformly spaced time intervals.\n  A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals.\n  </p>"^^rdf:HTML .

qudt:FileFormat  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "File format";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "A sub-type of 'Enumerated Value'. Detailed description to be provided in a future version." , "\n  A sub-type of 'Enumerated Value'.\n  " .

qudt:FieldType  rdf:type     owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Field Type";
        rdfs:subClassOf      qudt:CompositeDatatype;
        rdfs:subClassOf      [ rdf:type         owl:Restriction;
                               owl:cardinality  1;
                               owl:onProperty   qudt:fieldName
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Datatype;
                               owl:onProperty     qudt:datatype
                             ];
        dcterms:description  "A sub-type of 'Composite Data Type'. Detailed description to be provided in a future version." , "\n  A sub-type of 'Composite Data Type'.\n  ";
        sh:property          qudt:FieldType-fieldType , qudt:FieldType-fieldLabel , qudt:FieldType-elementType , qudt:FieldType-elementName .

qudt:EnumerationScale
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Enumeration scale";
        rdfs:subClassOf      qudt:Scale , dtype:Enumeration;
        dcterms:description  "A sub-type of 'Scale'. Detailed description to be provided in a future version." , "\n  A sub-type of 'DTYPE Enumeration'.\n  ";
        sh:class             dtype:Enumeration .

qudt:EngineeringValueTupleMember
        rdf:type             sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Engineering Value Tuple Member";
        rdfs:subClassOf      qudt:TupleMember;
        dcterms:description  "\n  <p>A sub-type of 'Tuple Member Type'. \n  </p>"^^rdf:HTML;
        sh:disjoint          qudt:RawValueTupleMemberType , qudt:RawValueTupleMember;
        sh:property          qudt:EngineeringValueTupleMember-elementType .

qudt:EndianType  rdf:type          owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label                 "Endian Type";
        rdfs:subClassOf            qudt:EnumeratedValue;
        qudt:informativeReference  "http://en.wikipedia.org/wiki/Endianness"^^xsd:anyURI;
        qudt:plainTextDescription  "In computing, endianness is the ordering used to represent some kind of data as a sequence of smaller units. Typical cases are the order in which integer values are stored as bytes in computer memory (relative to a given memory addressing scheme) and the transmission order over a network or other medium. When specifically talking about bytes, endianness is also referred to simply as byte order.  Most computer processors simply store integers as sequences of bytes, so that, conceptually, the encoded value can be obtained by simple concatenation. For an 'n-byte' integer value this allows 'n!' (n factorial) possible representations (one for each byte permutation). The two most common of them are: increasing numeric significance with increasing memory addresses, known as little-endian, and its opposite, called big-endian.";
        owl:oneOf                  ( qudt:LittleEndian qudt:BigEndian );
        sh:property                [ rdf:type          sh:PropertyShape;
                                     rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                                     sh:in             ( qudt:LittleEndian qudt:BigEndian );
                                     sh:path           [ sh:inversePath  rdf:type ]
                                   ] .

qudt:Encoding  rdf:type      rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/qudt>;
        rdfs:label           "Encoding";
        rdfs:subClassOf      skos:Concept , qudt:Concept;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:bytes
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:bits
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:bytes
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:bits
                             ];
        dcterms:description  "\n  <p>An encoding is a rule or algorithm that is used to convert data from a native, or unspecified form into a specific form that satisfies the encoding rules. \n  Examples of encodings include character encodings, such as UTF-8.\n  </p>"^^rdf:HTML , "An encoding is a rule or algorithm that is used to convert data from a native, or unspecified form into a specific form that satisfies the encoding rules. Examples of encodings include character encodings, such as UTF-8.";
        sh:property          qudt:Encoding-bits , qudt:Encoding-bytes .

qudt:DoublePrecisionType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Double Precision Type";
        rdfs:subClassOf      qudt:NumericType;
        dcterms:description  "\n  <p>A double precision data type specifies how a numeric value, such as an integer or real number, is stored in memory.\n  Typically this occupies two words in computer memory, where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes, and so double precision data value on a 32-bit machine architecture occupies eight bytes of memory.\n  </p>"^^rdf:HTML;
        owl:disjointWith     qudt:SinglePrecisionType;
        sh:disjoint          qudt:SinglePrecisionType .

qudt:DiscreteState  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Discrete State";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "\n  <p>A <em>Discrete State</em> is the parent class for enumerated values that express a 'State' or 'Condition'.\n  Examples are 'on' and 'off for a switch, 'open' and 'closed' for a valve, and 'wet' and 'dry'.\n  </p>\n  "^^rdf:HTML;
        sh:property          qudt:DiscreteState-inverted .

qudt:DimensionalDatatype
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Dimensional Data Type";
        rdfs:subClassOf      qudt:StructuredDatatype;
        dcterms:description  "\n  <p>A dimensional data type is a data type that specifies a physical quantity or unit of measure.\n  Information about the physical dimensions of the quantities and units is embedded in their types.\n  </p>"^^rdf:HTML , "\n  <p>A <em>Dimensional Data Type</em> is a data type that specifies a physical quantity or unit of measure.\n  Information about the physical dimensions of the quantities and units is embedded in their types.\n  </p>\n  "^^rdf:HTML .

qudt:Dictionary  rdf:type    sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Dictionary Type";
        rdfs:subClassOf      qudt:Map;
        dcterms:description  "A \"Map\"." .

qudt:DateTimeStringType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Temporal Type";
        rdfs:subClassOf      qudt:StringType;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:encoding
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:DateTimeStringEncodingType;
                               owl:onProperty     qudt:encoding
                             ];
        dcterms:description  "\n  <p>A class of data types for structures that represent temporal quantities.\n  For example, calendar dates, times, duration of time since a given epoch, etc.\n  </p>"^^rdf:HTML;
        sh:property          qudt:DateTimeStringType-encoding .

qudt:DateTimeStringEncodingType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Date Time String Encoding Type";
        rdfs:subClassOf      qudt:StringEncodingType;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                               owl:onProperty      qudt:allowedPattern
                             ];
        rdfs:subClassOf      [ rdf:type                     owl:Restriction;
                               owl:minQualifiedCardinality  1;
                               owl:onDataRange              xsd:string;
                               owl:onProperty               qudt:allowedPattern
                             ];
        dcterms:description  "Date Time encodings are logical encodings for expressing date/time quantities as strings by applying unambiguous formatting and parsing rules.";
        sh:property          qudt:DateTimeStringEncodingType-allowedPattern;
        sh:property          [ sh:path                 qudt:allowedPattern;
                               sh:qualifiedMinCount    1;
                               sh:qualifiedValueShape  [ sh:datatype  xsd:string ]
                             ] .

qudt:DateStringType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Date String Type";
        rdfs:subClassOf      qudt:DateTimeStringType;
        dcterms:description  "Date String Types are scalar data types that define the properties of strings that represent calendar dates." .

qudt:DataSetElement  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "QUDT DataSet Element";
        rdfs:subClassOf      qudt:Tuple , qudt:DataItem;
        dcterms:description  "A field is a tuple that carries a name, a type and optionally other properties that characterize a member element of a composite data strucuture." , "\n  A field is a tuple that carries a name, a type and optionally other properties that characterize a member element of a composite data structure.\n  ";
        sh:property          qudt:DataSetElement-quantityKind , qudt:DataSetElement-optional , qudt:DataSetElement-elementLabel .

qudt:DataEncoding  rdf:type  rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:comment         "<p><em>Data Encoding</em> expresses the properties that specify how data is represented at the bit and byte level. These properties are applicable to describing raw data.</p>"^^rdf:HTML;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/qudt>;
        rdfs:label           "Data Encoding";
        rdfs:subClassOf      qudt:Aspect;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:encoding
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:Encoding;
                               owl:onProperty     qudt:encoding
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:EndianType;
                               owl:onProperty     qudt:bitOrder
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:bitOrder
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:byteOrder
                             ];
        dcterms:description  "\n  <p><em>Data Encoding</em> expresses the properties that specify how data is represented at the bit and byte level. \n  These properties are applicable to describing raw data.\n  </p>"^^rdf:HTML;
        sh:property          qudt:DataEncoding-bitOrder , qudt:DataEncoding-byteOrder , qudt:DataEncoding-encoding .

qudt:CompositionTree  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Composition Tree";
        rdfs:subClassOf   qudt:Tree;
        sh:property       qudt:CompositionTree-compositionFunction .

qudt:CompositionFunction
        rdf:type          owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Composition function";
        rdfs:subClassOf   qudt:Function .

qudt:CompositeTable  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Composite Table Type";
        rdfs:subClassOf      qudt:Table;
        dcterms:description  "A sub-type of 'Table Type'. Detailed description to be provided in a future version." , "A sub-type of 'Table Type'." .

qudt:CompositeDatatype
        rdf:type              owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy      <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label            "Composite Data Type";
        rdfs:subClassOf       qudt:StructuredDatatype;
        rdfs:subClassOf       [ rdf:type            owl:Restriction;
                                owl:maxCardinality  1;
                                owl:onProperty      qudt:padding
                              ];
        rdfs:subClassOf       [ rdf:type           owl:Restriction;
                                owl:allValuesFrom  qudt:TypeList;
                                owl:onProperty     qudt:elementTypeList
                              ];
        rdfs:subClassOf       [ rdf:type           owl:Restriction;
                                owl:allValuesFrom  qudt:PaddingType;
                                owl:onProperty     qudt:padding
                              ];
        rdfs:subClassOf       [ rdf:type           owl:Restriction;
                                owl:allValuesFrom  qudt:AlignmentType;
                                owl:onProperty     qudt:alignment
                              ];
        dcterms:description   "\n  <p>Composite types are datatypes which can be constructed in a programming language out of that language's basic primitive types and other composite types. \n  The act of constructing a composite type is known as composition.\n  </p>"^^rdf:HTML , "\n  <p>A <em>Composite Datatype</em> is a datatype that is constructed from basic primitive types and other composite types. \n  </p>"^^rdf:HTML;
        prov:wasInfluencedBy  <https://en.wikipedia.org/wiki/List_of_data_structures>;
        sh:property           qudt:CompositeDatatype-padding , qudt:CompositeDatatype-alignment .

qudt:CompositeDataStructure
        rdf:type              owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment          "\n  <p>A <em>Composite Data Structure</em>, also referred to as <em>Data Record</em> is a datatype that aggregates element of possibly different types. \n  The aggregated items are called fields or members and are usually identified or indexed by field labels.\n  </p>"^^rdf:HTML;
        rdfs:isDefinedBy      <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label            "Composite Data Structure";
        rdfs:subClassOf       qudt:CompositeDatatype;
        dcterms:description   "\n  <p><em>Composite Data Structure</em>, also referred to as <em>Data Record</em> is a datatype that aggregates element of possibly different types. \n  The aggregated items are called fields or members and are usually identified or indexed by field labels.\n  </p>"^^rdf:HTML;
        prov:wasInfluencedBy  <https://en.wikipedia.org/wiki/Record_(computer_science)> , <https://en.wikipedia.org/wiki/List_of_data_structures>;
        sh:property           qudt:CompositeDataStructure-dataElement .

qudt:ColorCue  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "\n  <p>A visual cue that uses color to distinguish it from other cues. \n  Each color cue has exactly one corresponding coordinate point in the RGB space.\n  </p>"^^rdf:HTML;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Color Cue";
        rdfs:subClassOf      qudt:VisualCue;
        dcterms:description  "\n  <p>A visual cue that uses color to distinguish it from other cues. \n  Each color cue has exactly one corresponding coordinate point in the RGB space.\n  </p>"^^rdf:HTML;
        sh:property          qudt:ColorCue-rgbCode .

qudt:Collection  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Collection Type";
        rdfs:subClassOf      qudt:StructuredDatatype;
        dcterms:description  "\n  <p>A collection is a grouping of some variable number of zero or more data items that need to be operated upon together in some controlled fashion. \n  Generally, the data items will all share the same data type or are derived from some common ancestor data type.\n  </p>"^^rdf:HTML .

qudt:CharacterType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Character Type";
        rdfs:subClassOf      qudt:OrdinalType;
        dcterms:description  "\n  A Character Type is a data type that defines the type and encoding of single characters.\n  " , "\n  A <em>Character Type</em> is a data type that defines the type and encoding of single characters.\n  " .

qudt:CharEncodingType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Char Encoding Type";
        rdfs:subClassOf      qudt:Encoding;
        dcterms:description  "The class of all character encoding schemes, each of which defines a rule or algorithm for encoding character data as a sequence of bits or bytes." , "\n  <p>The class of all character encoding schemes.\n  Each defines a rule or algorithm for encoding character data as a sequence of bits or bytes.\n  </p>"^^rdf:HTML;
        owl:oneOf            ( qudt:CharEncoding );
        sh:property          [ rdf:type          sh:PropertyShape;
                               rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                               sh:in             ( qudt:CharEncoding );
                               sh:path           [ sh:inversePath  rdf:type ]
                             ] .

qudt:CardinalityType  rdf:type     rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy           <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label                 "Cardinality Type";
        rdfs:subClassOf            qudt:EnumeratedValue;
        rdfs:subClassOf            [ rdf:type            owl:Restriction;
                                     owl:maxCardinality  "1"^^xsd:int;
                                     owl:onProperty      dtype:literal
                                   ];
        dcterms:description        "\n  In mathematics, the cardinality of a set is a measure of the number of elements of the set.\n  For example, the set $A = {2, 4, 6}$ contains 3 elements, and therefore $A$ has a cardinality of 3. \n  There are two approaches to cardinality: one which compares sets directly using bijections and injections,\n   and another which uses cardinal numbers.\n  "^^qudt:LatexString , "\n  <p>In mathematics, the cardinality of a set is a measure of the number of elements of the set.  \n  For example, the set <em>A = {2, 4, 6}</em> contains 3 elements, and therefore <em>A</em> has a cardinality of 3. \n  There are two approaches to cardinality – one which compares sets directly using bijections and injections,\n   and another which uses cardinal numbers.\n  </p>"^^rdf:HTML;
        qudt:informativeReference  "http://en.wikipedia.org/wiki/Cardinal_number"^^xsd:anyURI , "http://en.wikipedia.org/wiki/Cardinality"^^xsd:anyURI;
        qudt:plainTextDescription  "In mathematics, the cardinality of a set is a measure of the number of elements of the set.  For example, the set 'A = {2, 4, 6}' contains 3 elements, and therefore 'A' has a cardinality of 3. There are two approaches to cardinality – one which compares sets directly using bijections and injections, and another which uses cardinal numbers.";
        owl:oneOf                  ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE qudt:CT_UNCOUNTABLE );
        owl:oneOf                  ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE );
        prov:wasInfluencedBy       <http://en.wikipedia.org/wiki/Cardinal_number> , <http://en.wikipedia.org/wiki/Cardinality>;
        sh:in                      ( qudt:CT_COUNTABLY-INFINITE qudt:CT_UNCOUNTABLE qudt:CT_FINITE );
        sh:property                qudt:CardinalityType-literal;
        sh:property                [ rdf:type          sh:PropertyShape;
                                     rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                                     sh:in             ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE qudt:CT_UNCOUNTABLE );
                                     sh:path           [ sh:inversePath  rdf:type ]
                                   ] .

qudt:ByteEncodingType
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Byte Encoding";
        rdfs:subClassOf      qudt:Encoding;
        dcterms:description  "This class contains the various ways that information may be encoded into bytes." .

qudt:BooleanTypeEnumeratedValue
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "boolean value";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "Specifies how a boolean value is expressed" .

qudt:BooleanType  rdf:type   owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Boolean Type";
        rdfs:subClassOf      qudt:OrdinalType;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:BooleanEncodingType;
                               owl:onProperty     qudt:encoding
                             ];
        dcterms:description  "A boolean data type can take on only two values.";
        sh:property          qudt:BooleanType-encoding .

qudt:BooleanEncodingType
        rdf:type          owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "Boolean encoding type" , "Boolean Encoding Type";
        rdfs:subClassOf   qudt:Encoding;
        owl:oneOf         ( qudt:BooleanEncoding qudt:BitEncoding qudt:OctetEncoding );
        sh:property       [ rdf:type          sh:PropertyShape;
                            rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                            sh:in             ( qudt:BooleanEncoding qudt:BitEncoding qudt:OctetEncoding );
                            sh:path           [ sh:inversePath  rdf:type ]
                          ] .

qudt:BitEncodingType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Bit Encoding";
        rdfs:subClassOf      qudt:Encoding;
        dcterms:description  "A bit encoding is a correspondence between the two possible values of a bit, 0 or 1, and some interpretation. For example, in a boolean encoding, a bit denotes a truth value, where 0 corresponds to False and 1 corresponds to True." , "\n  <p>A bit encoding is a correspondence between the two possible values of a bit, 0 or 1, and some interpretation. \n  For example, in a boolean encoding, a bit denotes a truth value, where 0 corresponds to False and 1 corresponds to True.\n  <p>A Binary Tree Type is a data type that defines the properties of data structures that represent binary trees. \n  A binary tree is a tree in which each node has at most 2 children.\n  </p>"^^rdf:HTML , "\n  <p>A <em>Bit Encoding Type</em> is an encoding type for the correspondence between the two possible values of a bit, 0 or 1, and some interpretation. \n  For example, in a boolean encoding, a bit denotes a truth value, where 0 corresponds to False and 1 corresponds to True.\n  </p>"^^rdf:HTML;
        owl:oneOf            ( qudt:BitEncoding );
        sh:property          [ rdf:type          sh:PropertyShape;
                               rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
                               sh:in             ( qudt:BitEncoding );
                               sh:path           [ sh:inversePath  rdf:type ]
                             ] .

qudt:BinaryTree  rdf:type    owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Binary Tree Type";
        rdfs:subClassOf      qudt:Tree;
        dcterms:description  "\n  <p>A Binary Tree Type is a data type that defines the properties of data structures that represent binary trees. \n  A binary tree is a tree in which each node has at most 2 children.\n  </p>"^^rdf:HTML , "\n  <p>A <em>Binary Tree</em> is a data type that defines the properties of data structures that represent binary trees. \n  A binary tree is a tree in which each node has at most 2 children.\n  </p>"^^rdf:HTML .

qudt:BigIntegerType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Big Integer Type";
        rdfs:subClassOf      qudt:IntegerDatatype;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    8;
                               owl:onProperty  qudt:bytes
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    64;
                               owl:onProperty  qudt:bits
                             ];
        dcterms:description  "A Big Integer is an integer that can be represented in eight octets (64 bits) of machine memory. Big integers may be signed or unsigned." , "\n  <p>A <em>Big Integer</em> is an integer that can be represented in eight octets (64 bits) of machine memory. \n  Big integers may be signed or unsigned.\n  </p>\n  "^^rdf:HTML .

qudt:BalancedTree  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Balanced Tree Type";
        rdfs:subClassOf      qudt:Tree;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:maxDepth
                             ];
        dcterms:description  "\n  <p>A Balanced Tree Type is a data type that defines the properties of data structures that represent balanced trees. \n  A balanced tree is a tree where no leaf is much farther away from the root than any other leaf. \n  Different balancing schemes allow different definitions of \"much farther\" and different amounts of work to keep them balanced.\n  </p>"^^rdf:HTML , "\n  <p>A <em>Balanced Tree</em> is a data type that defines the properties of data structures that represent balanced trees. \n  A balanced tree is a tree where no leaf is much farther away from the root than any other leaf. \n  Different balancing schemes allow different definitions of \"much farther\" and different amounts of work to keep them balanced.\n  </p>\n  "^^rdf:HTML;
        sh:property          qudt:BalancedTree-maxDepth .

qudt:AuralCue  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment         "\n  <p>An aural cue is a sound produced by a device or a system that is used to alert personnel of of an advisory, cautionary, warning, or emergency state.\n  </p>"^^rdf:HTML;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Aural Cue";
        rdfs:subClassOf      qudt:ModalCue;
        dcterms:description  "\n  <p>An aural cue is a sound produced by a device or a system that is used to alert personnel of of an advisory, cautionary, warning, or emergency state.\n  </p>"^^rdf:HTML;
        sh:property          qudt:AuralCue-sound .

qudt:AssociativeArray
        rdf:type             owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Associative Array";
        rdfs:seeAlso         qudt:Map;
        rdfs:subClassOf      qudt:Collection , qudt:Array;
        dcterms:description  "\n  An Associative Array (or Map) is an abstract data type composed of a collection of keys and a collection of values,\n   where each key is associated with one value. \n  The operation of finding the value associated with a key is called a lookup or indexing,\n   and this is the most important operation supported by an associative array.\n  The relationship between a key and its value is sometimes called a mapping or binding.\n  " , "\n  <p>An <em>Associative Array</em> (or <em>Map</em>) is an abstract data type composed of a collection of keys and a collection of values,\n   where each key is associated with one value. \n  The operation of finding the value associated with a key is called a lookup or indexing,\n   and this is the most important operation supported by an associative array.\n  The relationship between a key and its value is sometimes called a mapping or binding.\n  </p>\n  "^^rdf:HTML;
        owl:equivalentClass  qudt:Map .

qudt:ArrayType  rdf:type     sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Array Type";
        rdfs:subClassOf      qudt:CompositeDatatype;
        dcterms:description  "\n  <p>An <em>Array Type</em> is a type specification for ordered entries of values arranged according to the dimensions given. \n  The dimensions are given as a list of integers where each integer is the cardinality of each dimension. \n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>Optionally a reference can be made to a variable, whose values are the array entries. \n  The data type of the array entries is an optional field, 'elementType', which points to a data type definition. \n  If the data type is given, then it applies to all elements.  \n  If it is not given then the elements can be of different types for each position in the array.\n  </p>\n  <p>The property <em>qudt:typeMatrix</em> must refer to a matrix of types.\n  If a default value is given this can be used to place the appropriate value in a cell when an entry value is not known. \n  If no dimensionality or dimension vector is specified the array is under-specified but still legitimate as a place-holder for a data type.\n  </p>"^^rdf:HTML .

qudt:ArrayDataOrder  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Array data order";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "A sub-type of 'Enumerated Value'. Detailed description to be provided in a future version.";
        owl:oneOf            ( qudt:ByColumn qudt:ByRow qudt:ByLeftMostIndex );
        sh:oneOf             ( qudt:ByColumn qudt:ByRow qudt:ByLeftMostIndex ) .

qudt:Array  rdf:type         rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype>;
        rdfs:label           "Array" , "Array Type";
        rdfs:subClassOf      qudt:CompositeDatatype , qudt:StructuredDatatype;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:typeMatrix
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:dimensions
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:dimensionality
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:dataOrder
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  1;
                               owl:onProperty      qudt:byRow
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:TypeMatrix;
                               owl:onProperty     qudt:typeMatrix
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  qudt:ArrayDataOrder;
                               owl:onProperty     qudt:dataOrder
                             ];
        dcterms:description  "\n  <p>An <em>Array></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. \n  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.\n  </p>\n  <p>The key considerations for an Array are:\n  </p>\n  <ol>\n  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>\n  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>\n  <li>Contiguous Memory Allocation: The elements are stored in consecutive memory locations, which allows efficient access using the index.</li>\n  </ol>\n  <p>An Array is represented as ordered entries of values arranged according to its dimensionality.\n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>An array can be multi-dimensional.\n  Multiple indices are used but they are treated as extensions of the same structure.\n  For Example: for a 2D array arr[2][3], indices refer to the row and column positions.\n  A 2D array is still represented as a list, where each member of the list is a list.\n  </p>\n  <p>Higher dimensional arrays can be represented as nested lists.\n  For each dimension a new nested list is defined.\n  </p>"^^rdf:HTML , "\n  <p>An array is represented as ordered entries of values arranged according to the dimensions given. \n  The dimensions are given as a list of integers where each integer is the cardinality of each dimension. \n  The number of dimensions is specified in the attribute 'dimensionality'.\n  Optionally a reference can be made to a variable, whose values are the array entries. \n  The data type of the array entries is an optional field, 'elementType', which points to a data type definition. \n  If the data type is given, then it applies to all elements.  \n  If it is not given then the elements can be of different types for each position in the array.\n  </p>\n  <p> \n  The property 'type:typeMatrix' must refer to a matrix of types.  \n  If a default value is given this can be used to place the appropriate value in a cell when an entry value is not known. \n  If no dimensionality or dimension vector is specified the array is under-specified but still legitimate as a place-holder for a data type.\n  </p>"^^rdf:HTML;
        sh:node              qudt:DimensionalityShape;
        sh:property          qudt:Array-isHeterogeneous , qudt:Array-value , qudt:DatatypePropertyShape , qudt:DimensionalityPropertyShape , qudt:DimensionsPropertyShape .

qudt:AlignmentType  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Alignment type";
        rdfs:subClassOf      qudt:EnumeratedValue;
        dcterms:description  "Specifies how a physical data field is aligned. The alignment could be at a bit, byte or word boundary." , "\n  Specifies how a physical data field is aligned. \n  The alignment could be at a bit, byte or word boundary.\n  ";
        owl:oneOf            ( qudt:BitAligned qudt:ByteAligned qudt:WordAligned );
        sh:in                ( qudt:BitAligned qudt:ByteAligned qudt:WordAligned ) .

qudt:AlgebraicDatatype
        rdf:type              owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy      <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label            "Algebraic Datatype";
        rdfs:seeAlso          qudt:AbstractDatatype;
        rdfs:subClassOf       qudt:StructuredDatatype;
        dcterms:description   "\n<p>An \"Algebraic Datatype\" is a datatype each of whose values are data from other data types wrapped in one of the constructors of the data type. \nAny wrapped datum is an argument to the constructor. \nIn contrast to other data types, the constructor is not executed and the only way to operate on the data is to unwrap the constructor using pattern matching.\n</p>\n<p>The most common algebraic data type is a list with two constructors: Nil or [] for an empty list, and Cons (an abbreviation of constructor), \n ::, or : for the combination of a new element with a shorter list (for example (Cons 1 '(2 3 4)) or 1:[2,3,4]).\n</p>\n<p>Special cases of algebraic types are product types i.e. records (only one constructor) and enumerated types (many constructors with no arguments). \nAlgebraic types are one kind of composite type (i.e. a type formed by combining other types).\n</p>\n<p>An algebraic data type may also be an abstract data type (ADT) if it is exported from a module without its constructors. \nValues of such a type can only be manipulated using functions defined in the same module as the type itself.\n</p>"^^rdf:HTML , "<p>An <em>Algebraic Datatype</em> is a datatype each of whose values are data from other data types wrapped in one of the constructors of the data type. \nAny wrapped datum is an argument to the constructor. \nIn contrast to other data types, the constructor is not executed and the only way to operate on the data is to unwrap the constructor using pattern matching.\n</p>\n<p>The most common algebraic data type is a list with two constructors: Nil or [] for an empty list, and Cons (an abbreviation of constructor), \n ::, or : for the combination of a new element with a shorter list (for example (Cons 1 '(2 3 4)) or 1:[2,3,4]).\n</p>\n<p>Special cases of algebraic types are product types i.e. records (only one constructor) and enumerated types (many constructors with no arguments). \nAlgebraic types are one kind of composite type (i.e. a type formed by combining other types).\n</p>\n<p>An algebraic data type may also be an abstract data type (ADT) if it is exported from a module without its constructors. \nValues of such a type can only be manipulated using functions defined in the same module as the type itself.\n</p>"^^rdf:HTML;
        prov:wasInfluencedBy  <http://en.wikipedia.org/wiki/Algebraic_data_type> .

qudt:AbstractDatatype
        rdf:type              owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:isDefinedBy      <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label            "Abstract Datatype";
        rdfs:subClassOf       qudt:StructuredDatatype;
        dcterms:description   "\n  <p>An \"Abstract Datatype\" (ADT) is a specification of a set of data and the set of operations that can be performed on the data. \n  Such a data type is abstract in the sense that it is independent of various concrete implementations. \n  The definition can be mathematical, or it can be programmed as an interface. \n  A first class ADT supports the creation of multiple instances of the ADT, and the interface normally provides a constructor,\n   which returns an abstract handle to new data, and several operations, \n   which are functions accepting the abstract handle as an argument.</p>\n  "^^rdf:HTML;
        prov:wasInfluencedBy  <http://xlinux.nist.gov/dads/HTML/abstractDataType.html> , <http://en.wikipedia.org/wiki/Abstract_data_type> .

