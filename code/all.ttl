        rdfs:label        "origin definition";
        rdfs:range        xsd:string .

qudt:orderingRelation
        rdf:type             owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "Ordering Relation";
        dcterms:description  "This property identifies the mathematical comparison operator (such as \"<\" or \">\") that is used to order the elements of a collection." , "\n  This property identifies the mathematical comparison operator (such as \"<\" or \">\") that is used to order the elements of a collection.\n  " .

qudt:orderedType  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
