        vaem:urlForHTML                "http://qudt.org/$$QUDT_VERSION$$/vocab/prefix.html"^^xsd:anyURI;
        vaem:usesNonImportedResource   dcterms:title , dcterms:modified , dcterms:creator , dcterms:created , dcterms:abstract;
