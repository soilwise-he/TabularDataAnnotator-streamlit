        rdfs:label        "maximum bits";
        rdfs:range        xsd:integer .

qudt:matlabName  rdf:type   owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy    <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label          "matlab name";
        rdfs:range          xsd:string;
        rdfs:subPropertyOf  qudt:id .

qudt:mantissa  rdf:type      owl:FunctionalProperty , owl:DatatypeProperty , rdf:Property;
        rdfs:comment         "In scientific notation, the mantissa of a real number is the integer coefficient preceding the base raised to the exponent.";
        rdfs:label           "mantissa";
        dcterms:description  "In scientific notation, the mantissa of a real number is the integer coefficient preceding the base raised to the exponent." .

qudt:lowerBound  rdf:type  owl:DatatypeProperty , rdf:Property;
