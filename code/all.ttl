qudt:encoding  rdf:type   owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> , <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "encoding" .

qudt:elementUnit  rdf:type  owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "element unit" .

qudt:elementTypeList  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "element type list";
        dcterms:description  "This property is used to relate a structured data type with a list of data types. The list members determine the types of structured type's elements. It is used for structured data types with elements that are of different types." , "\n  This property is used to define the data type of the elements of a structured data type. \n  It is used for structured data types with elements that are of different types.\n  " .

qudt:elementTypeCount
        rdf:type             owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy     <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label           "element type count";
        rdfs:range           xsd:integer;
        dcterms:description  "This property determines the allowed number of element types that a structured data type may have." .

qudt:elementName  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:isDefinedBy  <http://qudt.org/$$QUDT_VERSION$$/schema/datatype> , <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype>;
        rdfs:label        "element name" .

qudt:elementLabel  rdf:type  rdf:Property;
