        rdfs:label           "Rotating reference frame";
        rdfs:subClassOf      qudt:ReferenceFrame;
        dcterms:description  "A sub-type of 'Reference Frame'. Detailed description to be provided in a future version." , "A sub-type of 'Reference Frame'." .

